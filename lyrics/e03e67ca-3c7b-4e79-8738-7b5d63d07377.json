{"v":1,"src":"scribe+alignement","coverage":0.883,"lines":[{"text":"Mmouh... Eza se yo...","t":6.5,"e":7.8,"w":[["Mmouh",6.5,6.7],["Eza",6.8,7.14],["se",7.2,7.44],["yo",7.48,7.8]],"ok":0.75},{"text":"Mwana ya nzambe, fungola motema na ngai.","t":10.16,"e":14.86,"w":[["Mwana",10.16,10.54],["ya",10.58,10.76],["nzambe",10.8,11.46],["fungola",12.48,13],["motema",13.08,13.74],["na",13.8,13.94],["ngai",14.02,14.86]],"ok":1.0},{"text":"Na kati ya molili, oza lokola mponzi","t":30.38,"e":35.6,"w":[["Na",30.38,30.5],["kati",30.56,30.98],["ya",31.04,31.16],["molili",31.22,31.82],["oza",32.83,33.03],["lokola",33.84,34.8],["mponzi",34.84,35.6]],"ok":0.86},{"text":"Opesi motema na ngai kimia ya sika","t":37.28,"e":42.26,"w":[["Opesi",37.28,38.08],["motema",38.14,38.84],["na",38.92,39.06],["ngai",39.12,39.6],["kimia",40.9,41.3],["ya",41.34,41.5],["sika",41.54,42.26]],"ok":1.0},{"text":"Na lɔtaka yo na bɔɔi na ngai ya pokwa","t":44.12,"e":49.04,"w":[["Na",44.12,44.28],["lɔtaka",44.32,44.7],["yo",44.76,45.18],["na",45.64,45.82],["bɔɔi",45.9,46.4],["na",47.58,47.72],["ngai",47.74,48.12],["ya",48.12,48.28],["pokwa",48.44,49.04]],"ok":1.0},{"text":"Nzoto na yo, mai ya pete, elɛmbisaka ngai","t":50.54,"e":55.82,"w":[["Nzoto",50.54,50.94],["na",51,51.16],["yo",51.24,51.4],["mai",51.5,51.8],["ya",51.8,51.98],["pete",52.12,52.72],["elɛmbisaka",54.06,54.6],["ngai",55.2,55.82]],"ok":1.0},{"text":"Tala ngai na miso, oyoka motema ezoroka","t":58.1,"e":63.04,"w":[["Tala",58.1,58.46],["ngai",58.48,58.72],["na",58.76,58.9],["miso",58.98,59.72],["oyoka",60.96,61.48],["motema",61.56,62.16],["ezoroka",62.18,63.04]],"ok":1.0},{"text":"Oza ndoto na ngai ya tongo tii na pokwa","t":64.84,"e":69.92,"w":[["Oza",64.84,65.18],["ndoto",65.34,65.86],["na",65.94,66.08],["ngai",66.14,66.68],["ya",67.78,67.92],["tongo",67.96,68.4],["tii",68.46,68.66],["na",68.52,69.06],["pokwa",69.16,69.92]],"ok":0.89},{"text":"Bolingo na biso, ez’eloko ya sika ooo!","t":71.9,"e":76.68,"w":[["Bolingo",71.9,72.48],["na",72.52,72.68],["biso",72.74,73.1],["ez’eloko",74.06,74.8],["ya",74.86,75],["sika",75.14,75.72],["ooo",76.48,76.68]],"ok":0.86},{"text":"Nzela ya lobi, tobɛti elongo ooo!","t":77.24,"e":80.51,"w":[["Nzela",77.24,77.62],["ya",77.66,77.84],["lobi",77.9,78.5],["tobɛti",78.56,79.06],["elongo",79.12,79.92],["ooo",80.31,80.51]],"ok":0.83},{"text":"Tika toyemba, tika totambola","t":80.7,"e":83.42,"w":[["Tika",80.7,81.06],["toyemba",81.14,81.94],["tika",82.04,82.36],["totambola",82.44,83.42]],"ok":1.0},{"text":"Na se ya moi ya bolingo, se yo na ngai...","t":83.72,"e":93.8,"w":[["Na",83.72,83.84],["se",83.94,84.1],["ya",84.16,84.28],["moi",84.39,84.59],["ya",84.49,84.69],["bolingo",84.6,85.2],["se",85.66,86.02],["yo",89.61,89.81],["na",93.2,93.34],["ngai",93.44,93.8]],"ok":0.7},{"text":"Tala miso na ngai, omona makambo","t":99.18,"e":102.32,"w":[["Tala",99.18,99.4],["miso",99.48,99.84],["na",99.9,100.02],["ngai",100.06,100.46],["omona",100.98,101.54],["makambo",101.6,102.32]],"ok":1.0},{"text":"Bilaka ya bomoi oyo ekomi na ntina","t":102.66,"e":105.82,"w":[["Bilaka",102.66,103.24],["ya",103.28,103.48],["bomoi",103.32,103.94],["oyo",104.1,104.5],["ekomi",104.62,105.16],["na",105.18,105.38],["ntina",105.2,105.82]],"ok":0.71},{"text":"Hhhh, soki ozali te, ngai na lingaka nani ?","t":106.07,"e":109.2,"w":[["Hhhh",106.07,106.27],["soki",106.32,106.72],["ozali",106.78,107.52],["te",107.55,107.75],["ngai",107.58,107.78],["na",107.84,107.98],["lingaka",108.06,108.38],["nani",108.5,109.2]],"ok":0.75},{"text":"Nsango ya bolingo na biso ekumisi mapata","t":109.76,"e":112.96,"w":[["Nsango",109.76,110.02],["ya",110.12,110.16],["bolingo",110.22,110.8],["na",110.84,111],["biso",111.06,111.34],["ekumisi",111.4,112.1],["mapata",112.18,112.96]],"ok":1.0},{"text":"Y'oza ndoto ya mpokwa...","t":114.5,"e":116.06,"w":[["Y'oza",114.5,114.86],["ndoto",114.9,115.16],["ya",115.2,115.3],["mpokwa",115.82,116.06]],"ok":1.0},{"text":"Y'oza elikia ya ntɔngɔ...","t":117.94,"e":119.62,"w":[["Y'oza",117.94,118.32],["elikia",118.38,118.76],["ya",118.79,118.99],["ntɔngɔ",118.82,119.62]],"ok":0.75},{"text":"Tik’okanga maboko na ngai,","t":121.38,"e":123.02,"w":[["Tik’okanga",121.38,121.64],["maboko",121.7,122.22],["na",122.26,122.36],["ngai",122.38,123.02]],"ok":1.0},{"text":"Tika tondima...","t":123.54,"e":124.68,"w":[["Tika",123.54,123.92],["tondima",124.16,124.68]],"ok":1.0},{"text":"Bolingo na biso, ez’eloko ya sika ooo!","t":127,"e":131.77,"w":[["Bolingo",127,127.56],["na",127.62,127.78],["biso",127.86,128.2],["ez’eloko",129.18,129.92],["ya",129.98,130.12],["sika",130.24,130.82],["ooo",131.57,131.77]],"ok":0.86},{"text":"Nzela ya lobi, tobɛti elongo ooo!","t":132.32,"e":135.58,"w":[["Nzela",132.32,132.72],["ya",132.76,132.94],["lobi",133,133.6],["tobɛti",133.66,134.14],["elongo",134.22,134.96],["ooo",135.38,135.58]],"ok":0.83},{"text":"Tika toyemba, tika totambola","t":135.8,"e":138.46,"w":[["Tika",135.8,136.16],["toyemba",136.24,137.06],["tika",137.12,137.46],["totambola",137.54,138.46]],"ok":1.0},{"text":"Na se ya moi ya bolingo, se yo na ngai...","t":138.82,"e":141.78,"w":[["Na",138.82,138.96],["se",139.06,139.24],["ya",139.28,139.38],["moi",139.49,139.69],["ya",139.59,139.79],["bolingo",139.7,140.3],["se",140.72,141.14],["yo",141.17,141.37],["na",141.2,141.3],["ngai",141.36,141.78]],"ok":0.7},{"text":"Mwana ya ngai... Douceur na ngai...","t":182.12,"e":186.74,"w":[["Mwana",182.12,182.56],["ya",182.62,182.86],["ngai",182.92,183.34],["Douceur",184.73,184.93],["na",186.12,186.24],["ngai",186.34,186.74]],"ok":0.83},{"text":"Eh, tina nga malewa...","t":187.52,"e":190.04,"w":[["Eh",187.52,187.88],["tina",188.36,188.7],["nga",188.74,188.96],["malewa",189.16,190.04]],"ok":1.0},{"text":"Nzela ya bolingo eza molayi, kasi tosimbi...","t":190.88,"e":197.2,"w":[["Nzela",190.88,191.32],["ya",191.36,191.52],["bolingo",191.58,192.08],["eza",192.1,192.3],["molayi",192.12,193.26],["kasi",195.66,196.02],["tosimbi",196.08,197.2]],"ok":0.86}]}