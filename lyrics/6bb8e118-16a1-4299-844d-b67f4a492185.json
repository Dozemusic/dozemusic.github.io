{"v":1,"src":"scribe+alignement","coverage":0.971,"lines":[{"text":"Intro]","t":0.78,"e":0.98,"w":[["Intro",0.78,0.98]],"ok":0.0},{"text":"Charles le bon on The beat...","t":1.08,"e":2.64,"w":[["Charles",1.08,1.38],["le",1.38,1.46],["bon",1.54,1.76],["on",1.86,2],["The",2.04,2.14],["beat",2.2,2.64]],"ok":1.0},{"text":"Chérie... Je t'ai tout donné.","t":7.22,"e":9.28,"w":[["Chérie",7.22,7.76],["Je",7.82,8],["t'ai",8.06,8.24],["tout",8.3,8.48],["donné",8.54,9.28]],"ok":1.0},{"text":"Mon cœur, mon âme, ma vie.","t":11.82,"e":13.9,"w":[["Mon",11.82,11.98],["cœur",12.06,12.42],["mon",12.52,12.76],["âme",12.86,13.2],["ma",13.3,13.48],["vie",13.56,13.9]],"ok":1.0},{"text":"Et aujourd'hui, je me retrouve seule... Écoute ma douleur.","t":16.4,"e":22.98,"w":[["Et",16.4,16.52],["aujourd'hui",16.58,17.16],["je",17.38,17.5],["me",17.58,17.74],["retrouve",17.82,18.36],["seule",18.5,18.9],["Écoute",21.76,22.06],["ma",22.14,22.32],["douleur",22.36,22.98]],"ok":1.0},{"text":"J’ai dessiné ton nom sur les murs de ma vie,","t":46.68,"e":49.34,"w":[["J’ai",46.68,46.84],["dessiné",46.88,47.36],["ton",47.42,47.56],["nom",47.64,47.88],["sur",47.96,48.08],["les",48.12,48.24],["murs",48.3,48.46],["de",48.5,48.6],["ma",48.66,48.96],["vie",49.02,49.34]],"ok":1.0},{"text":"Je t’ai donné mes jours, mes plus belles nuits.","t":49.48,"e":52.12,"w":[["Je",49.48,49.54],["t’ai",49.7,49.82],["donné",49.86,50.16],["mes",50.2,50.34],["jours",50.42,50.68],["mes",50.78,51],["plus",51.06,51.36],["belles",51.44,51.7],["nuits",51.78,52.12]],"ok":1.0},{"text":"Pour toi j'ai tout quitté, j'ai marché dans le noir,","t":52.32,"e":55,"w":[["Pour",52.32,52.42],["toi",52.46,52.6],["j'ai",52.64,52.78],["tout",52.82,52.96],["quitté",53,53.3],["j'ai",53.34,53.48],["marché",53.54,53.9],["dans",53.98,54.18],["le",54.24,54.32],["noir",54.54,55]],"ok":1.0},{"text":"Tu étais mon soleil, mon unique espoir.","t":55.1,"e":57.82,"w":[["Tu",55.1,55.24],["étais",55.34,55.56],["mon",55.6,55.74],["soleil",55.8,56.26],["mon",56.34,56.46],["unique",56.6,57],["espoir",57.1,57.82]],"ok":1.0},{"text":"Mais ton cœur est resté comme un bloc de glace,","t":57.88,"e":60.6,"w":[["Mais",57.88,58],["ton",58.06,58.18],["cœur",58.22,58.4],["est",58.44,58.54],["resté",58.58,59.06],["comme",59.12,59.3],["un",59.36,59.48],["bloc",59.52,59.78],["de",59.86,59.98],["glace",60.06,60.6]],"ok":1.0},{"text":"Pendant que dans le mien, tu prenais toute la place.","t":60.68,"e":63.42,"w":[["Pendant",60.68,60.98],["que",61.02,61.16],["dans",61.2,61.34],["le",61.38,61.46],["mien",61.52,61.66],["tu",61.72,61.82],["prenais",61.88,62.26],["toute",62.34,62.54],["la",62.62,62.84],["place",62.94,63.42]],"ok":1.0},{"text":"Je t'ai offert mon monde, mes plus beaux lendemains,","t":63.46,"e":66.16,"w":[["Je",63.46,63.56],["t'ai",63.62,63.76],["offert",63.82,64.14],["mon",64.18,64.32],["monde",64.42,64.64],["mes",64.68,64.82],["plus",64.88,65.02],["beaux",65.1,65.24],["lendemains",65.3,66.16]],"ok":1.0},{"text":"Mais tu as tout lâché en me serrant la main.","t":66.24,"e":68.84,"w":[["Mais",66.24,66.36],["tu",66.44,66.56],["as",66.62,66.72],["tout",66.78,66.9],["lâché",66.94,67.42],["en",67.48,67.58],["me",67.64,67.74],["serrant",67.86,68.26],["la",68.32,68.48],["main",68.64,68.84]],"ok":1.0},{"text":"Mwen ba ou tout sa m genyen, ou pa ban m anyen en retour,","t":70.1,"e":75.6,"w":[["Mwen",70.1,70.38],["ba",70.44,70.7],["ou",70.76,70.9],["tout",70.98,71.16],["sa",71.28,71.44],["m",71.5,71.6],["genyen",71.66,72.34],["ou",72.92,73.06],["pa",73.24,73.5],["ban",73.56,73.72],["m",73.99,74.19],["anyen",74.27,74.47],["en",74.54,74.76],["retour",74.84,75.6]],"ok":0.86},{"text":"J'ai noyé mes rêves dans ce faux amour.","t":75.64,"e":81.06,"w":[["J'ai",75.64,75.82],["noyé",76,76.5],["mes",76.58,76.76],["rêves",76.94,78.56],["dans",79.34,79.54],["ce",79.64,79.8],["faux",80.02,80.4],["amour",80.44,81.06]],"ok":1.0},{"text":"Regarde mes larmes couler sur ma peau,","t":81.26,"e":83.84,"w":[["Regarde",81.26,81.58],["mes",81.64,81.76],["larmes",81.86,82.24],["couler",82.28,82.64],["sur",82.8,83.1],["ma",83.2,83.44],["peau",83.54,83.84]],"ok":1.0},{"text":"T'aimer en silence était bien trop beau.","t":84.06,"e":86.62,"w":[["T'aimer",84.06,84.4],["en",84.46,84.56],["silence",84.7,85.12],["était",85.12,85.54],["bien",85.6,85.82],["trop",85.9,86.26],["beau",86.34,86.62]],"ok":1.0},{"text":"Chérie doudou, pourquoi ce silence ?","t":86.82,"e":90.04,"w":[["Chérie",86.82,87.46],["doudou",87.54,88.02],["pourquoi",88.42,88.78],["ce",88.86,89],["silence",89.14,90.04]],"ok":1.0},{"text":"Mon cœur se meurt dans cette souffrance...","t":90.32,"e":92.76,"w":[["Mon",90.32,90.44],["cœur",90.5,90.68],["se",90.76,90.9],["meurt",91.02,91.32],["dans",91.38,91.52],["cette",91.64,91.86],["souffrance",91.94,92.76]],"ok":1.0},{"text":"C’est l'histoire d'une folle qui croyait aux miracles,","t":103.9,"e":106.46,"w":[["C’est",103.9,104.06],["l'histoire",104.08,104.44],["d'une",104.48,104.68],["folle",104.82,105],["qui",105.04,105.14],["croyait",105.18,105.6],["aux",105.62,105.74],["miracles",105.8,106.46]],"ok":1.0},{"text":"Qui a brisé sa vie pour sauter les obstacles.","t":106.76,"e":109.26,"w":[["Qui",106.76,106.88],["a",106.96,107.04],["brisé",107.08,107.36],["sa",107.42,107.56],["vie",107.62,107.74],["pour",107.78,107.9],["sauter",107.96,108.28],["les",108.34,108.5],["obstacles",108.56,109.26]],"ok":1.0},{"text":"Je t'ai lavé les pieds quand tu étais fatigué,","t":109.5,"e":111.9,"w":[["Je",109.5,109.62],["t'ai",109.68,109.82],["lavé",109.86,110.16],["les",110.2,110.32],["pieds",110.36,110.54],["quand",110.58,110.7],["tu",110.74,110.8],["étais",110.84,111.06],["fatigué",111.2,111.9]],"ok":1.0},{"text":"Et c'est dans ma détresse que tu m'as oubliée.","t":112,"e":114.72,"w":[["Et",112,112.06],["c'est",112.14,112.28],["dans",112.34,112.52],["ma",112.6,112.78],["détresse",112.84,113.32],["que",113.36,113.48],["tu",113.54,113.66],["m'as",113.72,113.96],["oubliée",114.02,114.72]],"ok":1.0},{"text":"Les voisins me regardent, ils ont pitié de moi,","t":115.1,"e":117.64,"w":[["Les",115.1,115.2],["voisins",115.24,115.58],["me",115.64,115.74],["regardent",115.8,116.16],["ils",116.2,116.34],["ont",116.36,116.46],["pitié",116.54,116.98],["de",117.04,117.16],["moi",117.28,117.64]],"ok":1.0},{"text":"Une ombre qui s'efface, transie par le froid.","t":117.96,"e":120.46,"w":[["Une",117.96,118.06],["ombre",118.12,118.34],["qui",118.38,118.5],["s'efface",118.56,119.02],["transie",119.1,119.48],["par",119.58,119.78],["le",119.84,119.96],["froid",120.08,120.46]],"ok":1.0},{"text":"Tu as pris ma jeunesse, ma joie et ma lumière,","t":120.72,"e":123.38,"w":[["Tu",120.72,120.84],["as",120.9,120.98],["pris",121.02,121.16],["ma",121.22,121.32],["jeunesse",121.38,121.72],["ma",121.78,121.9],["joie",121.98,122.2],["et",122.28,122.38],["ma",122.42,122.58],["lumière",122.66,123.38]],"ok":1.0},{"text":"Pour me laisser mourir seule sur cette terre.","t":123.48,"e":126.06,"w":[["Pour",123.48,123.6],["me",123.66,123.76],["laisser",123.8,124.12],["mourir",124.18,124.6],["seule",124.7,124.94],["sur",125.06,125.26],["cette",125.36,125.64],["terre",125.76,126.06]],"ok":1.0},{"text":"Mwen ba ou tout sa m genyen, ou pa ban m anyen en retour,","t":126.26,"e":131.42,"w":[["Mwen",126.26,126.54],["ba",126.54,126.54],["ou",126.62,126.72],["tout",126.8,126.98],["sa",127.1,127.26],["m",127.34,127.42],["genyen",127.5,128.16],["ou",128.76,128.92],["pa",129.08,129.32],["ban",129.4,129.54],["m",129.81,130.01],["anyen",130.07,130.27],["en",130.34,130.58],["retour",130.68,131.42]],"ok":0.86},{"text":"J'ai noyé mes rêves dans ce faux amour.","t":131.46,"e":136.96,"w":[["J'ai",131.46,131.66],["noyé",131.82,132.3],["mes",132.38,132.66],["rêves",132.76,134.44],["dans",135.16,135.38],["ce",135.48,135.66],["faux",135.84,136.22],["amour",136.26,136.96]],"ok":1.0},{"text":"Regarde mes larmes couler sur ma peau,","t":137.08,"e":139.82,"w":[["Regarde",137.08,137.42],["mes",137.48,137.62],["larmes",137.68,138.06],["couler",138.12,138.48],["sur",138.6,138.92],["ma",139,139.26],["peau",139.36,139.82]],"ok":1.0},{"text":"T'aimer en silence était bien trop beau.","t":139.88,"e":142.46,"w":[["T'aimer",139.88,140.22],["en",140.28,140.44],["silence",140.52,140.96],["était",140.98,141.36],["bien",141.4,141.64],["trop",141.72,142.08],["beau",142.12,142.46]],"ok":1.0},{"text":"Chérie doudou, pourquoi ce silence ?","t":142.64,"e":145.86,"w":[["Chérie",142.64,143.28],["doudou",143.36,143.84],["pourquoi",144.22,144.6],["ce",144.7,144.82],["silence",144.96,145.86]],"ok":1.0},{"text":"Mon cœur se meurt dans cette souffrance...","t":146.14,"e":149.38,"w":[["Mon",146.14,146.26],["cœur",146.32,146.52],["se",146.58,146.74],["meurt",146.84,147.14],["dans",147.2,147.34],["cette",147.48,147.7],["souffrance",147.76,149.38]],"ok":1.0},{"text":"Mwen fatige... Mwen pa kapab ankò...","t":193.62,"e":198.3,"w":[["Mwen",193.62,193.78],["fatige",193.86,195.86],["Mwen",196.4,196.56],["pa",196.6,196.76],["kapab",196.84,197.52],["ankò",197.56,198.3]],"ok":1.0},{"text":"J'ai tout perdu... même mon corps.","t":199.14,"e":204.18,"w":[["J'ai",199.14,199.34],["tout",199.4,199.6],["perdu",199.74,200.7],["même",202.56,202.96],["mon",203.06,203.36],["corps",203.56,204.18]],"ok":1.0},{"text":"Regarde ce que tu as fait de moi...","t":204.46,"e":207.02,"w":[["Regarde",204.46,204.88],["ce",204.96,205.1],["que",205.18,205.34],["tu",205.44,205.8],["as",205.88,206.08],["fait",206.16,206.34],["de",206.42,206.52],["moi",206.64,207.02]],"ok":1.0},{"text":"Une mendiante d'amour, piégée sous ton toit.","t":207.62,"e":212.62,"w":[["Une",207.62,207.72],["mendiante",207.8,208.54],["d'amour",208.62,209.38],["piégée",210.56,211.42],["sous",211.58,211.88],["ton",211.96,212.22],["toit",212.28,212.62]],"ok":1.0},{"text":"Pourquoi ? Dis-moi pourquoi...","t":213.16,"e":215.46,"w":[["Pourquoi",213.16,213.66],["Dis-moi",214.2,214.62],["pourquoi",214.76,215.46]],"ok":1.0},{"text":"Dlo nan je... (Larmes aux yeux...)","t":225.77,"e":248.19,"w":[["Dlo",225.77,225.97],["nan",236.08,236.68],["je",236.8,237.04],["Larmes",240.69,240.89],["aux",244.34,244.54],["yeux",247.99,248.19]],"ok":0.33},{"text":"Tu m'as tuée... (Tu m'as tuée...)","t":251.64,"e":253.88,"w":[["Tu",251.64,251.8],["m'as",251.86,252.34],["tuée",252.42,252.8],["Tu",253,253.1],["m'as",253.18,253.44],["tuée",253.52,253.88]],"ok":1.0},{"text":"Mon cœur est mort...","t":257.24,"e":258.92,"w":[["Mon",257.24,257.46],["cœur",257.54,258.1],["est",258.12,258.36],["mort",258.4,258.92]],"ok":1.0}]}