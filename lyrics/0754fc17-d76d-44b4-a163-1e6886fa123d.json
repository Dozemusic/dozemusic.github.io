ent",157.74,158.18]],"ok":1.0},{"text":"Au bout du voyage","t":161.06,"e":162.22,"w":[["Au",161.06,161.16],["bout",161.22,161.34],["du",161.42,161.62],["voyage",161.68,162.22]],"ok":1.0},{"text":"Je porte encore ton nom","t":164.22,"e":167.92,"w":[["Je",164.22,164.38],["porte",164.52,164.84],["encore",164.94,165.4],["ton",165.48,165.62],["nom",165.68,167.92]],"ok":1.0},{"text":"Déception dans les valises","t":167.98,"e":169.76,"w":[["Déception",167.98,168.56],["dans",168.62,168.74],["les",168.78,168.9],["valises",168.98,169.76]],"ok":1.0},{"text":"Amour dans le sang","t":172.18,"e":173.64,"w":[["Amour",172.18,172.5],["dans",172.56,172.7],["le",172.76,172.88],["sang",173.04,173.64]],"ok":1.0},{"text":"Oui, je t’aime quand même","t":175.38,"e":177.2,"w":[["Oui",175.38,175.5],["je",175.58,175.8],["t’aime",175.86,176.28],["quand",176.36,176.68],["même",176.82,177.2]],"ok":1.0},{"text":"Quand tout devient silence","t":178.4,"e":180.14,"w":[["Quand",178.4,178.62],["tout",178.7,178.84],["devient",178.9,179.38],["silence",179.48,180.14]],"ok":1.0},{"text":"Je t’aime quand même","t":183.12,"e":184.66,"w":[["Je",183.12,183.34],["t’aime",183.44,183.82],["quand",183.9,184.22],["même",184.38,184.66]],"ok":1.0},{"text":"Contre ton indifférence","t":186.74,"e":188.64,"w":[["Contre",186.74,187.14],["ton",187.22,187.42],["indifférence",187.5,188.64]],"ok":1.0}]}