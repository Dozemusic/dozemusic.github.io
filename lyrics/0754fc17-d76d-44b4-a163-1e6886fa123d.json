{"v":1,"src":"scribe+alignement","coverage":1.0,"lines":[{"text":"J’ai pris ta main sur le quai","t":14.88,"e":16.3,"w":[["J’ai",14.88,15],["pris",15.02,15.16],["ta",15.22,15.34],["main",15.4,15.6],["sur",15.68,15.82],["le",15.88,16.06],["quai",16.16,16.3]],"ok":1.0},{"text":"Le vent savait déjà tout","t":16.5,"e":17.98,"w":[["Le",16.5,16.56],["vent",16.62,16.76],["savait",16.84,17.24],["déjà",17.32,17.72],["tout",17.78,17.98]],"ok":1.0},{"text":"Tes yeux disaient “reste”","t":18.8,"e":20.1,"w":[["Tes",18.8,18.96],["yeux",19,19.14],["disaient",19.18,19.6],["reste",19.62,20.1]],"ok":1.0},{"text":"Mais ton cœur partait partout","t":20.24,"e":21.74,"w":[["Mais",20.24,20.36],["ton",20.4,20.54],["cœur",20.58,20.82],["partait",20.9,21.26],["partout",21.36,21.74]],"ok":1.0},{"text":"J’ai compté les pas, les semaines","t":22.12,"e":24.08,"w":[["J’ai",22.12,22.24],["compté",22.28,22.62],["les",22.8,22.92],["pas",22.98,23.18],["les",23.26,23.36],["semaines",23.44,24.08]],"ok":1.0},{"text":"Sur les routes, sous la pluie","t":24.2,"e":25.7,"w":[["Sur",24.2,24.34],["les",24.38,24.5],["routes",24.66,24.88],["sous",24.96,25.1],["la",25.14,25.22],["pluie",25.32,25.7]],"ok":1.0},{"text":"Et ton silence dans la poche","t":25.96,"e":27.62,"w":[["Et",25.96,26.02],["ton",26.08,26.22],["silence",26.28,26.82],["dans",26.86,26.98],["la",27.04,27.12],["poche",27.24,27.62]],"ok":1.0},{"text":"Pesa plus lourd que la nuit","t":27.78,"e":29.36,"w":[["Pesa",27.78,28.08],["plus",28.14,28.34],["lourd",28.44,28.7],["que",28.76,28.86],["la",28.92,29.04],["nuit",29.1,29.36]],"ok":1.0},{"text":"J’ai cru lire dans tes gestes","t":29.98,"e":31.6,"w":[["J’ai",29.98,30.1],["cru",30.14,30.28],["lire",30.36,30.6],["dans",30.66,30.92],["tes",31,31.22],["gestes",31.26,31.6]],"ok":1.0},{"text":"Un endroit pour revenir","t":31.64,"e":33.24,"w":[["Un",31.64,31.74],["endroit",31.78,32.14],["pour",32.26,32.44],["revenir",32.46,33.24]],"ok":1.0},{"text":"Mais la mer garde ses secrets","t":33.5,"e":35.38,"w":[["Mais",33.5,33.6],["la",33.66,33.76],["mer",33.82,34.04],["garde",34.12,34.38],["ses",34.46,34.68],["secrets",34.78,35.38]],"ok":1.0},{"text":"Et toi, tu laissais tout fuir","t":35.42,"e":37.02,"w":[["Et",35.42,35.46],["toi",35.52,35.64],["tu",35.72,35.84],["laissais",36,36.4],["tout",36.46,36.6],["fuir",36.68,37.02]],"ok":1.0},{"text":"Moi, j’avançais sans faire de bruit","t":37.26,"e":39.08,"w":[["Moi",37.26,37.34],["j’avançais",37.38,37.98],["sans",38.04,38.16],["faire",38.24,38.5],["de",38.56,38.64],["bruit",38.68,39.08]],"ok":1.0},{"text":"Le nom de l’amour sur la peau","t":39.18,"e":40.66,"w":[["Le",39.18,39.26],["nom",39.32,39.44],["de",39.48,39.56],["l’amour",39.62,40],["sur",40.08,40.22],["la",40.28,40.36],["peau",40.46,40.66]],"ok":1.0},{"text":"Et dans le fond de ton regard","t":41.08,"e":42.9,"w":[["Et",41.08,41.14],["dans",41.2,41.34],["le",41.38,41.56],["fond",41.66,41.82],["de",41.86,42.06],["ton",42.14,42.3],["regard",42.36,42.9]],"ok":1.0},{"text":"Il restait comme un bateau","t":42.98,"e":44.62,"w":[["Il",42.98,43.04],["restait",43.08,43.48],["comme",43.58,43.88],["un",43.92,44],["bateau",44.04,44.62]],"ok":1.0},{"text":"Mais je t’aime quand même","t":44.68,"e":45.88,"w":[["Mais",44.68,44.78],["je",44.82,44.92],["t’aime",44.98,45.24],["quand",45.28,45.42],["même",45.5,45.88]],"ok":1.0},{"text":"Oui, je t’aime quand même","t":46.56,"e":47.78,"w":[["Oui",46.56,46.66],["je",46.7,46.8],["t’aime",46.86,47.12],["quand",47.18,47.34],["même",47.38,47.78]],"ok":1.0},{"text":"Même si tu m’oublies","t":48.3,"e":49.48,"w":[["Même",48.3,48.54],["si",48.58,48.68],["tu",48.74,48.88],["m’oublies",48.94,49.48]],"ok":1.0},{"text":"Moi, je t’aime quand même","t":50.36,"e":51.56,"w":[["Moi",50.36,50.44],["je",50.5,50.6],["t’aime",50.64,50.92],["quand",50.96,51.12],["même",51.16,51.56]],"ok":1.0},{"text":"Mais je t’aime quand même","t":52.24,"e":53.6,"w":[["Mais",52.24,52.32],["je",52.36,52.46],["t’aime",52.52,52.8],["quand",52.84,52.98],["même",53.04,53.6]],"ok":1.0},{"tex