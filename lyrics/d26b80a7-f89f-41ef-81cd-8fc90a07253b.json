{"v":1,"src":"scribe+alignement","coverage":0.959,"lines":[{"text":"Charles le bon on The beat... (on the beat... on the beat...)","t":9.38,"e":12.38,"w":[["Charles",9.38,9.8],["le",9.82,10.02],["bon",9.84,10.14],["on",10.14,10.3],["The",10.34,10.44],["beat",10.54,10.92],["on",11.26,11.34],["the",11.38,11.48],["beat",11.56,11.78],["on",11.78,11.86],["the",11.9,12],["beat",12.08,12.38]],"ok":0.92},{"text":"Open my eyes, Lord, lead the way.","t":21.66,"e":35.14,"w":[["Open",21.66,22.16],["my",26.48,26.76],["eyes",28.86,28.86],["Lord",28.86,28.86],["lead",30.88,31.08],["the",32.91,33.11],["way",34.94,35.14]],"ok":0.57},{"text":"When the shadows try to cover up my morning light","t":36.96,"e":39.88,"w":[["When",36.96,37.08],["the",37.14,37.22],["shadows",37.28,37.76],["try",37.82,38.12],["to",38.18,38.28],["cover",38.36,38.68],["up",38.78,38.84],["my",38.9,39.02],["morning",39.1,39.52],["light",39.6,39.88]],"ok":1.0},{"text":"And the heavy burden makes it hard to stand upright","t":40.82,"e":43.92,"w":[["And",40.82,40.94],["the",40.98,41.1],["heavy",41.16,41.44],["burden",41.5,41.96],["makes",42.02,42.22],["it",42.32,42.46],["hard",42.56,42.84],["to",42.9,42.98],["stand",43.04,43.28],["upright",43.38,43.92]],"ok":1.0},{"text":"I lift my hands to the heavens above","t":44.94,"e":47.52,"w":[["I",44.94,45.1],["lift",45.16,45.32],["my",45.38,45.64],["hands",45.72,46.16],["to",46.22,46.36],["the",46.44,46.68],["heavens",46.76,47.1],["above",47.18,47.52]],"ok":1.0},{"text":"Surrendered completely to Your mercy and love.","t":48.12,"e":50.9,"w":[["Surrendered",48.12,48.58],["completely",48.64,49.48],["to",49.54,49.66],["Your",49.7,49.82],["mercy",49.88,50.2],["and",50.24,50.36],["love",50.44,50.9]],"ok":1.0},{"text":"No weapon formed against me shall ever prosper now!","t":51.82,"e":54.86,"w":[["No",51.82,51.96],["weapon",52,52.44],["formed",52.52,52.86],["against",52.96,53.32],["me",53.38,53.48],["shall",53.52,53.72],["ever",53.8,54.02],["prosper",54.06,54.5],["now",54.64,54.