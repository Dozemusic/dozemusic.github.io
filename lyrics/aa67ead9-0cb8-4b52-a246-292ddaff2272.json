{"v":1,"src":"scribe+alignement","coverage":0.948,"lines":[{"text":"Yeah… Elengi ya bolingo, ékómi mawa…","t":6.06,"e":8.7,"w":[["Yeah",6.06,6.26],["Elengi",6.36,6.72],["ya",6.74,6.82],["bolingo",6.88,7.38],["ékómi",7.44,8],["mawa",8.08,8.7]],"ok":0.83},{"text":"Tala, bolingo na ngai ézali ndoto…","t":10.12,"e":13.58,"w":[["Tala",10.12,10.4],["bolingo",11.52,11.88],["na",11.92,12.02],["ngai",12.06,12.3],["ézali",12.34,12.74],["ndoto",12.82,13.58]],"ok":1.0},{"text":"Listen.","t":15.46,"e":15.88,"w":[["Listen",15.46,15.88]],"ok":1.0},{"text":"Les draps sont froids,","t":28.58,"e":29.5,"w":[["Les",28.58,28.72],["draps",28.78,29.02],["sont",29.04,29.16],["froids",29.26,29.5]],"ok":1.0},{"text":"Le souvenir est un poison.","t":30.28,"e":32.26,"w":[["Le",30.28,30.36],["souvenir",30.46,31.1],["est",31.14,31.32],["un",31.36,31.48],["poison",31.54,32.26]],"ok":1.0},{"text":"J'ai perdu ton étoile,","t":33.14,"e":34.42,"w":[["J'ai",33.14,33.32],["perdu",33.4,33.74],["ton",33.82,34],["étoile",34.1,34.42]],"ok":1.0},{"text":"J'ai perdu ma raison.","t":34.46,"e":35.88,"w":[["J'ai",34.46,34.6],["perdu",34.66,35.02],["ma",35.1,35.26],["raison",35.32,35.88]],"ok":1.0},{"text":"Le décor est posé,","t":36.54,"e":37.7,"w":[["Le",36.54,36.66],["décor",36.74,37.14],["est",37.18,37.3],["posé",37.36,37.7]],"ok":1.0},{"text":"Mais le rôle est trop grand.","t":37.8,"e":39.2,"w":[["Mais",37.8,37.94],["le",37.98,38.12],["rôle",38.18,38.4],["est",38.42,38.54],["trop",38.6,38.92],["grand",38.98,39.2]],"ok":1.0},{"text":"Je navigue seul,","t":39.44,"e":40.5,"w":[["Je",39.44,39.56],["navigue",39.64,40.08],["seul",40.18,40.5]],"ok":1.0},{"text":"Dans cet océan de tourments.","t":40.56,"e":42.54,"w":[["Dans",40.56,40.7],["cet",40.78,41.02],["océan",41.06,41.68],["de",41.74,41.9],["tourments",41.98,42.54]],"ok":1.0},{"text":"Mo-te-ma na ngai é-za-li ko-tu-na, wa-pi yo?","t":42.76,"e":46.11,"w":[["Mo-te-ma",42.76,43.32],["na",43.4,43.5],["ngai",43.54,43.8],["é-za-li",43.84,44.36],["ko-tu-na",44.42,44.78],["wa-pi",45.1,45.7],["yo",45.91,46.11]],"ok":0.86},{"text":"Na ka-ti ya mwin-do, na zon-gi na mo-tam-bo-li ya mi-so.","t":46.12,"e":49.46,"w":[["Na",46.12,46.24],["ka-ti",46.3,46.58],["ya",46.6,46.68],["mwin-do",46.72,47.08],["na",47.11,47.31],["zon-gi",47.14,47.72],["na",47.78,47.9],["mo-tam-bo-li",47.98,48.58],["ya",48.68,48.8],["mi-so",48.9,49.46]],"ok":0.9},{"text":"Ba-ssa, na mo-te-ma...","t":52.58,"e":54.4,"w":[["Ba-ssa",52.58,53.36],["na",53.62,53.74],["mo-te-ma",53.82,54.4]],"ok":1.0},{"text":"O-za el-en-gi, o-za li-ta-ma.","t":54.94,"e":57.94,"w":[["O-za",54.94,55.42],["el-en-gi",55.5,56.08],["o-za",56.62,57.08],["li-ta-ma",57.16,57.94]],"ok":1.0},{"text":"Ba-ssa, na mo-te-ma...","t":59.26,"e":61.02,"w":[["Ba-ssa",59.26,60.02],["na",60.24,60.4],["mo-te-ma",60.48,61.02]],"ok":1.0},{"text":"O-zo ko-ti-a ngai, na mu-ku-ma.","t":61.12,"e":64.62,"w":[["O-zo",61.12,62.1],["ko-ti-a",62.31,62.51],["ngai",62.52,62.92],["na",63.58,63.74],["mu-ku-ma",63.82,64.62]],"ok":0.8},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":65.26,"e":67.52,"w":[["Na",65.26,65.42],["le-la",65.46,65.84],["yo",65.92,66.08],["lé-lé",66.3,66.68],["lé-lé",66.74,67.06],["yo",67.16,67.52]],"ok":1.0},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":68.58,"e":70.86,"w":[["Na",68.58,68.76],["le-la",68.82,69.16],["yo",69.24,69.48],["lé-lé",69.64,70],["lé-lé",70.08,70.42],["yo",70.5,70.86]],"ok":1.0},{"text":"Bolingo na ngai é-ko-mi, é-ko-mi, é-ko-mi...","t":71.1,"e":74.82,"w":[["Bolingo",71.1,71.68],["na",71.74,71.86],["ngai",71.88,72.1],["é-ko-mi",72.44,72.94],["é-ko-mi",73.24,73.76],["é-ko-mi",74.08,74.82]],"ok":1.0},{"text":"Clas-sique !","t":75.44,"e":76.18,"w":[["Clas-sique",75.44,76.18]],"ok":1.0},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":78.6,"e":80.86,"w":[["Na",78.6,78.74],["le-la",78.8,79.16],["yo",79.24,79.5],["lé-lé",79.64,80],["lé-lé",80.08,80.42],["yo",80.5,80.86]],"ok":1.0},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":81.1,"e":84,"w":[["Na",81.1,81.26],["le-la",81.32,81.7],["yo",81.76,82.12],["lé-lé",83,83.34],["lé-lé",83.42,83.72],["yo",83.84,84]],"ok":1.0},{"text":"O-za mo-bi-m-ba, o-za ngai, o-za ngai...","t":84.48,"e":87.74,"w":[["O-za",84.48,84.98],["mo-bi-m-ba",85.08,85.86],["o-za",86.16,86.44],["ngai",86.48,86.92],["o-za",87,87.28],["ngai",87.32,87.74]],"ok":1.0},{"text":"Ma-gique !","t":88.8,"e":89.54,"w":[["Ma-gique",88.8,89.54]],"ok":1.0},{"text":"Na lu-ka-ki yo na ka-ti ya ba rê-ves,","t":91.94,"e":94.48,"w":[["Na",91.94,92.08],["lu-ka-ki",92.14,92.72],["yo",92.85,93.05],["na",92.98,93.12],["ka-ti",93.18,93.46],["ya",93.48,93.56],["ba",93.6,93.76],["rê-ves",93.84,94.48]],"ok":0.88},{"text":"Mais réa-li-té é-za-li ma-ka-si, é-za-li ba grè-ves.","t":94.86,"e":98.14,"w":[["Mais",94.86,95],["réa-li-té",95.08,95.84],["é-za-li",95.86,96.24],["ma-ka-si",96.3,96.8],["é-za-li",96.84,97.3],["ba",97.34,97.5],["grè-ves",97.58,98.14]],"ok":1.0},{"text":"Les mots ne suffisent plus,","t":98.2,"e":99.62,"w":[["Les",98.2,98.34],["mots",98.4,98.56],["ne",98.62,98.74],["suffisent",98.82,99.28],["plus",99.36,99.62]],"ok":1.0},{"text":"À combler ton absence.","t":99.92,"e":101.34,"w":[["À",99.92,100],["combler",100.08,100.42],["ton",100.48,100.64],["absence",100.74,101.34]],"ok":1.0},{"text":"Je m'efface doucement,","t":101.54,"e":102.94,"w":[["Je",101.54,101.66],["m'efface",101.72,102.16],["doucement",102.2,102.94]],"ok":1.0},{"text":"Dans cette triste silence.","t":103.2,"e":104.62,"w":[["Dans",103.2,103.32],["cette",103.45,103.65],["triste",103.58,103.94],["silence",104.04,104.62]],"ok":0.75},{"text":"O’ti-ke-li nga-i, ka-ka ma-wa ya pam-ba,","t":105.08,"e":107.66,"w":[["O’ti-ke-li",105.08,105.42],["nga-i",105.46,105.92],["ka-ka",106.1,106.44],["ma-wa",106.5,106.88],["ya",106.92,107.1],["pam-ba",107.16,107.66]],"ok":1.0},{"text":"Nga na za-li ko le-la, ka-si o-za si-ka pam-ba.","t":107.84,"e":110.98,"w":[["Nga",107.84,108.04],["na",108.02,108.22],["za-li",108.2,108.74],["ko",108.79,108.99],["le-la",108.84,109.36],["ka-si",109.42,109.7],["o-za",109.72,109.92],["si-ka",109.74,110.38],["pam-ba",110.5,110.98]],"ok":0.56},{"text":"Li-bo-ta na nga-i é-za-li ko tu-na nga-i, wa-pi mwa-si na yo?","t":111.1,"e":115.42,"w":[["Li-bo-ta",111.1,112.32],["na",112.36,112.48],["nga-i",112.52,112.76],["é-za-li",112.8,113.12],["ko",113.18,113.54],["tu-na",113.6,113.72],["nga-i",113.76,114.16],["wa-pi",114.22,114.56],["mwa-si",114.62,115],["na",115.06,115.22],["yo",115.26,115.42]],"ok":1.0},{"text":"Na-za-li na mba-no te, ka-ka ba pin-zo-li na mi-so.","t":115.7,"e":118.76,"w":[["Na-za-li",115.7,116.26],["na",116.32,116.42],["mba-no",116.46,117.08],["te",117.11,117.31],["ka-ka",117.14,117.32],["ba",117.36,117.52],["pin-zo-li",117.58,117.94],["na",118.18,118.32],["mi-so",118.4,118.76]],"ok":0.89},{"text":"Mo-ko-lo ni-on-so na ta-la-ka bi-li-lin-gi na yo.","t":119.02,"e":122.08,"w":[["Mo-ko-lo",119.02,119.6],["ni-on-so",119.66,120.2],["na",120.26,120.4],["ta-la-ka",120.48,120.84],["bi-li-lin-gi",120.92,121.68],["na",121.74,121.88],["yo",121.92,122.08]],"ok":1.0},{"text":"Mo-te-ma é-za-li ko pi-ka lo-ko-la ngo-nga ya ek-le-si-ya.","t":122.14,"e":126.08,"w":[["Mo-te-ma",122.14,122.7],["é-za-li",122.7,123.12],["ko",123.16,123.36],["pi-ka",123.2,123.76],["lo-ko-la",123.82,124.18],["ngo-nga",124.46,124.96],["ya",125.03,125.23],["ek-le-si-ya",125.1,126.08]],"ok":0.75},{"text":"O-za-li mo-si-ka, ka-si na yo-ka mon-gon-go na yo.","t":126.36,"e":129.62,"w":[["O-za-li",126.36,126.88],["mo-si-ka",126.94,127.52],["ka-si",127.58,127.92],["na",127.98,128.12],["yo-ka",128.42,128.56],["mon-gon-go",128.62,129.18],["na",129.26,129.38],["yo",129.46,129.62]],"ok":1.0},{"text":"Bo-lin-go ya so-lo e-za ma-wa, e-za pe e-len-gi.","t":129.68,"e":132.9,"w":[["Bo-lin-go",129.68,130.18],["ya",130.24,130.4],["so-lo",130.5,130.74],["e-za",130.82,131.06],["ma-wa",131.12,131.66],["e-za",131.76,132.08],["pe",132.12,132.32],["e-len-gi",132.16,132.9]],"ok":0.88},{"text":"Zon-ga na nda-ko, zon-ga pem-be-ni ya mo-te-ma.","t":132.98,"e":136.18,"w":[["Zon-ga",132.98,133.34],["na",133.4,133.52],["nda-ko",133.56,134.04],["zon-ga",134.24,134.56],["pem-be-ni",134.64,135],["ya",135.1,135.22],["mo-te-ma",135.28,136.18]],"ok":1.0},{"text":"E-za ki-to-ko, e-za ma-wa, e-za ki-mi-a…","t":138.44,"e":143.08,"w":[["E-za",138.44,138.94],["ki-to-ko",139.04,139.8],["e-za",140.16,140.66],["ma-wa",140.74,141.16],["e-za",141.86,142.34],["ki-mi-a",142.46,143.08]],"ok":1.0},{"text":"Ta-la bo-mo-i na nga-i é-za-li po na yo.","t":143.7,"e":146.9,"w":[["Ta-la",143.7,143.9],["bo-mo-i",143.94,144.22],["na",144.26,144.36],["nga-i",144.4,144.66],["é-za-li",145.3,145.94],["po",146.04,146.38],["na",146.46,146.62],["yo",146.68,146.9]],"ok":1.0},{"text":"Hé! Zon-ga, zon-ga ma-ma…","t":147.31,"e":149.14,"w":[["Hé",147.31,147.51],["Zon-ga",147.72,148.08],["zon-ga",148.16,148.5],["ma-ma",148.98,149.14]],"ok":0.75},{"text":"O-za mon tré-sor, o-za ma mé-lan-co-li-e.","t":152.02,"e":156.5,"w":[["O-za",152.02,152.26],["mon",152.34,152.48],["tré-sor",152.52,153.2],["o-za",154.48,154.78],["ma",154.84,155],["mé-lan-co-li-e",155.08,156.5]],"ok":1.0},{"text":"Ba-ssa, na mo-te-ma...","t":159.5,"e":161.34,"w":[["Ba-ssa",159.5,160.28],["na",160.52,160.66],["mo-te-ma",160.74,161.34]],"ok":1.0},{"text":"O-za el-en-gi, o-za li-ta-ma.","t":161.86,"e":164.9,"w":[["O-za",161.86,162.36],["el-en-gi",162.44,163],["o-za",163.52,164.04],["li-ta-ma",164.1,164.9]],"ok":1.0},{"text":"Ba-ssa, na mo-te-ma...","t":166.2,"e":168.04,"w":[["Ba-ssa",166.2,166.98],["na",167.24,167.38],["mo-te-ma",167.46,168.04]],"ok":1.0},{"text":"O-zo ko-ti-a ngai, na mu-ku-ma.","t":168.2,"e":171.62,"w":[["O-zo",168.2,169.08],["ko-ti-a",169.33,169.53],["ngai",169.58,169.94],["na",170.58,170.74],["mu-ku-ma",170.82,171.62]],"ok":0.8},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":172.3,"e":174.56,"w":[["Na",172.3,172.44],["le-la",172.5,172.86],["yo",172.94,173.12],["lé-lé",173.34,173.72],["lé-lé",173.78,174.14],["yo",174.22,174.56]],"ok":1.0},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":175.64,"e":177.72,"w":[["Na",175.64,175.8],["le-la",175.86,176.22],["yo",176.3,176.52],["lé-lé",176.72,177.08],["lé-lé",177.14,177.48],["yo",177.58,177.72]],"ok":1.0},{"text":"Bolingo na ngai é-ko-mi, é-ko-mi, é-ko-mi...","t":178.16,"e":181.94,"w":[["Bolingo",178.16,178.74],["na",178.82,178.94],["ngai",178.96,179.3],["é-ko-mi",179.32,180.04],["é-ko-mi",180.36,180.88],["é-ko-mi",181.16,181.94]],"ok":1.0},{"text":"Clas-sique !","t":182.58,"e":183.28,"w":[["Clas-sique",182.58,183.28]],"ok":1.0},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":185.76,"e":189.32,"w":[["Na",185.76,185.9],["le-la",185.96,186.32],["yo",186.4,186.56],["lé-lé",186.84,187.2],["lé-lé",187.26,187.62],["yo",188.94,189.32]],"ok":1.0},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":189.38,"e":191.22,"w":[["Na",189.38,189.44],["le-la",189.44,189.7],["yo",189.78,190.1],["lé-lé",190.2,190.54],["lé-lé",190.62,190.96],["yo",191.04,191.22]],"ok":1.0},{"text":"O-za mo-bi-m-ba, o-za ngai, o-za ngai...","t":191.66,"e":194.94,"w":[["O-za",191.66,192.22],["mo-bi-m-ba",192.3,193.1],["o-za",193.38,193.68],["ngai",193.72,194.16],["o-za",194.24,194.52],["ngai",194.58,194.94]],"ok":1.0},{"text":"Ma-gique !","t":196.06,"e":196.8,"w":[["Ma-gique",196.06,196.8]],"ok":1.0},{"text":"Na le-la yo…","t":202.62,"e":203.38,"w":[["Na",202.62,202.76],["le-la",202.8,203.14],["yo",203.22,203.38]],"ok":1.0},{"text":"Bolingo é-ko-mi ma-wa…","t":205.14,"e":207.02,"w":[["Bolingo",205.14,205.62],["é-ko-mi",205.68,206.32],["ma-wa",206.4,207.02]],"ok":1.0},{"text":"C’est fi-ni.","t":222.04,"e":222.62,"w":[["C’est",222.04,222.22],["fi-ni",222.32,222.62]],"ok":1.0}]}