{"v":1,"src":"scribe+alignement","coverage":0.857,"lines":[{"text":"Charles le bon on the beat...","t":2.76,"e":4.14,"w":[["Charles",2.76,3.12],["le",3.14,3.34],["bon",3.16,3.46],["on",3.5,3.62],["the",3.66,3.74],["beat",3.82,4.14]],"ok":0.83},{"text":"Na butu ya molili, pole nayo ezwaki ngai","t":14.96,"e":20.64,"w":[["Na",14.96,15.2],["butu",15.24,15.62],["ya",15.68,15.86],["molili",15.92,16.8],["pole",18.62,19.06],["nayo",19.14,19.3],["ezwaki",19.38,19.58],["ngai",19.82,20.64]],"ok":1.0},{"text":"Obongolaki mawa na ngai, napesi makasi lisusu","t":22.44,"e":28.94,"w":[["Obongolaki",22.44,22.98],["mawa",23.52,23.68],["na",23.72,23.98],["ngai",24.02,24.74],["napesi",26.46,26.78],["makasi",26.84,27.64],["lisusu",27.7,28.94]],"ok":1.0},{"text":"Tango nyonso ezalaki lokola elimwa, ofungolaki nzela","t":30.44,"e":36.22,"w":[["Tango",30.44,30.9],["nyonso",30.94,31.3],["ezalaki",31.36,31.86],["lokola",31.96,32.66],["elimwa",32.82,33.34],["ofungolaki",34.62,35.16],["nzela",35.72,36.22]],"ok":1.0},{"text":"Opesaki ngai elikya, kati na maboko ma ngai","t":38.1,"e":44.32,"w":[["Opesaki",38.1,38.78],["ngai",38.86,39.28],["elikya",39.42,40.22],["kati",42.02,42.38],["na",42.44,42.54],["maboko",42.6,43.3],["ma",43.36,43.64],["ngai",43.68,44.32]],"ok":1.0},{"text":"Liglasi nyonso ekomi elembo ya elonga","t":46.42,"e":51.94,"w":[["Liglasi",46.42,47.2],["nyonso",47.24,48.02],["ekomi",49.92,50.4],["elembo",50.46,50.92],["ya",50.95,51.15],["elonga",50.98,51.94]],"ok":0.83},{"text":"Nakotambola lisusu moko te, ozali bosantoshi na ngai","t":54.06,"e":59.74,"w":[["Nakotambola",54.06,54.72],["lisusu",54.78,55.42],["moko",55.54,56],["te",56.16,56.4],["ozali",57.76,57.98],["bosantoshi",58.78,59.2],["na",59.26,59.38],["ngai",59.44,59.74]],"ok":1.0},{"text":"Nalingi yo, oyebi yango, mopu na ngai, mokonzi na ngai! (Lagô ayo !)","t":62.18,"e":69.6,"w":[["Nalingi",62.18,62.82],["yo",63,63.14],["oyebi",63.21,63.41],["yango",63.28,64.08],["mopu",64.36,64.78],["na",64.84,64.96],["ngai",65,65.68],["