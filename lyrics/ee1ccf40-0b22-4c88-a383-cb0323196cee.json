{"v":1,"src":"scribe+alignement","coverage":0.88,"lines":[{"text":"Style : Rumba Congolaise / Afro-fusion","t":13.92,"e":15.02,"w":[["Style",13.92,14.12],["Rumba",14.22,14.42],["Congolaise",14.52,14.72],["Afro-fusion",14.82,15.02]],"ok":0.0},{"text":"Marco one the beat…","t":15.12,"e":16.22,"w":[["Marco",15.12,15.32],["one",15.42,15.62],["the",15.72,15.92],["beat",16.02,16.22]],"ok":0.0},{"text":"On dit que l’amour est aveugle, mais aujourd'hui, j'ai les yeux grands ouverts sur le vide que tu as laissé...","t":16.32,"e":26,"w":[["On",16.32,16.42],["dit",16.46,16.58],["que",16.64,16.76],["l’amour",16.8,17.16],["est",17.18,17.38],["aveugle",17.44,18.1],["mais",19.72,19.86],["aujourd'hui",19.88,20.44],["j'ai",20.78,20.96],["les",21.02,21.18],["yeux",21.22,21.36],["grands",21.4,21.7],["ouverts",21.76,22.16],["sur",22.24,22.42],["le",22.46,22.58],["vide",22.7,23.1],["que",24.78,24.88],["tu",24.94,25.08],["as",25.16,25.26],["laissé",25.32,26]],"ok":1.0},{"text":"Couplet 1 (Français)","t":26.25,"e":26.96,"w":[["Couplet",26.25,26.45],["1",26.51,26.71],["Français",26.77,26.96]],"ok":0.0},{"text":"J’ai compté les jours, j’ai compté mes erreurs","t":27.02,"e":29.48,"w":[["J’ai",27.02,27.18],["compté",27.24,27.72],["les",27.76,27.9],["jours",27.96,28.16],["j’ai",28.2,28.34],["compté",28.4,28.84],["mes",28.9,29.08],["erreurs",29.12,29.48]],"ok":1.0},{"text":"Le silence de la maison résonne dans mon cœur","t":29.7,"e":32.08,"w":[["Le",29.7,29.78],["silence",29.84,30.2],["de",30.22,30.3],["la",30.36,30.46],["maison",30.54,30.92],["résonne",31,31.44],["dans",31.48,31.62],["mon",31.68,31.84],["cœur",31.9,32.08]],"ok":1.0},{"text":"J’ai cru que t’avoir était un acquis, une évidence","t":32.26,"e":35.9,"w":[["J’ai",32.26,32.4],["cru",32.42,32.58],["que",32.62,32.74],["t’avoir",32.8,33.44],["était",33.52,33.92],["un",34,34.12],["acquis",34.2,34.68],["une",35,35.1],["évidence",35.18,35.9]],"ok":1.0},{"text":"J’ai joué avec le feu, j'ai brûlé notre chance","t":37.48,"e":40.1,"w":[["J’ai",37.48,37.62],["joué",37.66,37.82],["avec",37.94,38.18],["le",38.22,38.36],["feu",38.44,38.7],["j'ai",38.78,38.92],["brûlé",38.96,39.26],["notre",39.32,39.6],["chance",39.64,40.1]],"ok":1.0},{"text":"Aujourd'hui le lit est vaste, le café est froid","t":40.16,"e":42.6,"w":[["Aujourd'hui",40.16,40.54],["le",40.56,40.56],["lit",40.62,40.76],["est",40.78,40.88],["vaste",40.94,41.34],["le",41.44,41.54],["café",41.62,42.04],["est",42.08,42.2],["froid",42.3,42.6]],"ok":1.0},{"text":"Je cherche ton parfum, mais il n'y a plus que moi","t":43.08,"e":46.02,"w":[["Je",43.08,43.16],["cherche",43.2,43.4],["ton",43.44,43.62],["parfum",43.68,44.16],["mais",44.38,44.54],["il",44.6,44.66],["n'y",44.72,44.92],["a",45,45.12],["plus",45.24,45.44],["que",45.5,45.68],["moi",45.76,46.02]],"ok":1.0},{"text":"Si je pouvais reculer la montre et le temps","t":48.42,"e":51.48,"w":[["Si",48.42,48.54],["je",48.6,48.8],["pouvais",48.86,49.22],["reculer",49.28,49.86],["la",49.92,50.08],["montre",50.16,50.82],["et",50.86,50.92],["le",50.96,51.08],["temps",51.16,51.48]],"ok":1.0},{"text":"Je te dirais \"je t'aime\" plus fort qu'avant. Marco le sait","t":53.14,"e":56.91,"w":[["Je",53.14,53.22],["te",53.28,53.4],["dirais",53.46,53.76],["je",53.82,53.94],["t'aime",54.1,54.54],["plus",54.64,54.8],["fort",54.86,55.06],["qu'avant",55.1,55.56],["Marco",55.76,56.2],["le",56.45,56.65],["sait",56.71,56.91]],"ok":0.82},{"text":"Couplet 2 (Lingala)","t":56.96,"e":57.67,"w":[["Couplet",56.96,57.16],["2",57.21,57.41],["Lingala",57.47,57.67]],"ok":0.0},{"text":"Motema na ngai ezo zoka, mawa trop","t":57.72,"e":61.42,"w":[["Motema",57.72,58.14],["na",58.2,58.28],["ngai",58.3,58.64],["ezo",58.66,58.86],["zoka",58.68,59.64],["mawa",60.18,60.74],["trop",61.1,61.42]],"ok":0.86},{"text":"Okeyi olingi kotala lisusu sima te","t":61.7,"e":65.26,"w":[["Okeyi",61.7,62.16],["olingi",62.3,62.68],["kotala",62.78,63.36],["lisusu",63.44,64.28],["sima",64.36,64.94],["te",65.06,65.26]],"ok":1.0},{"text":"Soki na yébaki, nde na salaki boye te","t":65.34,"e":69.78,"w":[["Soki",65.34,65.94],["na",65.99,66.19],["yébaki",66.04,67.2],["nde",67.8,68.06],["na",68.08,68.28],["salaki",68.1,68.86],["boye",68.94,69.48],["te",69.62,69.78]],"ok":0.75},{"text":"Ozalaki libanga na ngai, moseka na ngai ya motéma","t":70.12,"e":74.7,"w":[["Ozalaki",70.12,70.74],["libanga",70.78,71.38],["na",71.44,71.56],["ngai",71.64,72.04],["moseka",72.7,73.32],["na",73.38,73.48],["ngai",73.54,73.84],["ya",73.86,73.98],["motéma",74.06,74.7]],"ok":1.0},{"text":"Lelo naza se moko, bipale ekomi kolela","t":75.52,"e":79.86,"w":[["Lelo",75.52,75.88],["naza",75.94,76.56],["se",76.61,76.81],["moko",76.66,77.22],["bipale",78.08,78.68],["ekomi",78.76,79.16],["kolela",79.24,79.86]],"ok":0.86},{"text":"Zonga maman, zonga mpo motema e tonda pasi","t":80.68,"e":84.42,"w":[["Zonga",80.68,80.96],["maman",81.04,81.48],["zonga",82.02,82.28],["mpo",82.32,82.44],["motema",82.5,83.12],["e",83.17,83.37],["tonda",83.22,83.88],["pasi",84,84.42]],"ok":0.88},{"text":"Bolingo na biso ezalaki lokola nzoi","t":85.1,"e":88.3,"w":[["Bolingo",85.1,85.72],["na",85.78,85.9],["biso",85.98,86.34],["ezalaki",86.46,87],["lokola",87.06,87.68],["nzoi",88.1,88.3]],"ok":0.83},{"text":"Lelo nzoi akeyi, atikeli ngai se mpasi ya kofiba.","t":88.52,"e":92.98,"w":[["Lelo",88.52,88.76],["nzoi",89.09,89.29],["akeyi",89.41,89.61],["atikeli",89.74,90.34],["ngai",90.4,90.86],["se",90.92,91.12],["mpasi",90.98,91.78],["ya",91.8,92.02],["kofiba",92.12,92.98]],"ok":0.67},{"text":"Couplet 3 (Pidgin)","t":93.2,"e":93.86,"w":[["Couplet",93.2,93.41],["3",93.43,93.63],["Pidgin",93.66,93.86]],"ok":0.0},{"text":"Charles LE BON…","t":93.88,"e":94.8,"w":[["Charles",93.88,94.36],["LE",94.41,94.61],["BON",94.46,94.8]],"ok":0.67},{"text":"I no know say water go pass gari like this","t":95.03,"e":98.82,"w":[["I",95.03,95.23],["no",95.26,95.48],["know",95.58,95.92],["say",96.06,96.28],["water",96.81,97.01],["go",97.34,97.46],["pass",97.52,97.72],["gari",97.76,98.1],["like",98.18,98.44],["this",98.5,98.82]],"ok":0.8},{"text":"I bin think say our love na forever, no be play-play","t":100.5,"e":105.74,"w":[["I",100.5,100.58],["bin",100.76,100.96],["think",100.94,101.2],["say",101.3,101.7],["our",101.78,102.04],["love",102.12,102.74],["na",102.86,103.06],["forever",103.18,103.96],["no",104.38,104.5],["be",104.56,104.7],["play-play",104.82,105.74]],"ok":0.91},{"text":"Now my eye don see pepper, my heart don heavy","t":105.84,"e":110.26,"w":[["Now",105.84,105.96],["my",106.02,106.16],["eye",106.26,106.44],["don",106.5,106.74],["see",106.86,107.32],["pepper",107.48,108.24],["my",108.62,108.76],["heart",108.82,109.04],["don",109.12,109.52],["heavy",109.64,110.26]],"ok":1.0},{"text":"I mess up big time, I no go fit lie","t":110.66,"e":114.92,"w":[["I",110.66,110.72],["mess",110.8,111.1],["up",111.16,111.32],["big",111.44,111.96],["time",112.06,112.4],["I",113.22,113.28],["no",113.36,113.6],["go",113.68,113.9],["fit",114.02,114.58],["lie",114.64,114.92]],"ok":1.0},{"text":"Your space for my life, nobody fit fill am","t":115.74,"e":118.48,"w":[["Your",115.74,115.84],["space",115.9,116.18],["for",116.22,116.36],["my",116.42,116.54],["life",116.62,116.98],["nobody",117.1,117.68],["fit",117.76,117.96],["fill",118.02,118.24],["am",118.28,118.48]],"ok":1.0},{"text":"I dey cry for night, my pillow don wet finish","t":118.62,"e":121.06,"w":[["I",118.62,118.64],["dey",118.68,118.78],["cry",118.84,119.04],["for",119.1,119.24],["night",119.32,119.6],["my",119.68,119.8],["pillow",119.86,120.14],["don",120.18,120.32],["wet",120.36,120.56],["finish",120.64,121.06]],"ok":1.0},{"text":"Baby come back, no let me die for this loneliness","t":121.16,"e":124.56,"w":[["Baby",121.16,121.42],["come",121.52,121.8],["back",121.86,122.1],["no",122.34,122.56],["let",122.62,122.84],["me",122.9,123.04],["die",123.12,123.36],["for",123.44,123.56],["this",123.6,123.8],["loneliness",123.86,124.56]],"ok":1.0},{"text":"Love wey sweet like honey, now e bitter pass leaf.","t":124.9,"e":128.58,"w":[["Love",124.9,125.32],["wey",125.4,125.56],["sweet",125.68,125.98],["like",126.04,126.34],["honey",126.4,126.98],["now",127.2,127.48],["e",127.52,127.62],["bitter",127.68,127.98],["pass",128.04,128.3],["leaf",128.38,128.58]],"ok":1.0},{"text":"Refrain (Mélange des langues)","t":128.64,"e":129.02,"w":[["Refrain",128.64,128.84],["Mélange",128.7,128.9],["des",128.76,128.96],["langues",128.82,129.02]],"ok":0.0},{"text":"Oh, mon amour, j’ai tout perdu...","t":128.88,"e":132.68,"w":[["Oh",128.88,129.24],["mon",129.32,129.5],["amour",129.64,131.34],["j’ai",131.38,131.64],["tout",131.74,131.98],["perdu",132.06,132.68]],"ok":1.0},{"text":"Bolingo na ngai, nakomi se ko lela (Mon amour, je ne fais que pleurer)","t":133.52,"e":138.28,"w":[["Bolingo",133.52,133.96],["na",134,134.1],["ngai",134.12,134.44],["nakomi",134.5,135.04],["se",135.14,135.26],["ko",135.3,135.5],["lela",135.34,136.02],["Mon",136.44,136.6],["amour",136.7,137.04],["je",137.12,137.2],["ne",137.26,137.36],["fais",137.46,137.68],["que",137.78,138],["pleurer",138.12,138.28]],"ok":0.93},{"text":"I don lose my better half, I don lose my way","t":138.44,"e":142.62,"w":[["I",138.44,138.48],["don",138.54,138.68],["lose",138.78,139.2],["my",139.26,139.5],["better",139.58,140.34],["half",140.7,140.9],["I",141.06,141.08],["don",141.14,141.3],["lose",141.4,141.96],["my",142.04,142.24],["way",142.32,142.62]],"ok":0.91},{"text":"Reviens-moi, la solitude me tue","t":143.46,"e":145.68,"w":[["Reviens-moi",143.46,144.12],["la",144.2,144.34],["solitude",144.42,145.04],["me",145.1,145.24],["tue",145.34,145.68]],"ok":1.0},{"text":"Zonga epayi na ngai, motema ezo lela","t":145.94,"e":154.72,"w":[["Zonga",145.94,146.22],["epayi",146.42,146.84],["na",146.94,147.1],["ngai",147.14,147.48],["motema",147.58,148.46],["ezo",148.5,149.44],["lela",154.42,154.72]],"ok":1.0},{"text":"Baby come back, no leave me for cold.","t":157.02,"e":161,"w":[["Baby",157.02,157.58],["come",157.68,157.96],["back",158.6,158.7],["no",158.82,158.94],["leave",159.62,159.86],["me",159.96,160.16],["for",160.24,160.5],["cold",160.6,161]],"ok":1.0},{"text":"Outro (Animation douce)","t":161.32,"e":162.18,"w":[["Outro",161.32,161.52],["Animation",161.65,161.85],["douce",161.98,162.18]],"ok":0.0},{"text":"Mawa trop... (Trop de tristesse)","t":162.3,"e":165.3,"w":[["Mawa",162.3,162.82],["trop",162.92,163.34],["Trop",163.52,164.04],["de",164.06,164.14],["tristesse",164.22,165.3]],"ok":1.0},{"text":"Likambo ya bolingo, soki okangi miso te, okomona pasi.","t":165.34,"e":171,"w":[["Likambo",165.34,165.76],["ya",165.82,165.94],["bolingo",165.98,166.56],["soki",167.1,167.32],["okangi",167.38,167.86],["miso",167.94,168.34],["te",168.44,168.64],["okomona",169.14,169.94],["pasi",170.08,171]],"ok":1.0},{"text":"C’est quand on perd une personne qu'on connaît sa valeur...","t":174.08,"e":176.52,"w":[["C’est",174.08,174.22],["quand",174.26,174.4],["on",174.44,174.54],["perd",174.62,174.8],["une",174.84,174.96],["personne",175,175.4],["qu'on",175.42,175.58],["connaît",175.64,175.9],["sa",175.96,176.08],["valeur",176.12,176.52]],"ok":1.0},{"text":"I’m sorry, baby...","t":180.16,"e":181.1,"w":[["I’m",180.16,180.28],["sorry",180.36,180.66],["baby",180.72,181.1]],"ok":1.0},{"text":"Pardon.","t":215.88,"e":216.38,"w":[["Pardon",215.88,216.38]],"ok":1.0}]}