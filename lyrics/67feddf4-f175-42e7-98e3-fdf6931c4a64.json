28],["sombre",69.4,69.68],["dans",69.72,69.84],["le",69.86,69.96],["vide",70.06,70.38]],"ok":1.0},{"text":"Leur empire s'effondre, leurs couronnes sont en plastique,","t":71.16,"e":74.1,"w":[["Leur",71.16,71.38],["empire",71.46,71.78],["s'effondre",71.86,72.28],["leurs",72.32,72.5],["couronnes",72.54,72.94],["sont",73,73.18],["en",73.22,73.36],["plastique",73.4,74.1]],"ok":1.0},{"text":"Moi j'ai déposé mes plaies sur une pierre biblique.","t":74.36,"e":77.78,"w":[["Moi",74.36,74.48],["j'ai",74.52,74.72],["déposé",74.78,75.38],["mes",75.44,75.62],["plaies",75.7,76.08],["sur",76.16,76.34],["une",76.38,76.52],["pierre",76.58,77],["biblique",77.06,77.78]],"ok":1.0},{"text":"Quand la terre tremble sous le poids de leurs mensonges,","t":78.14,"e":81.66,"w":[["Quand",78.14,78.52],["la",78.6,78.72],["terre",78.84,79.18],["tremble",79.22,79.66],["sous",79.74,79.86],["le",79.92,80.04],["poids",80.16,80.34],["de",80.4,80.52],["leurs",80.58,80.78],["mensonges",80.82,81.66]],"ok":1.0},{"text":"Je ne cherche plus secours dans ce monde qui me ronge.","t":81.76,"e":85.58,"w":[["Je",81.76,81.9],["ne",81.96,82.06],["cherche",82.14,82.38],["plus",82.4,82.54],["secours",82.62,83.22],["dans",83.3,83.44],["ce",83.52,83.68],["monde",83.76,84.12],["qui",84.2,84.36],["me",84.42,84.54],["ronge",84.74,85.58]],"ok":1.0},{"text":"Foi en Christ, foi en Christ","t":86.42,"e":88.46,"w":[["Foi",86.42,86.6],["en",86.68,86.8],["Christ",86.84,87.18],["foi",87.72,87.86],["en",88.02,88.1],["Christ",88.16,88.46]],"ok":1.0},{"text":"Même brisé, je tiens la liste","t":88.64,"e":90.2,"w":[["Même",88.64,88.82],["brisé",88.84,89.24],["je",89.32,89.46],["tiens",89.52,89.72],["la",89.78,89.9],["liste",89.94,90.2]],"ok":1.0},{"text":"Foi en Christ, foi en Christ","t":90.24,"e":91.92,"w":[["Foi",90.24,90.28],["en",90.28,90.4],["Christ",90.42,91.32],["foi",91.34,91.5],["en",91.62,91.68],["Christ",91.74,91.92]],"ok":1.0},{"text":"Tes trahisons, j’les laisse ici","t":91.98,"e":93.66,"w":[["Tes",91.98,92.14],["trahisons",92.2,92.82],["j’les",92.92,93.06],["laisse",93.12,93.36],["ici",93.46,93.66]],"ok":1.0},{"text":"Foi en Christ, foi en Christ","t":93.68,"e":94.4,"w":[["Foi",93.68,93.8],["en",93.86,93.96],["Christ",94,94.3],["foi",94.34,94.34],["en",94.34,94.34],["Christ",94.34,94.4]],"ok":1.0},{"text":"L’État vole, mais Dieu me voit","t":95.58,"e":97.4,"w":[["L’État",95.58,95.98],["vole",96.06,96.4],["mais",96.48,96.64],["Dieu",96.7,96.86],["me",96.92,97.06],["voit",97.1,97.4]],"ok":1.0},{"text":"Foi en Christ, foi en Christ","t":98.68,"e":105.28,"w":[["Foi",98.68,98.88],["en",99.96,100.16],["Christ",101.24,101.44],["foi",102.52,102.72],["en",103.8,104.0],["Christ",105.08,105.28]],"ok":0.0},{"text":"Mon âme saigne, elle plie pas","t":106.36,"e":108.5,"w":[["Mon",106.36,106.58],["âme",106.7,106.92],["saigne",107.04,107.38],["elle",107.46,107.62],["plie",107.68,107.92],["pas",108.06,108.5]],"ok":1.0},{"text":"Ils ont construit Babel avec l'or de nos larmes,","t":114.06,"e":117.2,"w":[["Ils",114.06,114.18],["ont",114.2,114.32],["construit",114.38,114.78],["Babel",114.84,115.52],["avec",115.64,115.92],["l'or",116,116.24],["de",116.28,116.36],["nos",116.42,116.58],["larmes",116.64,117.2]],"ok":1.0},{"text":"Transformé la vérité en une marchandise sans charme.","t":117.28,"e":120.66,"w":[["Transformé",117.28,117.92],["la",117.98,118.12],["vérité",118.2,118.82],["en",118.88,118.96],["une",119,119.08],["marchandise",119.12,119.96],["sans",119.98,120.12],["charme",120.18,120.66]],"ok":1.0},{"text":"César exige son impôt même sur nos respirations,","t":120.88,"e":123.96,"w":[["César",120.88,121.34],["exige",121.4,121.76],["son",121.82,122],["impôt",122.08,122.4],["même",122.46,122.64],["sur",122.7,122.86],["nos",122.9,123.08],["respirations",123.14,123.96]],"ok":1.0},{"text":"Il vend du pain et des jeux pour masquer la malédiction.","t":124.32,"e":127.56,"w":[["Il",124.32,124.44],["vend",124.48,124.64],["du",124.7,124.86],["pain",124.94,125.2],["et",125.26,125.32],["des",125.4,125.52],