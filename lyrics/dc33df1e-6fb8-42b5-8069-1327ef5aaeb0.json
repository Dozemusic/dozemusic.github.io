{"v":1,"src":"scribe+alignement","coverage":0.966,"lines":[{"text":"C-L-B à la prod…","t":4.24,"e":5.38,"w":[["C-L-B",4.24,4.74],["à",4.78,4.82],["la",4.86,4.94],["prod",5,5.38]],"ok":1.0},{"text":"Mmh… oh-oh…","t":9.69,"e":14.21,"w":[["Mmh",9.69,9.89],["oh-oh",14.01,14.21]],"ok":0.0},{"text":"Tu m'as dit « bébé, y'a que toi »","t":18.32,"e":19.84,"w":[["Tu",18.32,18.4],["m'as",18.48,18.62],["dit",18.66,18.8],["bébé",18.86,19.16],["y'a",19.28,19.32],["que",19.36,19.5],["toi",19.56,19.84]],"ok":1.0},{"text":"Le même soir, ton téléphone vibrait sous les draps","t":20.12,"e":22.78,"w":[["Le",20.12,20.24],["même",20.32,20.56],["soir",20.62,20.76],["ton",20.82,20.94],["téléphone",21.02,21.52],["vibrait",21.56,21.86],["sous",21.92,22.06],["les",22.12,22.36],["draps",22.42,22.78]],"ok":1.0},{"text":"J'ai fait semblant d'dormir, j'ai compté jusqu'à trois","t":22.98,"e":25.6,"w":[["J'ai",22.98,23.12],["fait",23.16,23.28],["semblant",23.49,23.69],["d'dormir",23.7,24.18],["j'ai",24.26,24.38],["compté",24.44,24.72],["jusqu'à",24.78,25.26],["trois",25.32,25.6]],"ok":0.88},{"text":"Mon cœur savait déjà, mais il t'aimait comme ça","t":25.9,"e":28.48,"w":[["Mon",25.9,26.02],["cœur",26.06,26.2],["savait",26.24,26.56],["déjà",26.6,26.92],["mais",27,27.12],["il",27.18,27.26],["t'aimait",27.34,27.82],["comme",27.92,28.18],["ça",28.3,28.48]],"ok":1.0},{"text":"Je t'ai donné mes nuits, mes prières et ma foi","t":28.78,"e":31.44,"w":[["Je",28.78,28.86],["t'ai",28.94,29.08],["donné",29.14,29.42],["mes",29.48,29.6],["nuits",29.66,29.82],["mes",29.86,30],["prières",30.04,30.46],["et",30.5,30.7],["ma",30.82,31.06],["foi",31.14,31.44]],"ok":1.0},{"text":"Toi tu m'as donné des « promis, c'est la dernière fois »","t":31.5,"e":34.32,"w":[["Toi",31.5,31.58],["tu",31.66,31.78],["m'as",31.86,31.98],["donné",32.04,32.34],["des",32.38,32.52],["promis",32.58,32.88],["c'est",32.94,33.06],["la",33.12,33.24],["dernière",33.32,33.94],["fois",34.04,34.32]],"ok":1.0},{"text":"J'ai pleuré sous la douche, pour qu'on m'entende pas","t":34.54,"e":37.18,"w":[["J'ai",34.54,34.7],["pleuré",34.74,35.04],["sous",35.12,35.22],["la",35.28,35.42],["douche",35.48,35.8],["pour",35.84,35.94],["qu'on",35.98,36.14],["m'entende",36.22,36.88],["pas",36.94,37.18]],"ok":1.0},{"text":"Maman m'a dit « ma fille, l'amour se mendie pas »","t":37.48,"e":40,"w":[["Maman",37.48,37.76],["m'a",37.8,37.96],["dit",38,38.1],["ma",38.16,38.28],["fille",38.36,38.5],["l'amour",38.56,38.82],["se",38.88,39],["mendie",39.1,39.74],["pas",39.82,40]],"ok":1.0},{"text":"Et j'ai attendu, attendu, attendu","t":40.02,"e":42.52,"w":[["Et",40.02,40.12],["j'ai",40.16,40.3],["attendu",40.42,41.08],["attendu",41.28,41.76],["attendu",41.88,42.52]],"ok":1.0},{"text":"Que revienne l'homme que j'ai connu","t":43.44,"e":45.6,"w":[["Que",43.44,43.76],["revienne",43.8,44.24],["l'homme",44.32,44.48],["que",44.52,44.62],["j'ai",44.66,44.84],["connu",44.9,45.6]],"ok":1.0},{"text":"Mais cet homme-là n'existe plus…","t":46.34,"e":48.46,"w":[["Mais",46.34,46.6],["cet",46.66,46.86],["homme-là",46.88,47.34],["n'existe",47.38,48.02],["plus",48.12,48.46]],"ok":1.0},{"text":"Plus jamais d'goumin, c'est terminé (oh-oh)","t":51.7,"e":54.81,"w":[["Plus",51.7,51.84],["jamais",51.92,52.2],["d'goumin",52.22,52.76],["c'est",53.18,53.3],["terminé",53.38,54.24],["oh-oh",54.61,54.81]],"ok":0.83},{"text":"J'ai fermé mon cœur à clé","t":54.98,"e":57.12,"w":[["J'ai",54.98,55.24],["fermé",55.34,55.86],["mon",55.92,56.16],["cœur",56.24,56.58],["à",56.64,56.72],["clé",56.78,57.12]],"ok":1.0},{"text":"Tu peux pleurer, tu peux prier","t":57.52,"e":60.02,"w":[["Tu",57.52,57.62],["peux",57.72,57.96],["pleurer",58.02,58.52],["tu",58.96,59.08],["peux",59.14,59.38],["prier",59.44,60.02]],"ok":1.0},{"text":"Plus jamais d'goumin, chéri, c'est terminé","t":60.58,"e":64.36,"w":[["Plus",60.58,60.74],["jamais",60.8,61.32],["d'goumin",61.38,61.9],["chéri",62,62.86],["c'est",63.3,63.44],["terminé",63.52,64.36]],"ok":1.0},{"text":"Aujourd'hui j'me maquille, mais plus pour cacher mes yeux","t":75.12,"e":77.74,"w":[["Aujourd'hui",75.12,75.5],["j'me",75.54,75.7],["maquille",75.78,76.12],["mais",76.16,76.28],["plus",76.32,76.46],["pour",76.5,76.62],["cacher",76.68,76.96],["mes",77.02,77.4],["yeux",77.44,77.74]],"ok":1.0},{"text":"J'ai remis ma robe rouge, je souris, je vais mieux","t":77.94,"e":80.58,"w":[["J'ai",77.94,78.08],["remis",78.14,78.44],["ma",78.5,78.62],["robe",78.66,78.84],["rouge",78.84,79],["je",79.04,79.12],["souris",79.2,79.52],["je",79.76,79.88],["vais",79.94,80.22],["mieux",80.28,80.58]],"ok":1.0},{"text":"Mes copines m'ont dit « laisse, il sait pas ce qu'il veut »","t":80.86,"e":83.5,"w":[["Mes",80.86,80.96],["copines",81.02,81.36],["m'ont",81.38,81.52],["dit",81.56,81.68],["laisse",81.72,82.02],["il",82.08,82.08],["sait",82.08,82.24],["pas",82.3,82.56],["ce",82.62,82.76],["qu'il",82.8,83.12],["veut",83.18,83.5]],"ok":1.0},{"text":"Elles avaient raison, j'ai rallumé mon feu","t":83.94,"e":86.36,"w":[["Elles",83.94,84.08],["avaient",84.12,84.4],["raison",84.46,84.74],["j'ai",84.8,84.94],["rallumé",85,85.64],["mon",85.7,86],["feu",86.08,86.36]],"ok":1.0},{"text":"Tu postes des statuts, tu joues les malheureux","t":86.42,"e":89.26,"w":[["Tu",86.42,86.54],["postes",86.64,86.92],["des",86.96,87.06],["statuts",87.12,87.46],["tu",87.7,87.84],["joues",87.88,88.04],["les",88.08,88.2],["malheureux",88.44,89.26]],"ok":1.0},{"text":"Mais c'est toi qui trichais quand on était deux","t":89.34,"e":92.18,"w":[["Mais",89.34,89.44],["c'est",89.5,89.66],["toi",89.86,90.02],["qui",90.08,90.32],["trichais",90.38,90.72],["quand",90.78,90.92],["on",91.02,91.3],["était",91.4,91.8],["deux",91.9,92.18]],"ok":1.0},{"text":"Les gens parlent, les gens jugent, c'est pas mon enjeu","t":92.24,"e":95.02,"w":[["Les",92.24,92.36],["gens",92.4,92.56],["parlent",92.78,92.96],["les",92.98,93.08],["gens",93.12,93.28],["jugent",93.36,93.64],["c'est",93.68,93.82],["pas",93.88,94.02],["mon",94.24,94.36],["enjeu",94.44,95.02]],"ok":1.0},{"text":"Moi j'ai fini d'jouer à tes jeux dangereux","t":95.1,"e":97.8,"w":[["Moi",95.1,95.22],["j'ai",95.26,95.42],["fini",95.68,96],["d'jouer",96.04,96.54],["à",96.62,96.7],["tes",96.76,97.02],["jeux",97.1,97.22],["dangereux",97.3,97.8]],"ok":1.0},{"text":"Et j'ai attendu, attendu, attendu","t":97.96,"e":100.38,"w":[["Et",97.96,97.96],["j'ai",98,98.18],["attendu",98.28,99.04],["attendu",99.2,99.6],["attendu",99.74,100.38]],"ok":1.0},{"text":"Que revienne l'homme que j'ai connu","t":101.28,"e":103.42,"w":[["Que",101.28,101.56],["revienne",101.62,102.04],["l'homme",102.06,102.32],["que",102.36,102.48],["j'ai",102.5,102.68],["connu",102.74,103.42]],"ok":1.0},{"text":"Mais cet homme-là n'existe plus…","t":104.18,"e":106.32,"w":[["Mais",104.18,104.42],["cet",104.5,104.7],["homme-là",104.74,105.18],["n'existe",105.22,105.9],["plus",105.96,106.32]],"ok":1.0},{"text":"Plus jamais d'goumin, c'est terminé (oh-oh)","t":109.6,"e":112.64,"w":[["Plus",109.6,109.7],["jamais",109.78,110.06],["d'goumin",110.08,110.58],["c'est",111.02,111.14],["terminé",111.22,112.08],["oh-oh",112.44,112.64]],"ok":0.83},{"text":"J'ai fermé mon cœur à clé","t":112.8,"e":114.96,"w":[["J'ai",112.8,113.12],["fermé",113.22,113.72],["mon",113.8,114.04],["cœur",114.12,114.44],["à",114.52,114.58],["clé",114.66,114.96]],"ok":1.0},{"text":"Tu peux pleurer, tu peux prier","t":115.34,"e":117.88,"w":[["Tu",115.34,115.48],["peux",115.52,115.82],["pleurer",115.88,116.4],["tu",116.82,116.92],["peux",117.02,117.24],["prier",117.28,117.88]],"ok":1.0},{"text":"Plus jamais d'goumin, chéri, c'est terminé","t":118.44,"e":122.2,"w":[["Plus",118.44,118.58],["jamais",118.66,119.18],["d'goumin",119.22,119.74],["chéri",119.84,120.74],["c'est",121.14,121.28],["terminé",121.36,122.2]],"ok":1.0},{"text":"Si un jour tu comprends ce que t'as gâché","t":122.78,"e":124.98,"w":[["Si",122.78,122.96],["un",123.02,123.1],["jour",123.16,123.26],["tu",123.32,123.44],["comprends",123.48,123.82],["ce",123.88,123.98],["que",124.04,124.16],["t'as",124.22,124.3