{"v":1,"src":"scribe+alignement","coverage":0.969,"lines":[{"text":"(Mmh) Malgré le temps, le cœur est vide... nostalgie...","t":5.68,"e":11.64,"w":[["Mmh",5.68,5.88],["Malgré",5.98,6.26],["le",6.32,6.4],["temps",6.5,6.7],["le",6.74,6.84],["cœur",6.92,7.12],["est",7.14,7.26],["vide",7.34,8.04],["nostalgie",10.34,11.64]],"ok":0.89},{"text":"(Han, han) ah-ah, mmh","t":11.89,"e":12.82,"w":[["Han",11.89,12.09],["han",12.14,12.34],["ah-ah",12.39,12.59],["mmh",12.64,12.82]],"ok":0.25},{"text":"Ouh-woah-ah, ouh-woah-ah-ah","t":20,"e":31.76,"w":[["Ouh-woah-ah",20,20.7],["ouh-woah-ah-ah",31.56,31.76]],"ok":0.5},{"text":"J'suis dans la zone, j'vois les doutes qui dansent","t":42.42,"e":44.26,"w":[["J'suis",42.42,42.58],["dans",42.62,42.74],["la",42.78,42.88],["zone",42.92,43.06],["j'vois",43.08,43.22],["les",43.26,43.36],["doutes",43.42,43.64],["qui",43.68,43.82],["dansent",43.88,44.26]],"ok":1.0},{"text":"J'cache ma peine sous un sourire gênant","t":45.96,"e":47.6,"w":[["J'cache",45.96,46.2],["ma",46.24,46.34],["peine",46.36,46.5],["sous",46.54,46.66],["un",46.7,46.78],["sourire",46.84,47.22],["gênant",47.28,47.6]],"ok":1.0},{"text":"La vie m'endurcit, j'perds toute ma confiance","t":49.24,"e":51.5,"w":[["La",49.24,49.32],["vie",49.36,49.48],["m'endurcit",49.52,49.98],["j'perds",50.02,50.38],["toute",50.42,50.6],["ma",50.64,50.78],["confiance",50.84,51.5]],"ok":1.0},{"text":"Depuis qu'tu pars, j'ressens chaque manquement.","t":53.1,"e":55,"w":[["Depuis",53.1,53.34],["qu'tu",53.34,53.5],["pars",53.58,53.7],["j'ressens",53.74,54.08],["chaque",54.14,54.42],["manquement",54.48,55]],"ok":1.0},{"text":"Mélancolie pure injectée dans mes veines","t":56.22,"e":57.98,"w":[["Mélancolie",56.22,56.78],["pure",56.84,57],["injectée",57.02,57.38],["dans",57.42,57.52],["mes",57.58,57.68],["veines",57.74,57.98]],"ok":1.0},{"text":"T'étais ma force mais t'es devenue ma peine","t":58.18,"e":59.76,"w":[["T'étais",58.18,58.42],["ma",58.46,58.56],["force",58.6,58.74],["mais",58.78,58.88],["t'es",58.9,59.02],["devenue",59.06,59.32],["ma",59.36,59.46],["peine",59.54,59.76]],"ok":1.0},{"text":"Je marche la nuit pour oublier ma peine","t":59.94,"e":61.58,"w":[["Je",59.94,60.04],["marche",60.1,60.24],["la",60.28,60.34],["nuit",60.4,60.52],["pour",60.56,60.7],["oublier",60.72,61.1],["ma",61.16,61.26],["peine",61.36,61.58]],"ok":1.0},{"text":"T'es ma reine, mais l'amour nous enchaîne.","t":61.92,"e":63.84,"w":[["T'es",61.92,62.02],["ma",62.08,62.2],["reine",62.26,62.46],["mais",62.84,62.92],["l'amour",62.96,63.22],["nous",63.28,63.4],["enchaîne",63.46,63.84]],"ok":1.0},{"text":"On s'aime à mort, on se déchire en guerre","t":64,"e":65.6,"w":[["On",64,64.08],["s'aime",64.14,64.3],["à",64.34,64.4],["mort",64.46,64.58],["on",64.62,64.68],["se",64.74,64.82],["déchire",64.88,65.18],["en",65.22,65.32],["guerre",65.36,65.6]],"ok":1.0},{"text":"J'vide mon verre, les yeux collés à l'terre","t":65.7,"e":67.36,"w":[["J'vide",65.7,65.94],["mon",66,66.16],["verre",66.2,66.36],["les",66.4,66.52],["yeux",66.54,66.62],["collés",66.7,66.94],["à",66.98,67.18],["l'terre",67.02,67.36]],"ok":0.88},{"text":"J'veux ton bonheur mais j'suis dans l'impasse","t":67.52,"e":69.2,"w":[["J'veux",67.52,67.7],["ton",67.74,67.84],["bonheur",67.88,68.24],["mais",68.32,68.4],["j'suis",68.42,68.58],["dans",68.62,68.72],["l'impasse",68.76,69.2]],"ok":1.0},{"text":"Dis-moi comment faire, dis-moi que ça passe.","t":69.24,"e":71.12,"w":[["Dis-moi",69.24,69.48],["comment",69.54,69.82],["faire",69.88,70.08],["dis-moi",70.12,70.36],["que",70.4,70.5],["ça",70.58,70.66],["passe",70.8,71.12]],"ok":1.0},{"text":"On s'aime sous la pluie, on danse sous l'orage","t":72.74,"e":76.04,"w":[["On",72.74,72.84],["s'aime",72.96,73.32],["sous",73.4,73.52],["la",73.58,73.76],["pluie",73.88,74.44],["on",74.54,74.66],["danse",74.76,75.06],["sous",75.18,75.34],["l'orage",75.38,76.04]],"ok":1.0},{"text":"Notre amour est fou, perdu dans son mirage","t":76.3,"e":79.82,"w":[["Notre",76.3,76.58],["amour",76.78,77.18],["est",77.2,77.34],["fou",77.48,77.7],["perdu",78.08,78.46],["dans",78.52,78.68],["son",78.76,78.92],["mirage",79,79.82]],"ok":1.0},{"text":"Y a de la joie, des larmes sur le visage","t":83.9,"e":87.16,"w":[["Y",83.9,83.94],["a",84,84.06],["de",84.14,84.26],["la",84.34,84.48],["joie",84.58,85.14],["des",85.24,85.4],["larmes",85.46,85.64],["sur",85.72,85.88],["le",85.94,86.08],["visage",86.14,87.16]],"ok":1.0},{"text":"Sans toi la nuit me sert de paysage !","t":88.36,"e":90.98,"w":[["Sans",88.36,88.54],["toi",88.6,88.74],["la",88.82,88.94],["nuit",89.04,89.24],["me",89.3,89.4],["sert",89.52,89.7],["de",89.76,89.86],["paysage",89.96,90.98]],"ok":1.0},{"text":"C'est de l'amour, des pleurs et des rimes","t":92.62,"e":94.52,"w":[["C'est",92.62,92.74],["de",92.78,92.86],["l'amour",92.9,93.32],["des",93.36,93.48],["pleurs",93.52,93.7],["et",93.74,93.8],["des",93.84,93.94],["rimes",94.02,94.52]],"ok":1.0},{"text":"On soigne nos cœurs au bord de l'abîme","t":96.04,"e":98.1,"w":[["On",96.04,96.1],["soigne",96.16,96.38],["nos",96.42,96.56],["cœurs",96.64,96.96],["au",96.98,97.04],["bord",97.1,97.24],["de",97.28,97.36],["l'abîme",97.4,98.1]],"ok":1.0},{"text":"Un jour on s'adore, le lendemain on s'abîme","t":99.68,"e":101.7,"w":[["Un",99.68,99.74],["jour",99.78,99.92],["on",99.96,100.02],["s'adore",100.08,100.36],["le",100.4,100.46],["lendemain",100.52,100.9],["on",100.9,100.9],["s'abîme",100.98,101.7]],"ok":1.0},{"text":"Mais ton regard reste mon seul crime.","t":103.2,"e":105.12,"w":[["Mais",103.2,103.3],["ton",103.38,103.52],["regard",103.56,104.18],["reste",104.24,104.4],["mon",104.44,104.54],["seul",104.6,104.78],["crime",104.84,105.12]],"ok":1.0},{"text":"Moi je t'ai donné mon âme et mon temps","t":107.42,"e":109.86,"w":[["Moi",107.42,108.38],["je",108.4,108.6],["t'ai",108.42,108.7],["donné",108.76,108.98],["mon",109.04,109.18],["âme",109.24,109.34],["et",109.38,109.44],["mon",109.48,109.58],["temps",109.66,109.86]],"ok":0.89},{"text":"Pendant que tu fuyais tes propres tourments","t":110.1,"e":111.66,"w":[["Pendant",110.1,110.32],["que",110.32,110.52],["tu",110.32,110.48],["fuyais",110.54,110.78],["tes",110.82,110.94],["propres",110.98,111.24],["tourments",111.3,111.66]],"ok":0.86},{"text":"Tu joues les fiers, les grands, les importants","t":111.88,"e":113.62,"w":[["Tu",111.88,111.98],["joues",112.02,112.14],["les",112.18,112.28],["fiers",112.32,112.46],["les",112.5,112.58],["grands",112.62,112.76],["les",112.8,112.92],["importants",112.98,113.62]],"ok":1.0},{"text":"Mais dans mes bras, tu redeviens enfant.","t":113.66,"e":115.26,"w":[["Mais",113.66,113.78],["dans",113.82,113.92],["mes",113.96,114.06],["bras",114.1,114.24],["tu",114.28,114.38],["redeviens",114.44,114.88],["enfant",114.92,115.26]],"ok":1.0},{"text":"La tristesse me ronge quand tu deviens froid","t":115.32,"e":117.1,"w":[["La",115.32,115.4],["tristesse",115.44,115.76],["me",115.78,115.82],["ronge",115.9,116.04],["quand",116.08,116.18],["tu",116.22,116.32],["deviens",116.38,116.72],["froid",116.8,117.1]],"ok":1.0},{"text":"Je perds ma flamme quand je doute de toi","t":117.24,"e":118.88,"w":[["Je",117.24,117.36],["perds",117.4,117.52],["ma",117.56,117.64],["flamme",117.7,117.86],["quand",117.88,117.98],["je",118.04,118.1],["doute",118.16,118.3],["de",118.36,118.5],["toi",118.58,118.88]],"ok":1.0},{"text":"Viens on efface nos blessures et nos choix","t":119.06,"e":120.78,"w":[["Viens",119.06,119.2],["on",119.26,119.34],["efface",119.4,119.62],["nos",119.64,119.74],["blessures",119.76,120.08],["et",120.12,120.18],["nos",120.22,120.34],["choix",120.4,120.78]],"ok":1.0},{"text":"L'Afrobeat résonne, fait vibrer le toit.","t":121.01,"e":122.48,"w":[["L'Afrobeat",121.01,121.21],["résonne",121.24,121.56],["fait",121.6,121.7],["vibrer",121.74,122],["le",122.04,122.12],["toit",122.2,122.48]],"ok":0.83},{"text":"Je veux briller à tes côtés","t":122.62,"e":124,"w":[["Je",122.62,122.74],["veux",122.78,122.88],["briller",122.94,123.2],["à",123.28,123.32],["tes",123.38,123.48],["côtés",123.54,124]],"ok":1.0},{"text":"Pas seulement pleurer nos vérités","t":124.26,"e":125.84,"w":[["Pas",124.26,124.34],["seulement",124.4,124.66],["pleurer",124.7,124.96],["nos",125,125.12],["vérités",125.16,125.84]],"ok":1.0},{"text":"Regarde-moi, j'ai plus peur de tomber","t":126.06,"e":127.64,"w":[["Regarde-moi",126.06,126.44],["j'ai",126.46,126.6],["plus",126.64,126.76],["peur",126.8,126.92],["de",126.96,127.06],["tomber",127.14,127.64]],"ok":1.0},{"text":"Si c'est dans tes bras que je dois sombrer.","t":127.7,"e":129.62,"w":[["Si",127.7,127.78],["c'est",127.84,127.94],["dans",128,128.1],["tes",128.14,128.24],["bras",128.28,128.4],["que",128.44,128.52],["je",128.58,128.66],["dois",128.7,128.84],["sombrer",128.94,129.62]],"ok":1.0},{"text":"On s'aime sous la pluie, on danse sous l'orage","t":130.02,"e":133.34,"w":[["On",130.02,130.14],["s'aime",130.24,130.56],["sous",130.68,130.82],["la",130.9,131.06],["pluie",131.14,131.62],["on",131.82,131.96],["danse",132.04,132.34],["sous",132.48,132.62],["l'orage",132.66,133.34]],"ok":1.0},{"text":"Notre amour est fou, coincé dans sa cage","t":133.6,"e":139.02,"w":[["Notre",133.6,133.9],["amour",134.1,134.46],["est",134.5,134.64],["fou",134.78,134.98],["coincé",135.6,136],["dans",136.06,136.2],["sa",136.28,136.44],["cage",138.4,139.02]],"ok":1.0},{"text":"Y a de la joie, des larmes sur le visage","t":141.2,"e":144.38,"w":[["Y",141.2,141.22],["a",141.28,141.36],["de",141.44,141.56],["la",141.64,141.78],["joie",141.88,142.46],["des",142.56,142.68],["larmes",142.76,142.94],["sur",143.02,143.18],["le",143.22,143.36],["visage",143.42,144.38]],"ok":1.0},{"text":"Mais sans toi, mon ciel devient nuage.","t":145.64,"e":148.52,"w":[["Mais",145.64,145.8],["sans",145.92,146.22],["toi",146.32,146.48],["mon",146.6,146.72],["ciel",146.8,147],["devient",147.06,147.48],["nuage",147.54,148.52]],"ok":1.0},{"text":"C'est de l'amour, des pleurs et des rimes","t":149.94,"e":151.88,"w":[["C'est",149.94,150.04],["de",150.1,150.18],["l'amour",150.22,150.6],["des",1