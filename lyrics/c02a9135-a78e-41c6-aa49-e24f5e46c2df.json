h-woah-ah-ah","t":216.7,"e":221.26,"w":[["Ouh-woah-ah",216.7,217.02],["ouh-woah-ah-ah",221.06,221.26]],"ok":0.5},{"text":"(Mmh, han, han) nostalgie…","t":225.1,"e":233.6,"w":[["Mmh",225.1,225.12],["han",227.51,227.71],["han",229.91,230.11],["nostalgie",232.3,233.6]],"ok":0.5}]}