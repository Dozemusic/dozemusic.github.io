{"v":1,"src":"scribe+alignement","coverage":0.886,"lines":[{"text":"Oh-oh-oh...","t":37.3,"e":37.5,"w":[["Oh-oh-oh",37.3,37.5]],"ok":0.0},{"text":"Hooo hooo hooo yaweh oww","t":37.6,"e":40.29,"w":[["Hooo",37.6,37.8],["hooo",37.9,38.1],["hooo",38.2,38.4],["yaweh",38.5,38.9],["oww",40.09,40.29]],"ok":0.2},{"text":"My brother, why you dey worry your head?","t":41.28,"e":43.48,"w":[["My",41.28,41.38],["brother",41.44,41.74],["why",42.06,42.2],["you",42.26,42.38],["dey",42.44,42.58],["worry",42.64,43.02],["your",43.08,43.18],["head",43.24,43.48]],"ok":1.0},{"text":"Carry your cross, no look wetin dem said","t":43.84,"e":45.84,"w":[["Carry",43.84,44.16],["your",44.22,44.34],["cross",44.4,44.58],["no",44.64,44.74],["look",44.8,44.98],["wetin",45.02,45.34],["dem",45.48,45.68],["said",45.62,45.84]],"ok":0.88},{"text":"Sometimes the road e dey dark and long","t":46.16,"e":48.14,"w":[["Sometimes",46.16,46.54],["the",46.6,46.7],["road",46.76,47],["e",47.02,47.1],["dey",47.16,47.3],["dark",47.36,47.6],["and",47.66,47.84],["long",47.94,48.14]],"ok":1.0},{"text":"But my God na Him dey write the song","t":48.34,"e":50.58,"w":[["But",48.34,48.46],["my",48.54,48.7],["God",48.78,49.02],["na",49.12,49.28],["Him",49.3,49.48],["dey",49.52,49.68],["write",49.72,50.04],["the",50.1,50.22],["song",50.34,50.58]],"ok":1.0},{"text":"Grace na the shoe wey dey fit your feet","t":50.86,"e":52.92,"w":[["Grace",50.86,51.08],["na",51.12,51.24],["the",51.3,51.4],["shoe",51.48,51.68],["wey",51.72,51.84],["dey",51.88,52.02],["fit",52.08,52.28],["your",52.34,52.56],["feet",52.66,52.92]],"ok":1.0},{"text":"No cap, my God no dey fail on street!","t":53.04,"e":55.34,"w":[["No",53.04,53.16],["cap",53.26,53.46],["my",53.5,53.78],["God",53.84,54.02],["no",54.06,54.2],["dey",54.24,54.38],["fail",54.46,54.68],["on",54.72,54.84],["street",54.96,55.34]],"ok":1.0},{"text":"Quand les ombres recouvrent le chemin,","t":55.82,"e":57.92,"w":[["Quand",55.82,55.98],["les",56.02,56.22],["ombres",56.26,56.58],["recouvrent",56.64,57.16],["le",57.22,57.34],["chemin",57.4,57.92]],"ok":1.0},{"text":"Je m'abandonne entre tes mains.","t":58.4,"e":60.14,"w":[["Je",58.4,58.5],["m'abandonne",58.58,59.2],["entre",59.24,59.5],["tes",59.58,59.7],["mains",59.8,60.14]],"ok":1.0},{"text":"Tu essuies chaque larme de mes yeux,","t":60.58,"e":62.46,"w":[["Tu",60.58,60.72],["essuies",60.78,61.08],["chaque",61.12,61.36],["larme",61.54,61.74],["de",61.78,61.88],["mes",61.94,62.18],["yeux",62.2,62.46]],"ok":1.0},{"text":"Ton amour me ramène dans les cieux.","t":62.94,"e":64.86,"w":[["Ton",62.94,63.12],["amour",63.16,63.48],["me",63.54,63.64],["ramène",63.7,64.08],["dans",64.12,64.24],["les",64.28,64.42],["cieux",64.52,64.86]],"ok":1.0},{"text":"Ta présence est un feu dans ma nuit,","t":65.3,"e":67,"w":[["Ta",65.3,65.42],["présence",65.48,65.9],["est",65.94,66.08],["un",66.14,66.26],["feu",66.3,66.44],["dans",66.48,66.64],["ma",66.68,66.8],["nuit",66.86,67]],"ok":1.0},{"text":"C'est ta grâce qui me fait vivre aujourd'hui.","t":67.44,"e":69.42,"w":[["C'est",67.44,67.6],["ta",67.66,67.8],["grâce",67.82,68.06],["qui",68.1,68.18],["me",68.24,68.36],["fait",68.44,68.6],["vivre",68.66,68.84],["aujourd'hui",68.88,69.42]],"ok":1.0},{"text":"Même si le vent souffle contre ma barque,","t":69.8,"e":71.9,"w":[["Même",69.8,69.96],["si",70.02,70.14],["le",70.2,70.32],["vent",70.38,70.54],["souffle",70.62,70.92],["contre",71,71.32],["ma",71.38,71.52],["barque",71.84,71.9]],"ok":1.0},{"text":"Ton regard d'amour sur mon cœur s'embarque.","t":72,"e":74.28,"w":[["Ton",72,72.14],["regard",72.18,72.54],["d'amour",72.58,72.92],["sur",73,73.14],["mon",73.2,73.36],["cœur",73.42,73.64],["s'embarque",73.72,74.28]],"ok":1.0},{"text":"Tu dissipes le doute et la peur,","t":74.36,"e":76.6,"w":[["Tu",74.36,74.48],["dissipes",74.56,75.48],["le",75.54,75.68],["doute",75.76,75.96],["et",76,76.08],["la",76.14,76.26],["peur",76.34,76.6]],"ok":1.0},{"text":"Pour planter ta paix au fond de mon cœur.","t":76.72,"e":78.86,"w":[["Pour",76.72,76.86],["planter",76.9,77.24],["ta",77.3,77.46],["paix",77.54,77.7],["au",77.76,77.86],["fond",77.94,78.14],["de",78.2,78.3],["mon",78.38,78.58],["cœur",78.68,78.86]],"ok":1.0},{"text":"Oya make everybody dance and sing!","t":78.94,"e":81.26,"w":[["Oya",78.94,79.2],["make",79.28,79.5],["everybody",79.6,80.24],["dance",80.32,80.72],["and",80.78,80.96],["sing",81.08,81.26]],"ok":1.0},{"text":"Because our God na the greatest king!","t":81.48,"e":83.62,"w":[["Because",81.48,81.88],["our",81.92,82.2],["God",82.26,82.44],["na",82.5,82.62],["the",82.66,82.78],["greatest",82.84,83.34],["king",83.44,83.62]],"ok":1.0},{"text":"No more sorrow, no more pain inside!","t":83.68,"e":86.12,"w":[["No",83.68,83.78],["more",83.84,83.96],["sorrow",84.04,84.54],["no",84.64,84.78],["more",84.84,85],["pain",85.08,85.48],["inside",85.56,86.12]],"ok":1.0},{"text":"With Jesus Christ, we go dey ride!","t":86.22,"e":88.68,"w":[["With",86.22,86.34],["Jesus",86.42,86.84],["Christ",86.92,87.32],["we",87.4,87.52],["go",87.58,87.74],["dey",87.8,88.06],["ride",88.16,88.68]],"ok":1.0},{"text":"Bouge tes pas, tape les mains!","t":88.74,"e":90.66,"w":[["Bouge",88.74,88.92],["tes",88.98,89.24],["pas",89.32,89.52],["tape",89.92,90.16],["les",90.18,90.44],["mains",90.52,90.66]],"ok":1.0},{"text":"La joie descend dans les chemins!","t":90.92,"e":93.04,"w":[["La",90.92,91.04],["joie",91.1,91.3],["descend",91.36,92.06],["dans",92.12,92.24],["les",92.3,92.46],["chemins",92.54,93.04]],"ok":1.0},{"text":"Tourne à gauche, saute à droite!","t":93.48,"e":95.54,"w":[["Tourne",93.48,93.72],["à",93.82,93.96],["gauche",94.06,94.36],["saute",94.64,94.9],["à",95.12,95.14],["droite",95.2,95.54]],"ok":1.0},{"text":"Sa lumière sur nous se pointe!","t":95.82,"e":98.1,"w":[["Sa",95.82,96.02],["lumière",96.08,96.76],["sur",96.86,97],["nous",97.06,97.26],["se",97.28,97.48],["pointe",97.6,98.1]],"ok":1.0},{"text":"Danse, danse, loue ton Roi!","t":98.2,"e":100.12,"w":[["Danse",98.2,98.72],["danse",98.8,99.3],["loue",99.38,99.54],["ton",99.62,99.88],["Roi",99.94,100.12]],"ok":1.0},{"text":"Sa victoire est avec toi!","t":100.56,"e":102.54,"w":[["Sa",100.56,100.74],["victoire",100.82,101.54],["est",101.58,101.82],["avec",101.9,102.22],["toi",102.32,102.54]],"ok":1.0},{"text":"Chineke m o, onye di nma kariri ihe nile,","t":117.04,"e":120.56,"w":[["Chineke",117.04,117.62],["m",117.7,117.74],["o",117.78,117.92],["onye",118.32,119],["di",119.02,119.22],["nma",119.04,119.24],["kariri",119.06,119.78],["ihe",119.82,120.02],["nile",119.86,120.56]],"ok":0.67},{"text":"N'ulo n'ezi gi bu mgbaba na ebe obibi kacha mma nile.","t":121.19,"e":125.28,"w":[["N'ulo",121.19,121.39],["n'ezi",121.82,122.56],["gi",122.77,122.97],["bu",122.97,123.17],["mgbaba",123.18,123.38],["na",123.39,123.59],["ebe",123.59,123.79],["obibi",123.8,124.1],["kacha",124.18,124.52],["mma",124.55,124.75],["nile",124.58,125.28]],"ok":0.36},{"text":"Mgbe uwa gbara n'ochichiri ma oburu na uzo kpuchiri,","t":126.72,"e":130.62,"w":[["Mgbe",126.72,126.86],["uwa",127.14,127.34],["gbara",127.42,127.62],["n'ochichiri",127.7,128.22],["ma",128.47,128.67],["oburu",128.72,129.24],["na",129.3,129.44],["uzo",129.6,129.98],["kpuchiri",130.08,130.62]],"ok":0.67},{"text":"O bu Aka gi di ike na-eweputa m n'ime uju mmiri.","t":130.83,"e":135.71,"w":[["O",130.83,131.03],["bu",131.03,131.23],["Aka",131.24,131.44],["gi",131.45,131.65],["di",131.65,131.85],["ike",131.86,132.2],["na-eweputa",132.46,132.98],["m",133.31,133.51],["n'ime",133.64,133.98],["uju",134.72,135.2],["mmiri",135.51,135.71]],"ok":0.36},{"text":"Eze di ora mma, onye na-enye m udo n'obi nile,","t":135.82,"e":139.34,"w":[["Eze",135.82,136],["di",136.35,136.55],["ora",136.71,136.91],["mma",137.06,137.26],["onye",137.42,137.54],["na-enye",137.78,137.94],["m",138,138.02],["udo",138.1,138.36],["n'obi",138.44,138.88],["nile",138.96,139.34]],"ok":0.7},{"text":"A ga m eto aha Gi ebighi ebi n'asusu nile!","t":139.87,"e":144.06,"w":[["A",139.87,140.07],["ga",140.4,140.66],["m",140.72,140.86],["eto",140.96,141.06],["aha",141.16,141.5],["Gi",141.7,141.9],["ebighi",141.9,142.26],["ebi",142.32,142.7],["n'asusu",143.14,143.6],["nile",143.68,144.06]],"ok":0.8},{"text":"Onyeoma...","t":163.96,"e":164.64,"w":[["Onyeoma",163.96,164.64]],"ok":1.0},{"text":"You give life and liberty to me.","t":165.2,"e":167.5,"w":[["You",165.2,165.3],["give",165.38,165.62],["life",165.68,165.94],["and",165.98,166.1],["liberty",166.18,166.78],["to",166.88,167.04],["me",167.16,167.5]],"ok":1.0},{"text":"Raise your hands up, let the heavy burden drop,","t":168.52,"e":171.28,"w":[["Raise",168.52,168.74],["your",168.8,168.9],["hands",168.98,169.36],["up",169.46,169.62],["let",169.72,169.88],["the",169.96,170.06],["heavy",170.12,170.44],["burden",170.52,170.88],["drop",170.96,171.28]],"ok":1.0},{"text":"Your miracle is coming, yeah, it's non-stop!","t":171.34,"e":174.08,"w":[["Your",171.34,171.42],["miracle",171.5,172.06],["is",172.12,172.26],["coming",172.32,172.7],["yeah",172.8,173.04],["it's",173.12,173.2],["non-stop",173.3,174.08]],"ok":1.0},{"text":"Bouge tes pas, tape les mains!","t":183.3,"e":185.22,"w":[["Bouge",183.3,183.5],["tes",183.54,183.76],["pas",183.88,184.1],["tape",184.48,184.7],["les",184.76,184.96],["mains",185.08,185.22]],"ok":1.0},{"text":"La joie descend dans les chemins!","t":185.48,"e":187.6,"w":[["La",185.48,185.58],["joie",185.68,185.88],["descend",185.94,186.62],["dans",186.7,186.82],["les",186.86,187.02],["chemins",187.1,187.6]],"ok":1.0},{"text":"Tourne à gauche, saute à droite!","t":188.02,"e":190.06,"w":[["Tourne",188.02,188.3],["à",188.4,188.54],["gauche",188.64,188.92],["saute",189.2,189.46],["à",189.66,189.7],["droite",189.78,190.06]],"ok":1.0},{"text":"Sa lumière sur nous se pointe!","t":190.4,"e":192.68,"w":[["Sa",190.4,190.58],["lumière",190.64,191.32],["sur",191.42,191.54],["nous",191.6,191.82],["se",191.84,192.04],["pointe",192.18,192.68]],"ok":1.0},{"text":"Danse, danse, loue ton Roi!","t":192.78,"e":194.7,"w":[["Danse",192.78,193.3],["danse",193.4,193.86],["loue",193.96,194.1],["ton",194.18,194.46],["Roi",194.52,194.7]],"ok":1.0},{"text":"Sa victoire est avec toi!","t":195.12,"e":197.44,"w":[["Sa",195.12,195.32],["victoire",195.38,196.12],["est",196.18,196.32],["avec",196.46,196.82],["toi",196.9,197.44]],"ok":1.0},{"text":"Oh-oh-oh... No shaking at all.","t":199.74,"e":204.26,"w":[["Oh-oh-oh",199.74,199.94],["No",202.04,202.2],["shaking",202.26,202.62],["at",203.34,203.54],["all",204.06,204.26]],"ok":0.4},{"text":"Chineke bu mmeri.","t":204.78,"e":206.16,"w":[["Chineke",204.78,205.36],["bu",205.66,205.86],["mmeri",205.96,206.16]],"ok":0.33}]}