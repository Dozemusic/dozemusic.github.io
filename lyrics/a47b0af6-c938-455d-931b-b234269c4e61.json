{"v":1,"src":"scribe+alignement","coverage":0.822,"lines":[{"text":"\"Charles le bon on the beat...\"","t":9.06,"e":10.86,"w":[["Charles",9.06,10.22],["le",10.22,10.42],["bon",10.22,10.42],["on",10.22,10.22],["the",10.24,10.44],["beat",10.52,10.86]],"ok":0.67},{"text":"Mwana ya mboka, bino botala, style ezali ya sika (Eh !)","t":32.72,"e":36.76,"w":[["Mwana",32.72,32.98],["ya",33,33.1],["mboka",33.14,33.46],["bino",33.66,33.9],["botala",33.92,34.38],["style",34.9,35.3],["ezali",35.36,35.72],["ya",35.74,35.94],["sika",35.76,36.3],["Eh",36.42,36.76]],"ok":0.9},{"text":"Na ngambo ya molongo, botala nani akoki kokaka? (Te !)","t":39.82,"e":44.65,"w":[["Na",39.82,39.88],["ngambo",39.92,40.22],["ya",40.24,40.44],["molongo",40.26,40.7],["botala",41.32,41.74],["nani",41.78,42.02],["akoki",42.08,42.82],["kokaka",42.88,43.56],["Te",44.45,44.65]],"ok":0.78},{"text":"Charles le bon, na on the beat, bino botala l’art ya kobina (Wouah !)","t":45.34,"e":49.78,"w":[["Charles",45.34,46.28],["le",46.3,46.5],["bon",46.32,46.52],["na",46.34,46.54],["on",46.36,46.46],["the",46.5,46.7],["beat",46.78,47],["bino",47.4,47.64],["botala",47.7,48.1],["l’art",48.14,48.42],["ya",48.44,48.64],["kobina",48.46,49.2],["Wouah",49.52,49.78]],"ok":0.69},{"text":"Na plateau ya Abidjan, soki naza, mboka mobimba ekobina! (Eh, eh !)","t":50.24,"e":58.5,"w":[["Na",50.24,50.34],["plateau",50.4,50.76],["ya",50.82,50.98],["Abidjan",51.02,51.54],["soki",52.64,52.92],["naza",52.96,53.36],["mboka",53.72,53.98],["mobimba",54.04,54.58],["ekobina",54.64,55.34],["Eh",58.38,58.5],["eh",58.5,58.5]],"ok":1.0},{"text":"Soki oza na ekateli, tika maboko zala makasi (Tika !)","t":58.54,"e":63.52,"w":[["Soki",58.54,58.86],["oza",58.92,59.32],["na",59.33,59.53],["ekateli",59.34,60.04],["tika",60.4,60.66],["maboko",60.7,61.14],["zala",61.2,61.56],["makasi",61.6,62.38],["Tika",63.08,63.52]],"ok":0.89},{"text":"Nga na landa nzela ya elonga, mpe na yina ba ngonga ya pasi (Awa !)","t":64.54,"e":70.54,"w":[["Nga",64.54,64.74],["na"