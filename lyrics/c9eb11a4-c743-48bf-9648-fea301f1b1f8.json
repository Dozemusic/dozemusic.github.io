,["ma",40.8,40.88],["table",40.98,41.14],["il",41.18,41.24],["riait",41.3,41.54],["avec",41.62,41.82],["mes",41.86,41.98],["parents",42.04,42.42]],"ok":1.0},{"text":"Un soir j'suis rentré plus tôt, la porte était entrouverte","t":42.48,"e":44.82,"w":[["Un",42.48,42.52],["soir",42.6,42.7],["j'suis",42.78,42.86],["rentré",42.9,43.18],["plus",43.22,43.32],["tôt",43.4,43.5],["la",43.7,43.78],["porte",43.82,43.98],["était",44.04,44.24],["entrouverte",44.26,44.82]],"ok":1.0},{"text":"Deux ombres sur le mur... et ma vie s'est faite déserte","t":45.04,"e":47.22,"w":[["Deux",45.04,45.18],["ombres",45.22,45.4],["sur",45.46,45.58],["le",45.62,45.7],["mur",45.78,45.9],["et",46.1,46.16],["ma",46.2,46.32],["vie",46.36,46.46],["s'est",46.5,46.6],["faite",46.64,46.78],["déserte",46.84,47.22]],"ok":1.0},{"text":"Pourquoi, pourquoi, pourquoi ? J'ai posé la question au plafond","t":47.44,"e":49.66,"w":[["Pourquoi",47.44,47.66],["pourquoi",47.74,47.96],["pourquoi",48.04,48.26],["J'ai",48.32,48.46],["posé",48.5,48.72],["la",48.78,48.86],["question",48.92,49.2],["au",49.24,49.28],["plafond",49.36,49.66]],"ok":1.0},{"text":"Le serpent qu'on nourrit grandit plus vite que l'enfant d'la maison","t":49.7,"e":52.04,"w":[["Le",49.7,49.76],["serpent",49.82,50.08],["qu'on",50.12,50.24],["nourrit",50.28,50.52],["grandit",50.58,50.84],["plus",50.9,51],["vite",51.04,51.16],["que",51.2,51.28],["l'enfant",51.3,51.56],["d'la",51.64,51.72],["maison",51.78,52.04]],"ok":1.0},{"text":"J'ai pas crié, j'ai pas frappé, j'ai pris ma veste et l'escalier","t":52.08,"e":54.46,"w":[["J'ai",52.08,52.2],["pas",52.24,52.34],["crié",52.38,52.62],["j'ai",52.68,52.78],["pas",52.82,52.92],["frappé",52.94,53.24],["j'ai",53.28,53.38],["pris",53.4,53.54],["ma",53.58,53.68],["veste",53.72,53.9],["et",53.92,53.96],["l'escalier",54,54.46]],"ok":1.0},{"text":"Le silence a fait plus d'bruit qu'un orage dans l'quartier","t":54.52,"e":56.86,"w":[["Le",54.52,54.58],["silence",54.66,54.92],["a",54.96,55],["fait",55.06,55.2],["plus",