{"v":1,"src":"scribe+alignement","coverage":0.816,"lines":[{"text":"Couplet 1)","t":29.24,"e":29.74,"w":[["Couplet",29.24,29.44],["1",29.54,29.74]],"ok":0.0},{"text":"J’ai vendu mes rêves, j'ai sacrifié ma propre vie,","t":29.84,"e":32.6,"w":[["J’ai",29.84,30],["vendu",30.04,30.28],["mes",30.32,30.46],["rêves",30.5,30.76],["j'ai",30.78,30.88],["sacrifié",30.92,31.5],["ma",31.56,31.7],["propre",31.8,32.38],["vie",32.44,32.6]],"ok":1.0},{"text":"Pour que tu touches les étoiles dans ton nouveau pays.","t":33.28,"e":36.3,"w":[["Pour",33.28,33.36],["que",33.4,33.48],["tu",33.54,33.64],["touches",33.72,33.96],["les",34,34.18],["étoiles",34.26,34.6],["dans",34.64,34.78],["ton",34.84,34.98],["nouveau",35.06,35.48],["pays",35.6,36.3]],"ok":1.0},{"text":"J'ai ramassé mes larmes au sol pour en faire ton chemin,","t":36.72,"e":39.76,"w":[["J'ai",36.72,36.84],["ramassé",36.88,37.26],["mes",37.28,37.4],["larmes",37.44,37.66],["au",37.7,37.76],["sol",37.88,38.26],["pour",38.32,38.48],["en",38.52,38.64],["faire",38.72,38.9],["ton",38.94,39.08],["chemin",39.12,39.76]],"ok":1.0},{"text":"J'ai brûlé mon propre cœur pour tenir ta main.","t":40.2,"e":43.24,"w":[["J'ai",40.2,40.32],["brûlé",40.34,40.64],["mon",40.7,40.86],["propre",40.92,41.32],["cœur",41.4,41.74],["pour",41.82,41.94],["tenir",42.02,42.5],["ta",42.56,42.72],["main",42.84,43.24]],"ok":1.0},{"text":"Le silence est ma demeure depuis que tu es partie,","t":43.72,"e":46.74,"w":[["Le",43.72,43.78],["silence",43.84,44.16],["est",44.2,44.34],["ma",44.42,44.54],["demeure",44.6,45.02],["depuis",45.08,45.42],["que",45.48,45.6],["tu",45.66,45.86],["es",45.92,46.06],["partie",46.14,46.74]],"ok":1.0},{"text":"Mon âme est un navire en pleine tempête, sans abri.","t":47.24,"e":50.06,"w":[["Mon",47.24,47.4],["âme",47.48,47.64],["est",47.68,47.88],["un",47.92,48.02],["navire",48.1,48.5],["en",48.54,48.64],["pleine",48.7,48.9],["tempête",48.94,49.32],["sans",49.4,49.6],["abri",49.66,50.06]],"ok":1.0},{"text":"Obi m na-akwa ákwá, na-eche maka ọdịnihu o","t":50.32,"e":53.79,"w":[["Obi",50.32,50.84],["m",51.02,51.22],["na-akwa",51.2,51.44],["ákwá",51.52,51.84],["na-eche",52,52.36],["maka",52.44,52.6],["ọdịnihu",53.09,53.29],["o",53.59,53.79]],"ok":0.62},{"text":"Ihe nile m rụrụ bụ n'ihi ịhụnanya","t":54.08,"e":56.96,"w":[["Ihe",54.08,54.36],["nile",54.4,54.5],["m",54.8,55.0],["rụrụ",55.1,55.3],["bụ",55.4,55.6],["n'ihi",55.7,55.86],["ịhụnanya",56.56,56.96]],"ok":0.57},{"text":"Ebe ị gara, ị chefuru onye nyere gị ndụ o","t":57.37,"e":60.72,"w":[["Ebe",57.37,57.57],["ị",57.78,57.98],["gara",58.19,58.39],["ị",58.6,58.8],["chefuru",59.01,59.21],["onye",59.42,59.56],["nyere",59.8,60.0],["gị",60.04,60.24],["ndụ",60.28,60.48],["o",60.52,60.72]],"ok":0.1},{"text":"Ugbu a, ihe nile aghọọla naanị ihe efu","t":60.76,"e":64.1,"w":[["Ugbu",60.76,61.16],["a",61.18,61.38],["ihe",61.2,61.48],["nile",61.52,61.62],["aghọọla",61.9,62.18],["naanị",62.26,62.74],["ihe",63.12,63.4],["efu",63.7,64.1]],"ok":0.88},{"text":"Ọ bụ m kụpụrụ ọkụ, ugbu a ọkụ ahụ agbanyụwo o","t":64.15,"e":67.93,"w":[["Ọ",64.15,64.35],["bụ",64.2,64.54],["m",64.79,64.99],["kụpụrụ",65.05,65.25],["ọkụ",65.3,65.6],["ugbu",65.74,66.04],["a",66.2,66.4],["ọkụ",66.36,66.42],["ahụ",66.69,66.89],["agbanyụwo",66.96,67.2],["o",67.73,67.93]],"ok":0.45},{"text":"M na-ata ahụhụ, n'ime ọchịchịrị","t":68.26,"e":70.84,"w":[["M",68.26,68.46],["na-ata",68.78,68.98],["ahụhụ",69.31,69.51],["n'ime",69.84,70.18],["ọchịchịrị",70.22,70.84]],"ok":0.4},{"text":"Les échos de ta voix hantent encore ma chambre,","t":71.64,"e":74.72,"w":[["Les",71.64,71.76],["échos",71.84,72.04],["de",72.1,72.18],["ta",72.22,72.36],["voix",72.4,72.68],["hantent",73.3,73.64],["encore",73.64,73.9],["ma",73.96,74.08],["chambre",74.12,74.72]],"ok":1.0},{"text":"Je compte mes douleurs comme on compte les membres.","t":75.1,"e":78.22,"w":[["Je",75.1,75.2],["compte",75.26,75.5],["mes",75.56,75.7],["douleurs",75.74,76.24],["comme",76.78,77],["on",77.04,77.16],["compte",77.2,77.42],["les",77.46,77.58],["membres",77.66,78.22]],"ok":1.0},{"text":"Chaque soir à Abidjan, je regarde le ciel gris,","t":78.28,"e":81.72,"w":[["Chaque",78.28,78.58],["soir",78.72,78.96],["à",79.02,79.14],["Abidjan",79.16,79.66],["je",80.22,80.32],["regarde",80.36,80.68],["le",80.72,80.82],["ciel",80.9,81.24],["gris",81.3,81.72]],"ok":1.0},{"text":"Le mariage que tu as fait est devenu mon prix.","t":81.8,"e":84.96,"w":[["Le",81.8,81.9],["mariage",82,82.4],["que",82.44,82.58],["tu",82.66,82.82],["as",82.92,83.02],["fait",83.1,83.46],["est",83.56,83.68],["devenu",83.74,84.32],["mon",84.4,84.54],["prix",84.58,84.96]],"ok":1.0},{"text":"Je suis ce fou qui danse sous la pluie sans parapluie,","t":85.04,"e":88.4,"w":[["Je",85.04,85.16],["suis",85.22,85.4],["ce",85.46,85.66],["fou",85.74,86.06],["qui",86.14,86.3],["danse",86.38,86.68],["sous",86.8,86.96],["la",87,87.14],["pluie",87.2,87.36],["sans",87.44,87.6],["parapluie",87.64,88.4]],"ok":1.0},{"text":"Celui qui a tout donné et qui finit dans l'oubli.","t":88.5,"e":91.74,"w":[["Celui",88.5,88.9],["qui",88.94,89.02],["a",89.06,89.14],["tout",89.26,89.56],["donné",89.62,90],["et",90.3,90.42],["qui",90.48,90.62],["finit",90.72,91.08],["dans",91.12,91.3],["l'oubli",91.34,91.74]],"ok":1.0},{"text":"« Hé ! Ça fait mal, hein ! »","t":92.71,"e":95.46,"w":[["Hé",92.71,92.91],["Ça",93.68,93.76],["fait",93.82,93.92],["mal",93.98,94.24],["hein",95.26,95.46]],"ok":0.6},{"text":"« Le diamant que tu portes, c’est ma sueur ! »","t":96.28,"e":98.86,"w":[["Le",96.28,96.38],["diamant",96.42,96.74],["que",96.8,96.88],["tu",96.92,97.04],["portes",97.16,97.52],["c’est",97.96,98.1],["ma",98.16,98.28],["sueur",98.36,98.86]],"ok":1.0},{"text":"« On a tout donné pour le bonheur, et le bonheur nous a laissés… »","t":100.06,"e":103.92,"w":[["On",100.06,100.14],["a",100.2,100.28],["tout",100.38,100.52],["donné",100.56,100.86],["pour",100.94,101.02],["le",101.06,101.14],["bonheur",101.2,101.7],["et",101.72,101.78],["le",101.82,101.9],["bonheur",101.96,102.3],["nous",102.34,102.48],["a",102.52,102.58],["laissés",103.4,103.92]],"ok":1.0},{"text":"« Bolo Super ! La douleur est réelle ! »","t":104.16,"e":106.52,"w":[["Bolo",104.16,104.42],["Super",104.54,105.22],["La",105.4,105.5],["douleur",105.54,105.86],["est",105.88,105.96],["réelle",106.02,106.52]],"ok":1.0},{"text":"Tu es mon grand regret, ma blessure ouverte,","t":126.54,"e":129.52,"w":[["Tu",126.54,126.7],["es",126.76,126.86],["mon",126.9,127.06],["grand",127.1,127.3],["regret",127.34,127.82],["ma",127.9,128.06],["blessure",128.18,128.74],["ouverte",128.78,129.52]],"ok":1.0},{"text":"Mon investissement dans une cause perdue, une âme déserte.","t":130.04,"e":133.8,"w":[["Mon",130.04,130.16],["investissement",130.2,131.18],["dans",131.26,131.46],["une",131.52,131.7],["cause",131.76,132.08],["perdue",132.12,132.6],["une",132.7,132.84],["âme",132.9,133.04],["déserte",133.1,133.8]],"ok":1.0},{"text":"Si le monde savait ce que j'ai laissé en chemin,","t":134.14,"e":137.16,"w":[["Si",134.14,134.24],["le",134.28,134.42],["monde",134.48,134.74],["savait",134.8,135.36],["ce",135.38,135.44],["que",135.48,135.62],["j'ai",135.66,135.86],["laissé",135.92,136.32],["en",136.36,136.48],["chemin",136.54,137.16]],"ok":1.0},{"text":"Il comprendrait pourquoi je n'ai plus d'espoir pour demain.","t":137.28,"e":140.66,"w":[["Il",137.28,137.4],["comprendrait",137.46,138.04],["pourquoi",138.1,138.46],["je",138.76,138.92],["n'ai",138.94,139.14],["plus",139.18,139.36],["d'espoir",139.4,139.8],["pour",139.88,140.02],["demain",140.08,140.66]],"ok":1.0},{"text":"Obi m na-akwa ákwá, na-eche maka ọdịnihu o","t":140.76,"e":144.0,"w":[["Obi",140.76,141.28],["m",141.46,141.66],["na-akwa",141.64,141.88],["ákwá",141.96,142.34],["na-eche",142.44,142.8],["maka",142.86,143],["ọdịnihu",143.4,143.6],["o",143.8,144.0]],"ok":0.62},{"text":"Ihe nile m rụrụ bụ n'ihi ịhụnanya","t":144.2,"e":147.4,"w":[["Ihe",144.2,144.74],["nile",144.8,144.9],["m",145.21,145.41],["rụrụ",145.52,145.72],["bụ",145.83,146.03],["n'ihi",146.14,146.3],["ịhụnanya",147,147.4]],"ok":0.57},{"text":"Ebe ị gara, ị chefuru onye nyere gị ndụ o","t":147.74,"e":151.09,"w":[["Ebe",147.74,147.94],["ị",148.09,148.29],["gara",148.43,148.63],["ị",148.77,148.97],["chefuru",149.12,149.32],["onye",149.46,149.82],["nyere",150.09,150.29],["gị",150.36,150.56],["ndụ",150.62,150.82],["o",150.89,151.09]],"ok":0.1},{"text":"Ugbu a, ihe nile aghọọla naanị ihe efu","t":151.16,"e":154.56,"w":[["Ugbu",151.16,151.62],["a",151.65,151.85],["ihe",151.68,151.92],["nile",151.98,152.06],["aghọọla",152.36,152.66],["naanị",152.72,153.26],["ihe",153.56,153.92],["efu",154.2,154.56]],"ok":0.88},{"text":"Ọ bụ m kụpụrụ ọkụ, ugbu a ọkụ ahụ agbanyụwo o","t":154.62,"e":158.17,"w":[["Ọ",154.62,154.82],["bụ",154.68,154.98],["m",155.26,155.46],["kụpụrụ",155.54,155.74],["ọkụ",155.82,156.02],["ugbu",156.18,156.46],["a",156.63,156.83],["ọkụ",156.8,156.9],["ahụ",156.97,157.17],["agbanyụwo",157.04,157.38],["o",157.97,158.17]],"ok":0.45},{"text":"M na-ata ahụhụ, n'ime ọchịchịrị","t":158.56,"e":161.32,"w":[["M",158.56,158.76],["na-ata",159.16,159.36],["ahụhụ",159.75,159.95],["n'ime",160.34,160.62],["ọchịchịrị",160.66,161.32]],"ok":0.4},{"text":"Adieu l'Europe…","t":164.92,"e":165.48,"w":[["Adieu",164.92,165.12],["l'Europe",165.14,165.48]],"ok":1.0},{"text":"Adieu l'amour…","t":174.52,"e":175.2,"w":[["Adieu",174.52,174.7],["l'amour",174.74,175.2]],"ok":1.0},{"text":"Je n'ai plus rien…","t":178.9,"e":179.58,"w":[["Je",178.9,178.96],["n'ai",178.98,179.12],["plus",179.14,179.32],["rien",179.36,179.58]],"ok":1.0}]}