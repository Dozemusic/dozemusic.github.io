{"v":1,"src":"scribe+alignement","coverage":0.941,"lines":[{"text":"Yeah… Elengi ya bolingo, ékómi mawa…","t":5.88,"e":8.06,"w":[["Yeah",5.88,5.9],["Elengi",6.11,6.31],["ya",6.31,6.51],["bolingo",6.52,6.9],["ékómi",6.94,7.36],["mawa",7.44,8.06]],"ok":0.67},{"text":"Tala, bolingo na ngai ézali ndoto…","t":9.64,"e":13.56,"w":[["Tala",9.64,9.92],["bolingo",11.56,11.94],["na",11.98,12.1],["ngai",12.14,12.36],["ézali",12.4,12.78],["ndoto",12.84,13.56]],"ok":1.0},{"text":"Listen.","t":15.78,"e":16.16,"w":[["Listen",15.78,16.16]],"ok":1.0},{"text":"Les draps sont froids,","t":34.68,"e":35.5,"w":[["Les",34.68,34.78],["draps",34.84,35.04],["sont",35.06,35.2],["froids",35.24,35.5]],"ok":1.0},{"text":"Le souvenir est un poison.","t":35.58,"e":37.18,"w":[["Le",35.58,35.66],["souvenir",35.72,36.34],["est",36.38,36.58],["un",36.62,36.74],["poison",36.78,37.18]],"ok":1.0},{"text":"J'ai perdu ton étoile,","t":37.62,"e":39.04,"w":[["J'ai",37.62,37.82],["perdu",37.88,38.24],["ton",38.32,38.5],["étoile",38.6,39.04]],"ok":1.0},{"text":"J'ai perdu ma raison.","t":39.38,"e":40.66,"w":[["J'ai",39.38,39.56],["perdu",39.64,40],["ma",40.06,40.2],["raison",40.28,40.66]],"ok":1.0},{"text":"Le décor est posé,","t":41.16,"e":42.46,"w":[["Le",41.16,41.3],["décor",41.38,41.8],["est",41.82,41.94],["posé",42.02,42.46]],"ok":1.0},{"text":"Mais le rôle est trop grand.","t":42.88,"e":44.14,"w":[["Mais",42.88,43.04],["le",43.1,43.24],["rôle",43.3,43.54],["est",43.56,43.66],["trop",43.72,43.9],["grand",43.96,44.14]],"ok":1.0},{"text":"Je navigue seul,","t":44.6,"e":45.62,"w":[["Je",44.6,44.74],["navigue",44.84,45.24],["seul",45.32,45.62]],"ok":1.0},{"text":"Dans cet océan de tourments.","t":45.92,"e":47.62,"w":[["Dans",45.92,46.08],["cet",46.14,46.34],["océan",46.38,46.94],["de",47.02,47.12],["tourments",47.22,47.62]],"ok":1.0},{"text":"Mo-te-ma na ngai é-za-li ko-tu-na, wa-pi yo?","t":49.16,"e":52.56,"w":[["Mo-te-ma",49.16,49.76],["na",49.84,49.94],["ngai",50.02,50.2],["é-za-li",50.38,50.86],["ko-tu-na",50.94,51.52],["wa-pi",51.82,52.18],["yo",52.36,52.56]],"ok":0.86},{"text":"Na ka-ti ya mwin-do, na zon-gi na mo-tam-bo-li ya mi-so.","t":52.54,"e":56.08,"w":[["Na",52.54,52.62],["ka-ti",52.68,52.92],["ya",52.92,53.04],["mwin-do",53.08,53.46],["na",53.5,53.7],["zon-gi",53.54,54.12],["na",54.18,54.32],["mo-tam-bo-li",54.4,54.7],["ya",55.0,55.2],["mi-so",55.3,56.08]],"ok":0.8},{"text":"Ba-ssa, na mo-te-ma...","t":56.16,"e":58,"w":[["Ba-ssa",56.16,56.98],["na",57.22,57.38],["mo-te-ma",57.44,58]],"ok":1.0},{"text":"O-za el-en-gi, o-za li-ta-ma.","t":58.8,"e":61.52,"w":[["O-za",58.8,59.14],["el-en-gi",59.22,59.9],["o-za",60.54,60.86],["li-ta-ma",60.94,61.52]],"ok":1.0},{"text":"Ba-ssa, na mo-te-ma...","t":63.12,"e":64.94,"w":[["Ba-ssa",63.12,63.92],["na",64.18,64.34],["mo-te-ma",64.4,64.94]],"ok":1.0},{"text":"O-zo ko-ti-a ngai, na mu-ku-ma.","t":65.13,"e":68.5,"w":[["O-zo",65.13,65.33],["ko-ti-a",65.32,66.32],["ngai",66.52,66.88],["na",67.64,67.82],["mu-ku-ma",67.9,68.5]],"ok":0.8},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":68.73,"e":71.9,"w":[["Na",68.73,68.93],["le-la",68.96,69.54],["yo",69.62,69.78],["lé-lé",70.5,70.86],["lé-lé",71.36,71.74],["yo",71.8,71.9]],"ok":0.83},{"text":"Bolingo na ngai é-ko-mi, é-ko-mi, é-ko-mi... Clas-sique !","t":72.24,"e":76.88,"w":[["Bolingo",72.24,72.82],["na",72.86,73.02],["ngai",73.06,73.48],["é-ko-mi",73.58,74.14],["é-ko-mi",74.46,75.04],["é-ko-mi",75.3,75.88],["Clas-sique",76.14,76.88]],"ok":1.0},{"text":"Na lu-ka-ki yo na ka-ti ya ba rê-ves,","t":80.36,"e":85.9,"w":[["Na",80.36,80.56],["lu-ka-ki",83.84,84.4],["yo",84.44,84.52],["na",84.56,84.66],["ka-ti",84.7,84.98],["ya",85,85.1],["ba",85.14,85.24],["rê-ves",85.32,85.9]],"ok":0.88},{"text":"Mais réa-li-té é-za-li ma-ka-si, é-za-li ba grè-ves.","t":86,"e":89.44,"w":[["Mais",86,86.12],["réa-li-té",86.18,86.7],["é-za-li",86.76,87.12],["ma-ka-si",87.16,87.8],["é-za-li",88.22,88.56],["ba",88.6,88.7],["grè-ves",88.76,89.44]],"ok":1.0},{"text":"Les mots ne suffisent plus,","t":89.48,"e":91.22,"w":[["Les",89.48,89.58],["mots",89.64,89.78],["ne",89.84,89.98],["suffisent",90.08,90.86],["plus",90.92,91.22]],"ok":1.0},{"text":"À combler ton absence.","t":91.28,"e":92.78,"w":[["À",91.28,91.34],["combler",91.4,91.74],["ton",91.82,92],["absence",92.06,92.78]],"ok":1.0},{"text":"Je m'efface doucement,","t":92.92,"e":94.64,"w":[["Je",92.92,93.04],["m'efface",93.1,93.52],["doucement",93.58,94.64]],"ok":1.0},{"text":"Dans cette triste silence.","t":94.7,"e":96.54,"w":[["Dans",94.7,94.8],["cette",94.86,95],["triste",95.06,95.46],["silence",95.58,96.54]],"ok":1.0},{"text":"Li-bo-ta na nga-i é-za-li ko tu-na nga-i, wa-pi mwa-si na yo?","t":97.3,"e":100.84,"w":[["Li-bo-ta",97.3,97.68],["na",97.74,97.82],["nga-i",97.84,98.02],["é-za-li",98.1,98.44],["ko",98.48,98.68],["tu-na",98.52,99.04],["nga-i",99.12,99.42],["wa-pi",99.62,99.96],["mwa-si",100.04,100.44],["na",100.5,100.62],["yo",100.68,100.84]],"ok":0.91},{"text":"Na-za-li na mba-no te, ka-ka ba pin-zo-li na mi-so.","t":100.94,"e":104.32,"w":[["Na-za-li",100.94,101.5],["na",101.56,101.66],["mba-no",101.74,101.92],["te",101.97,102.17],["ka-ka",102.02,102.8],["ba",102.86,103],["pin-zo-li",103.06,103.48],["na",103.54,103.88],["mi-so",103.96,104.32]],"ok":0.89},{"text":"Mo-ko-lo ni-on-so na ta-la-ka bi-li-lin-gi na yo.","t":104.42,"e":107.8,"w":[["Mo-ko-lo",104.42,105.1],["ni-on-so",105.14,105.42],["na",105.48,105.64],["ta-la-ka",105.72,106.32],["bi-li-lin-gi",106.6,107.38],["na",107.46,107.6],["yo",107.64,107.8]],"ok":1.0},{"text":"Mo-te-ma é-za-li ko pi-ka lo-ko-la ngo-nga ya ek-le-si-ya.","t":107.9,"e":111.3,"w":[["Mo-te-ma",107.9,108.46],["é-za-li",108.48,108.88],["ko",108.92,109.12],["pi-ka",108.96,109.52],["lo-ko-la",109.62,109.98],["ngo-nga",110.02,110.38],["ya",110.41,110.61],["ek-le-si-ya",110.44,111.3]],"ok":0.75},{"text":"Grr, paw, paw.","t":112.22,"e":113.36,"w":[["Grr",112.22,112.38],["paw",112.68,112.86],["paw",113.12,113.36]],"ok":1.0},{"text":"T'étais mon pilier, t'as fini par devenir mon pire ennemi,","t":113.52,"e":116.32,"w":[["T'étais",113.52,113.78],["mon",113.82,113.96],["pilier",114,114.22],["t'as",114.26,114.38],["fini",114.44,114.66],["par",114.72,114.82],["devenir",114.86,115.26],["mon",115.32,115.44],["pire",115.48,115.72],["ennemi",115.8,116.32]],"ok":1.0},{"text":"Le cœur est en mode survie, y’a plus de place pour les compromis.","t":116.78,"e":119.8,"w":[["Le",116.78,116.84],["cœur",116.88,117.04],["est",117.06,117.22],["en",117.24,117.38],["mode",117.44,117.6],["survie",117.64,118.06],["y’a",118.16,118.24],["plus",118.3,118.44],["de",118.5,118.56],["place",118.6,118.8],["pour",118.84,118.94],["les",118.98,119.14],["compromis",119.2,119.8]],"ok":1.0},{"text":"J'ai le cœur froid, pourtant j'brûle à l'intérieur,","t":120.02,"e":122.46,"w":[["J'ai",120.02,120.12],["le",120.16,120.24],["cœur",120.28,120.42],["froid",120.5,120.84],["pourtant",120.96,121.26],["j'brûle",121.28,121.58],["à",121.66,121.74],["l'intérieur",121.78,122.46]],"ok":1.0},{"text":"T'es partie avec mon âme, t'as laissé que les douleurs.","t":122.68,"e":126,"w":[["T'es",122.68,122.82],["partie",122.88,123.3],["avec",123.44,123.7],["mon",123.76,123.96],["âme",124.06,124.32],["t'as",124.4,124.56],["laissé",124.62,124.98],["que",125.06,125.22],["les",125.3,125.44],["douleurs",125.5,126]],"ok":1.0},{"text":"Shabba, j'suis dans le noir, j'cherche la lumière au bout du tunnel,","t":126.1,"e":129.7,"w":[["Shabba",126.1,126.48],["j'suis",126.74,126.96],["dans",127.02,127.18],["le",127.24,127.34],["noir",127.44,127.66],["j'cherche",127.72,127.88],["la",127.92,128.04],["lumière",128.08,128.52],["au",128.56,128.68],["bout",128.76,128.9],["du",128.96,129.1],["tunnel",129.18,129.7]],"ok":1.0},{"text":"L'amour c'est qu'un jeu, j'ai fini par perdre les ailes.","t":130.06,"e":133.06,"w":[["L'amour",130.06,130.42],["c'est",130.5,130.64],["qu'un",130.68,130.86],["jeu",130.96,131.12],["j'ai",131.34,131.5],["fini",131.6,131.94],["par",132,132.14],["perdre",132.24,132.38],["les",132.46,132.72],["ailes",132.8,133.06]],"ok":1.0},{"text":"Grr, gang.","t":133.12,"e":135.22,"w":[["Grr",133.12,134.28],["gang",134.84,135.22]],"ok":1.0},{"text":"E-za ki-to-ko, e-za ma-wa, e-za ki-mi-a…","t":135.34,"e":138.5,"w":[["E-za",135.34,135.86],["ki-to-ko",135.94,136.3],["e-za",136.64,136.96],["ma-wa",137.04,137.4],["e-za",137.56,137.84],["ki-mi-a",137.94,138.5]],"ok":1.0},{"text":"Ta-la bo-mo-i na nga-i é-za-li po na yo.","t":138.76,"e":142.18,"w":[["Ta-la",138.76,139.12],["bo-mo-i",139.2,139.78],["na",139.84,140],["nga-i",140.04,140.3],["é-za-li",140.6,141.28],["po",141.38,141.52],["na",141.56,141.76],["yo",141.6,142.18]],"ok":0.88},{"text":"Hé! Zon-ga, zon-ga ma-ma…","t":142.66,"e":144.38,"w":[["Hé",142.66,142.86],["Zon-ga",143.14,143.48],["zon-ga",143.58,143.92],["ma-ma",144,144.38]],"ok":0.75},{"text":"O-za mon tré-sor, o-za ma mé-lan-co-li-e.","t":145.8,"e":149.14,"w":[["O-za",145.8,146.06],["mon",146.16,146.28],["tré-sor",146.36,146.86],["o-za",147.12,147.4],["ma",147.46,147.58],["mé-lan-co-li-e",147.66,149.14]],"ok":1.0},{"text":"Ba-ssa, na mo-te-ma...","t":150.08,"e":151.9,"w":[["Ba-ssa",150.08,150.88],["na",151.12,151.28],["mo-te-ma",151.36,151.9]],"ok":1.0},{"text":"O-za el-en-gi, o-za li-ta-ma.","t":152.68,"e":155.44,"w":[["O-za",152.68,153],["el-en-gi",153.08,153.78],["o-za",154.44,154.78],["li-ta-ma",154.84,155.44]],"ok":1.0},{"text":"Ba-ssa, na mo-te-ma...","t":157.58,"e":158.86,"w":[["Ba-ssa",157.58,157.84],["na",158.1,158.24],["mo-te-ma",158.32,158.86]],"ok":1.0},{"text":"O-zo ko-ti-a ngai, na mu-ku-ma.","t":159.05,"e":162.4,"w":[["O-zo",159.05,159.25],["ko-ti-a",159.24,160.42],["ngai",160.44,160.78],["na",161.58,161.72],["mu-ku-ma",161.8,162.4]],"ok":0.8},{"text":"Na le-la yo, lé-lé, lé-lé yo...","t":162.64,"e":165.84,"w":[["Na",162.64,162.84],["le-la",162.88,163.48],["yo",163.54,163.9],["lé-lé",164.42,164.78],["lé-lé",165.28,165.64],["yo",165.72,165.84]],"ok":0.83},{"text":"Bolingo na ngai é-ko-mi, é-ko-mi, é-ko-mi... Clas-sique !","t":166.16,"e":170.8,"w":[["Bolingo",166.16,166.72],["na",166.78,166.92],["ngai",166.96,167.4],["é-ko-mi",167.54,168.02],["é-ko-mi",168.42,168.94],["é-ko-mi",169.3,169.8],["Clas-sique",170.02,170.8]],"ok":1.0},{"text":"Na le-la yo…","t":173.8,"e":177.62,"w":[["Na",173.8,174.0],["le-la",176.8,177.4],["yo",177.46,177.62]],"ok":0.67},{"text":"Bolingo é-ko-mi ma-wa…","t":179.82,"e":183.06,"w":[["Bolingo",179.82,180.44],["é-ko-mi",180.56,181.64],["ma-wa",182.46,183.06]],"ok":1.0},{"text":"C’est fi-ni.","t":183.72,"e":184.34,"w":[["C’est",183.72,183.88],["fi-ni",183.96,184.34]],"ok":1.0}]}