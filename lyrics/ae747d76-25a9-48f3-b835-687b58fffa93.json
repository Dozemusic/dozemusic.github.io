{"v":1,"src":"scribe+alignement","coverage":0.614,"lines":[{"text":"Mmm-mmm, mmm-mmm, ooh","t":40.32,"e":41.12,"w":[["Mmm-mmm",40.32,40.52],["mmm-mmm",40.62,40.82],["ooh",40.92,41.12]],"ok":0.0},{"text":"Amina é, é-é-é","t":41.22,"e":42.02,"w":[["Amina",41.22,41.42],["é",41.52,41.72],["é-é-é",41.82,42.02]],"ok":0.0},{"text":"Mmm-mmm, la-la-la, ooh","t":42.12,"e":42.92,"w":[["Mmm-mmm",42.12,42.32],["la-la-la",42.42,42.62],["ooh",42.72,42.92]],"ok":0.0},{"text":"M si n'obodo mepere emepe, obi m jupụtara na nsogbu, oh","t":43.02,"e":46.94,"w":[["M",43.02,43.22],["si",43.32,43.42],["n'obodo",43.68,43.98],["mepere",44.22,44.52],["emepe",44.9,45.1],["obi",45.28,45.5],["m",45.72,45.92],["jupụtara",45.94,46.22],["na",46.28,46.4],["nsogbu",46.67,46.87],["oh",46.94,46.94]],"ok":0.64},{"text":"Ego dị, mana udo adịghị, é-é","t":47.54,"e":49.8,"w":[["Ego",47.54,47.74],["dị",47.8,47.94],["mana",48.02,48.28],["udo",48.34,48.5],["adịghị",48.54,49.06],["é-é",49.6,49.8]],"ok":0.83},{"text":"N'akụkụ osimiri, ahụrụ m otu nwanyị","t":50.14,"e":53.1,"w":[["N'akụkụ",50.14,50.34],["osimiri",50.68,51.16],["ahụrụ",51.78,52.16],["m",52.2,52.4],["otu",52.24,52.58],["nwanyị",52.64,53.1]],"ok":0.67},{"text":"Amina, anya ya dị ka ọnwa n'abalị, mmm","t":53.18,"e":55.77,"w":[["Amina",53.18,53.6],["anya",53.64,53.76],["ya",53.82,54.24],["dị",54.39,54.59],["ka",54.54,54.74],["ọnwa",54.69,54.89],["n'abalị",54.84,55.3],["mmm",55.57,55.77]],"ok":0.5},{"text":"Ọ na-asa ahụ, mmiri na-abụ abụ, ooh","t":55.84,"e":57.93,"w":[["Ọ",55.84,56.04],["na-asa",56.11,56.31],["ahụ",56.38,56.56],["mmiri",56.77,56.97],["na-abụ",56.97,57.17],["abụ",57.18,57.58],["ooh",57.73,57.93]],"ok":0.29},{"text":"Echefuru m aha m, echefuru m ụzọ ịlaghachi","t":57.88,"e":60.2,"w":[["Echefuru",57.88,58.2],["m",58.34,58.54],["aha",58.47,58.67],["m",58.61,58.81],["echefuru",58.74,59.12],["m",59.41,59.62],["ụzọ",59.71,59.91],["ịlaghachi",60.0,60.2]],"ok":0.25},{"text":"J'étais venu pour deux jours, juste le temps de saluer","t":60.3,"e":63.72,"w":[["J'étais",60.3,60.58],["venu",60.64,61.06],["pour",61.14,61.34],["deux",61.4,61.6],["jours",61.68,61.94],["juste",62.2,62.4],["le",62.46,62.56],["temps",62.68,62.92],["de",62.98,63.06],["saluer",63.22,63.72]],"ok":1.0},{"text":"Mais la rivière m'a gardé, Amina m'a désarmé","t":64.3,"e":68.16,"w":[["Mais",64.3,64.38],["la",64.42,64.52],["rivière",64.58,65],["m'a",65.06,65.28],["gardé",65.34,66.06],["Amina",66.18,66.84],["m'a",66.88,67.1],["désarmé",67.18,68.16]],"ok":1.0},{"text":"Mmm, qu'on me cherche à la ville, qu'on m'appelle au bureau","t":68.32,"e":71.84,"w":[["Mmm",68.32,68.64],["qu'on",68.72,68.82],["me",68.86,68.94],["cherche",68.96,69.26],["à",69.3,69.34],["la",69.38,69.5],["ville",69.56,70.02],["qu'on",70.58,70.76],["m'appelle",70.84,71.34],["au",71.36,71.42],["bureau",71.48,71.84]],"ok":1.0},{"text":"Ma vie a changé d'adresse, elle est au bord de l'eau, oh-oh","t":72.52,"e":76.6,"w":[["Ma",72.52,72.64],["vie",72.68,72.82],["a",72.86,72.96],["changé",73,73.4],["d'adresse",73.46,74.14],["elle",74.64,74.78],["est",74.82,75],["au",75.06,75.2],["bord",75.28,75.6],["de",75.66,75.74],["l'eau",75.8,76.06],["oh-oh",76.4,76.6]],"ok":0.92},{"text":"Amina é, agaghị m alaghachi, é-é","t":76.74,"e":78.93,"w":[["Amina",76.74,77.08],["é",77.14,77.34],["agaghị",77.52,77.98],["m",78.23,78.43],["alaghachi",78.48,78.68],["é-é",78.73,78.93]],"ok":0.5},{"text":"M ga-anọ ebe a, n'akụkụ gị, ooh","t":78.99,"e":81.09,"w":[["M",78.99,79.19],["ga-anọ",79.24,79.44],["ebe",79.49,79.69],["a",79.74,79.94],["n'akụkụ",80.1,80.3],["gị",80.26,80.72],["ooh",80.89,81.09]],"ok":0.29},{"text":"Ịhụnanya anyị agaghị agwụ","t":81.06,"e":82.66,"w":[["Ịhụnanya",81.06,81.5],["anyị",81.79,81.99],["agaghị",82.08,82.34],["agwụ",82.4,82.66]],"ok":0.75},{"text":"A hụrụ m gị n'anya, ị bụ obi m, mmm","t":82.71,"e":85.08,"w":[["A",82.71,82.91],["hụrụ",82.76,83.06],["m",83.08,83.28],["gị",83.1,83.26],["n'anya",83.64,83.86],["ị",84.05,84.25],["bụ",84.25,84.45],["obi",84.44,84.6],["m",84.62,84.82],[