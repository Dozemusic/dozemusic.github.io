{"v":1,"src":"scribe+alignement","coverage":0.908,"lines":[{"text":"Marco on the beat…","t":3.3,"e":4.2,"w":[["Marco",3.3,3.5],["on",3.6,3.66],["the",3.72,3.82],["beat",3.88,4.2]],"ok":0.75},{"text":"Eh eh eh…","t":4.61,"e":5.62,"w":[["Eh",4.61,4.81],["eh",5.01,5.21],["eh",5.42,5.62]],"ok":0.0},{"text":"Na God do am o…","t":5.82,"e":7.23,"w":[["Na",5.82,5.94],["God",6,6.26],["do",6.36,6.56],["am",6.46,6.8],["o",7.03,7.23]],"ok":0.6},{"text":"C’est le Vieux Père qui gère hein…","t":7.26,"e":8.94,"w":[["C’est",7.26,7.38],["le",7.42,7.54],["Vieux",7.6,7.8],["Père",7.9,8.12],["qui",8.18,8.32],["gère",8.38,8.68],["hein",8.68,8.94]],"ok":1.0},{"text":"Abidjan to Accra… Kumasi to Bouaké…","t":9.3,"e":13.08,"w":[["Abidjan",9.3,9.8],["to",9.88,9.98],["Accra",10.02,10.44],["Kumasi",11.54,12.18],["to",12.28,12.52],["Bouaké",12.62,13.08]],"ok":1.0},{"text":"Yɛda Onyame ase! (Nous remercions Dieu)","t":14.02,"e":17.22,"w":[["Yɛda",14.02,14.32],["Onyame",14.36,14.76],["ase",14.8,15.42],["Nous",15.96,16.16],["remercions",16.49,16.69],["Dieu",17.02,17.22]],"ok":0.5},{"text":"On dit merci à Dieu !","t":17.56,"e":18.88,"w":[["On",17.56,17.62],["dit",17.68,17.8],["merci",17.86,18.28],["à",18.34,18.46],["Dieu",18.56,18.88]],"ok":1.0},{"text":"See where we dey now, on est bien calé","t":19.28,"e":22.32,"w":[["See",19.28,19.48],["where",19.69,19.89],["we",20.09,20.29],["dey",20.49,20.69],["now",20.9,21.1],["on",21.3,21.42],["est",21.46,21.56],["bien",21.6,21.8],["calé",21.88,22.32]],"ok":0.44},{"text":"Hier on galérait, aujourd’hui ça va aller","t":22.64,"e":24.78,"w":[["Hier",22.64,22.9],["on",22.94,23.02],["galérait",23.06,23.48],["aujourd’hui",23.54,23.92],["ça",24,24.1],["va",24.14,24.24],["aller",24.34,24.78]],"ok":1.0},{"text":"Many many wahala, but we still dey stand","t":25.04,"e":27.22,"w":[["Many",25.04,25.28],["many",25.32,25.56],["wahala",25.6,26.02],["but",26.06,26.18],["we",26.22,26.34],["still",26.42,26.6],["dey",26.66,26.82],["stand",26.92,27.22]],"ok":1.0},{"text":"Le Seigneur tient nos mains, no let us jam for sand","t":27.44,"e":29.64,"w":[["Le",27.44,27.52],["Seigneur",27.56,27.82],["tient",27.86,27.98],["nos",28.02,28.12],["mains",28.18,28.3],["no",28.34,28.42],["let",28.46,28.62],["us",28.66,28.8],["jam",28.95,29.15],["for",29.1,29.26],["sand",29.4,29.64]],"ok":0.91},{"text":"Sɛ ɛnyɛ Wo a, anka yɛyɛ dɛn?","t":29.81,"e":31.98,"w":[["Sɛ",29.81,30.01],["ɛnyɛ",29.98,30.18],["Wo",30.15,30.35],["a",30.32,30.48],["anka",30.8,31.14],["yɛyɛ",31.45,31.65],["dɛn",31.76,31.98]],"ok":0.43},{"text":"Quand y’avait palabre, You show us the way","t":34.74,"e":36.78,"w":[["Quand",34.74,34.86],["y’avait",34.98,35.18],["palabre",35.39,35.59],["You",35.59,35.79],["show",35.8,36.04],["us",36.1,36.22],["the",36.28,36.38],["way",36.42,36.78]],"ok":0.75},{"text":"Quand ça chauffait fort, You save us everyday","t":36.84,"e":38.9,"w":[["Quand",36.84,36.96],["ça",37.02,37.1],["chauffait",37.14,37.54],["fort",37.64,37.86],["You",37.92,38],["save",38.06,38.24],["us",38.28,38.44],["everyday",38.52,38.9]],"ok":1.0},{"text":"Garba sur la table, la paix dans la maison","t":39.58,"e":41.56,"w":[["Garba",39.58,39.82],["sur",39.88,39.98],["la",40.04,40.12],["table",40.2,40.44],["la",40.48,40.56],["paix",40.62,40.74],["dans",40.78,40.88],["la",40.94,41.02],["maison",41.08,41.56]],"ok":1.0},{"text":"Même quand c’est compliqué, Tu restes la solution","t":41.82,"e":44.02,"w":[["Même",41.82,41.94],["quand",41.96,42.06],["c’est",42.12,42.22],["compliqué",42.26,42.66],["Tu",42.72,42.8],["restes",42.86,43.08],["la",43.08,43.2],["solution",43.28,44.02]],"ok":1.0},{"text":"Wo adom na ɛma yɛkɔ so","t":44.24,"e":46.56,"w":[["Wo",44.24,44.58],["adom",44.71,44.91],["na",44.85,45.05],["ɛma",44.98,45.52],["yɛkɔ",45.6,46.06],["so",46.2,46.56]],"ok":0.67},{"text":"Petit petit, la vie devient douce","t":48.88,"e":50.76,"w":[["Petit",48.88,49.1],["petit",49.18,49.46],["la",49.64,49.74],["vie",49.82,50.02],["devient",50.08,50.38],["douce",50.44,50.76]],"ok":1.0},{"text":"Même si les jaloux parlent, on avance sans secousse","t":50.84,"e":53.26,"w":[["Même",50.84,50.94],["si",51,51.08],["les",51.12,51.22],["jaloux",51.28,51.54],["parlent",51.62,51.86],["on",51.92,52],["avance",52.1,52.42],["sans",52.52,52.72],["secousse",52.62,53.26]],"ok":0.89},{"text":"Marco on the beat…","t":53.38,"e":54.4,"w":[["Marco",53.38,53.82],["on",54,54.08],["the",54.14,54.22],["beat",54.28,54.4]],"ok":1.0},{"text":"Na Your grace dey carry, na Your light dey shine","t":54.58,"e":56.82,"w":[["Na",54.58,54.66],["Your",54.7,54.82],["grace",54.84,55],["dey",55.04,55.12],["carry",55.18,55.42],["na",55.48,55.58],["Your",55.64,55.76],["light",55.82,56.02],["dey",56.08,56.2],["shine",56.32,56.82]],"ok":1.0},{"text":"Aujourd’hui on sourit, tomorrow go be fine","t":56.86,"e":59.34,"w":[["Aujourd’hui",56.86,57.24],["on",57.3,57.38],["sourit",57.44,57.68],["tomorrow",57.74,58.14],["go",58.2,58.4],["be",58.48,58.62],["fine",58.82,59.34]],"ok":1.0},{"text":"If no be You, on for do comment ?","t":59.62,"e":61.74,"w":[["If",59.62,59.76],["no",59.82,60.04],["be",60.12,60.24],["You",60.3,60.42],["on",60.62,60.76],["for",60.84,60.98],["do",61.06,61.2],["comment",61.3,61.74]],"ok":1.0},{"text":"Qui go save us franchement ?","t":62.21,"e":64.12,"w":[["Qui",62.21,62.41],["go",62.68,62.88],["save",62.98,63.26],["us",63.3,63.5],["franchement",63.58,64.12]],"ok":0.8},{"text":"De janvier jusqu’à décembre","t":64.64,"e":66.84,"w":[["De",64.64,64.8],["janvier",64.88,65.28],["jusqu’à",65.38,65.92],["décembre",66,66.84]],"ok":1.0},{"text":"Ton amour nous rend stronger","t":67.32,"e":68.94,"w":[["Ton",67.32,67.48],["amour",67.52,67.88],["nous",67.94,68.04],["rend",68.08,68.22],["stronger",68.32,68.94]],"ok":1.0},{"text":"Yɛda Wo ase, Awurade","t":69.26,"e":71.34,"w":[["Yɛda",69.26,69.54],["Wo",69.77,69.97],["ase",70,70.34],["Awurade",70.64,71.34]],"ok":0.75},{"text":"Wo dɔ no yɛ forever","t":73.16,"e":77.74,"w":[["Wo",73.16,73.36],["dɔ",74.98,75.18],["no",76.8,76.98],["yɛ",77.11,77.31],["forever",77.24,77.74]],"ok":0.4},{"text":"Na gode, na gode, nous disons merci Papa","t":77.82,"e":80.92,"w":[["Na",77.82,77.92],["gode",78,78.36],["na",78.42,78.54],["gode",78.6,79],["nous",79.34,79.44],["disons",79.48,79.76],["merci",79.8,80.32],["Papa",80.42,80.92]],"ok":1.0},{"text":"Na gode, na gode, pour Tes faveurs ici-bas","t":82.62,"e":85.74,"w":[["Na",82.62,82.72],["gode",82.8,83.16],["na",83.24,83.34],["gode",83.42,83.8],["pour",84.12,84.22],["Tes",84.28,84.38],["faveurs",84.44,84.9],["ici-bas",84.98,85.74]],"ok":1.0},{"text":"Tout ce qu’on possède, na You give am","t":86.98,"e":88.74,"w":[["Tout",86.98,87.08],["ce",87.12,87.22],["qu’on",87.24,87.38],["possède",87.42,87.82],["na",87.88,87.98],["You",88.02,88.14],["give",88.22,88.48],["am",88.54,88.74]],"ok":1.0},{"text":"Chaque pas qu’on avance, na You guide am","t":89.06,"e":91.14,"w":[["Chaque",89.06,89.34],["pas",89.4,89.6],["qu’on",89.64,89.82],["avance",89.92,90.22],["na",90.28,90.38],["You",90.42,90.54],["guide",90.6,90.88],["am",90.96,91.14]],"ok":1.0},{"text":"Yɛda Wo ase ooo","t":92.08,"e":93.54,"w":[["Yɛda",92.08,92.34],["Wo",92.63,92.83],["ase",92.92,93.18],["ooo",93.28,93.54]],"ok":0.75},{"text":"Papa God, merci beaucoup ooo","t":94.18,"e":97.16,"w":[["Papa",94.18,94.72],["God",94.8,95.28],["merci",95.38,95.92],["beaucoup",96,96.72],["ooo",96.96,97.16]],"ok":0.8},{"text":"Car we dey drive, le boulot qu’on fait","t":97.2,"e":99.24,"w":[["Car",97.2,97.4],["we",97.44,97.58],["dey",97.62,97.74],["drive",97.82,98.1],["le",98.42,98.48],["boulot",98.54,98.78],["qu’on",98.82,98.94],["fait",99.04,99.24]],"ok":1.0},{"text":"Les contrats qu’on signe, na Your favor everyday","t":99.6,"e":101.36,"w":[["Les",99.6,99.68],["contrats",99.72,99.98],["qu’on",100,100.14],["signe",100.24,100.44],["na",100.5,100.58],["Your",100.62,100.74],["favor",100.8,101.04],["everyday",101.14,101.36]],"ok":1.0},{"text":"Family we love, les enfants qui sourient","t":101.98,"e":104.02,"w":[["Family",101.98,102.36],["we",102.4,102.54],["love",102.62,102.82],["les",102.88,103.02],["enfants",103.06,103.28],["qui",103.32,103.42],["sourient",103.5,104.02]],"ok":1.0},{"text":"Toutes ces bénédictions, Seigneur c’est Toi qui fournis","t":104.08,"e":106.44,"w":[["Toutes",104.08,104.22],["ces",104.24,104.34],["bénédictions",104.4,105.08],["Seigneur",105.14,105.4],["c’est",105.44,105.54],["Toi",105.58,105.7],["qui",105.72,105.86],["fournis",105.92,106.44]],"ok":1.0},{"text":"Medaase, medaase","t":107.24,"e":107.78,"w":[["Medaase",107.24,107.62],["medaase",107.62,107.78]],"ok":1.0},{"text":"Les gens demandent souvent comment on fait pour tenir","t":108.74,"e":111.26,"w":[["Les",108.74,108.82],["gens",108.86,109],["demandent",109.04,109.4],["souvent",109.48,109.88],["comment",109.94,110.22],["on",110.26,110.32],["fait",110.38,110.5],["pour",110.54,110.64],["tenir",110.7,111.26]],"ok":1.0},{"text":"Après toutes les galères, pourquoi toujours sourire","t":111.32,"e":113.58,"w":[["Après",111.32,111.54],["toutes",111.58,111.72],["les",111.74,111.86],["galères",111.92,112.3],["pourquoi",112.36,112.58],["toujours",112.64,113.02],["sourire",113.1,113.58]],"ok":1.0},{"text":"Na grace, na mercy, na heavenly power","t":113.84,"e":115.94,"w":[["Na",113.84,113.96],["grace",114.02,114.24],["na",114.28,114.38],["mercy",114.46,114.82],["na",114.88,114.98],["heavenly",115.02,115.42],["power",115.5,115.94]],"ok":1.0},{"text":"Tu changes nos longues nuits en beautiful brighter hour","t":116.14,"e":118.6,"w":[["Tu",116.14,116.34],["changes",116.34,116.52],["nos",116.54,116.62],["longues",116.68,116.94],["nuits",117,117.12],["en",117.16,117.24],["beautiful",117.28,117.68],["brighter",117.74,118.12],["hour",118.22,118.6]],"ok":0.89},{"text":"Even when e hard, on garde la foi","t":118.84,"e":120.82,"w":[["Even",118.84,119.02],["when",119.08,119.24],["e",119.33,119.53],["hard",119.42,119.7],["on",119.8,119.94],["garde",120.02,120.26],["la",120.3,120.42],["foi",120.54,120.82]],"ok":0.88},{"text":"Le Vieux Père contrôle, donc on avance droit","t":121.04,"e":123.38,"w":[["Le",121.04,121.14],["Vieux",121.22,121.4],["Père",121.46,121.6],["contrôle",121.64,122.02],["donc",122.08,122.24],["on",122.3,122.42],["avance",122.52,122.9],["droit",122.96,123.38]],"ok":1.0},{"text":"Yɛn Nyame yɛ kɛse","t":123.52,"e":125.6,"w":[["Yɛn",123.52,123.72],["Nyame",123.66,123.92],["yɛ",124.68,124.84],["kɛse",125.42,125.6]],"ok":0.75},{"text":"On tombe parfois, but we rise again","t":127.06,"e":129.18,"w":[["On",127.06,127.14],["tombe",127.22,127.42],["parfois",127.48,127.98],["but",128.08,128.18],["we",128.24,128.36],["rise",128.42,128.68],["again",128.76,129.18]],"ok":1.0},{"text":"Parce que Baba dey work, sunshine after rain","t":129.44,"e":131.8,"w":[["Parce",129.44,129.58],["que",129.6,129.68],["Baba",129.72,129.98],["dey",130.02,130.14],["work",130.22,130.4],["sunshine",130.48,130.88],["after",130.96,131.18],["rain",131.44,131.8]],"ok":1.0},{"text":"Marco on the beat…","t":132.6,"e":133.74,"w":[["Marco",132.6,133.02],["on",133.2,133.3],["the",133.34,133.42],["beat",133.48,133.74]],"ok":1.0},{"text":"This one na blessing, this one na testimony","t":133.94,"e":136.14,"w":[["This",133.94,134.06],["one",134.12,134.22],["na",134.24,134.32],["blessing",134.36,134.64],["this",134.84,134.94],["one",135.02,135.12],["na",135.14,135.22],["testimony",135.26,136.14]],"ok":1.0},{"text":"If no be You, on for dey où ?","t":136.6,"e":138.56,"w":[["If",136.6,136.62],["no",136.64,136.84],["be",136.9,137.06],["You",137.12,137.26],["on",137.44,137.58],["for",137.66,137.78],["dey",137.84,138.02],["où",138.36,138.56]],"ok":0.88},{"text":"Qui go fight for us, if no be You ?","t":138.7,"e":140.64,"w":[["Qui",138.7,138.9],["go",139.04,139.18],["fight",139.24,139.46],["for",139.52,139.64],["us",139.78,139.9],["if",139.98,140.06],["no",140.1,140.22],["be",140.26,140.38],["You",140.5,140.64]],"ok":0.89},{"text":"De janvier jusqu’à décembre","t":141.46,"e":143.64,"w":[["De",141.46,141.62],["janvier",141.68,142.1],["jusqu’à",142.2,142.74],["décemb