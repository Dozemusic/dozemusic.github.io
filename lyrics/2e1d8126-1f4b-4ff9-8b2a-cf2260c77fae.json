{"v":1,"src":"scribe+alignement","coverage":0.864,"lines":[{"text":"Intro","t":13.52,"e":13.72,"w":[["Intro",13.52,13.72]],"ok":0.0},{"text":"Couplet 1","t":13.82,"e":14.32,"w":[["Couplet",13.82,14.02],["1",14.12,14.32]],"ok":0.0},{"text":"Dans le désert de mes larmes, j'avais perdu ma voix,","t":14.42,"e":16.9,"w":[["Dans",14.42,14.52],["le",14.56,14.66],["désert",14.72,15],["de",15.02,15.1],["mes",15.16,15.3],["larmes",15.34,15.6],["j'avais",15.62,16],["perdu",16.08,16.36],["ma",16.4,16.5],["voix",16.64,16.9]],"ok":1.0},{"text":"Je marchais sans boussole, j'avais perdu la foi.","t":18.18,"e":20.6,"w":[["Je",18.18,18.32],["marchais",18.38,18.64],["sans",18.7,18.82],["boussole",18.86,19.26],["j'avais",19.3,19.68],["perdu",19.76,20.04],["la",20.08,20.26],["foi",20.36,20.6]],"ok":1.0},{"text":"Mais Ton amour est venu, comme un soleil levant,","t":21.78,"e":24.3,"w":[["Mais",21.78,21.88],["Ton",21.92,22.06],["amour",22.12,22.4],["est",22.42,22.5],["venu",22.54,22.96],["comme",23.02,23.2],["un",23.26,23.38],["soleil",23.46,23.74],["levant",23.8,24.3]],"ok":1.0},{"text":"Pour chasser mes ténèbres et calmer les vents.","t":25.6,"e":28.12,"w":[["Pour",25.6,25.7],["chasser",25.74,26.04],["mes",26.08,26.18],["ténèbres",26.24,26.78],["et",26.82,27.08],["calmer",27.14,27.44],["les",27.48,27.62],["vents",27.68,28.12]],"ok":1.0},{"text":"Tu as ramassé les morceaux de mon cœur brisé,","t":28.68,"e":31.82,"w":[["Tu",28.68,28.76],["as",28.84,28.94],["ramassé",29,29.62],["les",29.66,29.82],["morceaux",29.94,30.38],["de",30.42,30.52],["mon",30.6,30.8],["cœur",30.86,31.24],["brisé",31.32,31.82]],"ok":1.0},{"text":"Pour en faire un palais, une œuvre d'éternité !","t":32.56,"e":35.62,"w":[["Pour",32.56,32.72],["en",32.76,32.86],["faire",32.92,33.16],["un",33.22,33.34],["palais",33.42,33.76],["une",33.84,33.94],["œuvre",34,34.24],["d'éternité",34.28,35.62]],"ok":1.0},{"text":"Solo de Guitare Écho","t":39.49,"e":51.12,"w":[["Solo",39.49,39.7],["de",43.37,43.57],["Guitare",47.24,47.45],["Écho",51.12,51.12]],"ok":0.25},{"text":"Refrain","t":51.13,"e":51.33,"w":[["Refrain",51.13,51.33]],"ok":0.0},{"text":"Dieu est Amour ! Il est ma seule victoire !","t":51.14,"e":56.08,"w":[["Dieu",51.14,51.34],["est",51.38,51.64],["Amour",51.72,52.4],["Il",54.3,54.38],["est",54.42,54.52],["ma",54.6,54.76],["seule",54.86,55.26],["victoire",55.34,56.08]],"ok":1.0},{"text":"Dieu est Amour ! Nzambe ezali bolingo !","t":58.56,"e":63.46,"w":[["Dieu",58.56,58.88],["est",58.88,59.04],["Amour",59.12,59.78],["Nzambe",61.5,62.18],["ezali",62.21,62.41],["bolingo",62.24,63.46]],"ok":0.83},{"text":"Il a séché mes pleurs, Il a changé mon cri,","t":65.52,"e":68.88,"w":[["Il",65.52,65.64],["a",65.7,65.82],["séché",65.88,66.34],["mes",66.42,66.7],["pleurs",66.8,67.2],["Il",67.4,67.48],["a",67.54,67.68],["changé",67.72,68.16],["mon",68.24,68.46],["cri",68.52,68.88]],"ok":1.0},{"text":"En une danse de joie, en un souffle de vie !","t":69.22,"e":72.76,"w":[["En",69.22,69.34],["une",69.42,69.56],["danse",69.64,70.04],["de",70.12,70.42],["joie",70.5,70.8],["en",71.08,71.2],["un",71.24,71.36],["souffle",71.44,71.86],["de",71.94,72.16],["vie",72.24,72.76]],"ok":1.0},{"text":"Oh, oh, oh, Ton amour me transporte !","t":73.4,"e":76.38,"w":[["Oh",73.4,73.72],["oh",74.28,74.52],["oh",74.66,74.66],["Ton",74.72,74.9],["amour",74.96,75.32],["me",75.38,75.54],["transporte",75.6,76.38]],"ok":1.0},{"text":"Oh, oh, oh, Bolingo na Yo ekamwisi ngai !","t":76.58,"e":80.08,"w":[["Oh",76.58,76.7],["oh",77.68,77.68],["oh",77.78,77.9],["Bolingo",77.94,78.18],["na",78.24,78.34],["Yo",78.38,78.52],["ekamwisi",78.6,79.24],["ngai",79.34,80.08]],"ok":1.0},{"text":"Solo de Basse et Percussions","t":82.25,"e":91.14,"w":[["Solo",82.25,82.45],["de",84.42,84.62],["Basse",86.6,86.8],["et",88.77,88.97],["Percussions",90.94,91.14]],"ok":0.0},{"text":"Couplet 2","t":93.11,"e":95.49,"w":[["Couplet",93.11,93.31],["2",95.29,95.49]],"ok":0.0},{"text":"Ce n'est plus la tristesse qui dicte ma chanson,","t":97.46,"e":100.04,"w":[["Ce",97.46,97.56],["n'est",97.6,97.74],["plus",97.78,97.9],["la",97.96,98.06],["tristesse",98.1,98.54],["qui",98.58,98.66],["dicte",98.7,99.1],["ma",99.16,99.28],["chanson",99.32,100.04]],"ok":1.0},{"text":"C'est le Dieu de la vie qui me donne l'onction !","t":101.3,"e":103.6,"w":[["C'est",101.3,101.44],["le",101.45,101.65],["Dieu",101.46,101.62],["de",101.68,101.76],["la",101.82,101.9],["vie",102.02,102.18],["qui",102.26,102.36],["me",102.4,102.52],["donne",102.58,102.86],["l'onction",103.02,103.6]],"ok":0.9},{"text":"Regarde ma démarche, elle est pleine d'assurance,","t":104.84,"e":107.42,"w":[["Regarde",104.84,105.26],["ma",105.32,105.42],["démarche",105.48,105.92],["elle",105.98,106.08],["est",106.1,106.2],["pleine",106.24,106.5],["d'assurance",106.52,107.42]],"ok":1.0},{"text":"Car Ton amour immense est ma seule espérance.","t":108.12,"e":111.14,"w":[["Car",108.12,108.32],["Ton",108.54,108.7],["amour",108.78,109.06],["immense",109.14,109.64],["est",109.66,109.74],["ma",109.78,109.9],["seule",109.94,110.24],["espérance",110.3,111.14]],"ok":1.0},{"text":"Je n'ai plus peur du monde, je n'ai plus peur de rien,","t":111.78,"e":114.82,"w":[["Je",111.78,111.82],["n'ai",111.92,112.04],["plus",112.08,112.22],["peur",112.28,112.5],["du",112.56,112.78],["monde",112.86,113.4],["je",113.62,113.66],["n'ai",113.68,113.88],["plus",113.92,114.04],["peur",114.12,114.34],["de",114.4,114.52],["rien",114.6,114.82]],"ok":1.0},{"text":"Puisque Ta main puissante trace mon chemin !","t":115.46,"e":118.4,"w":[["Puisque",115.46,115.72],["Ta",115.78,115.9],["main",115.96,116.14],["puissante",116.24,117.06],["trace",117.14,117.58],["mon",117.64,117.84],["chemin",117.88,118.4]],"ok":1.0},{"text":"Solo de Piano Synthétique","t":119.77,"e":124.07,"w":[["Solo",119.77,119.97],["de",121.13,121.33],["Piano",122.5,122.7],["Synthétique",123.87,124.07]],"ok":0.0},{"text":"Pont","t":125.23,"e":125.43,"w":[["Pont",125.23,125.43]],"ok":0.0},{"text":"Qui nous a libérés ? (C'est Jésus !)","t":126.6,"e":128.54,"w":[["Qui",126.6,126.66],["nous",126.66,126.8],["a",126.9,127],["libérés",127.08,127.82],["C'est",127.92,128.06],["Jésus",128.12,128.54]],"ok":1.0},{"text":"Qui nous a relevés ? (C'est Jésus !)","t":128.54,"e":130.5,"w":[["Qui",128.54,128.54],["nous",128.54,128.7],["a",128.76,128.84],["relevés",128.92,129.68],["C'est",129.76,129.9],["Jésus",129.96,130.5]],"ok":1.0},{"text":"Bolingo ya Nzambe ? (Eleki nionso !)","t":130.59,"e":133.74,"w":[["Bolingo",130.59,130.79],["ya",130.68,130.68],["Nzambe",131.66,131.86],["Eleki",132.64,132.84],["nionso",133.62,133.74]],"ok":0.4},{"text":"Qui nous donne la force ? (C'est Son Amour !)","t":133.82,"e":135.3,"w":[["Qui",133.82,133.82],["nous",133.82,133.92],["donne",133.92,134.06],["la",134.1,134.22],["force",134.32,134.7],["C'est",134.72,134.72],["Son",134.72,134.88],["Amour",134.94,135.3]],"ok":1.0},{"text":"On danse pour qui ? (Pour le Roi des Rois !)","t":135.47,"e":137.68,"w":[["On",135.47,135.67],["danse",135.64,135.84],["pour",135.94,136.12],["qui",136.2,136.38],["Pour",136.58,136.68],["le",136.72,136.8],["Roi",136.84,137.14],["des",137.18,137.38],["Rois",137.44,137.68]],"ok":0.89},{"text":"Final de Fanfare et Orchestre","t":137.96,"e":139.59,"w":[["Final",137.96,138.16],["de",138.24,138.34],["Fanfare",138.75,138.95],["et",139.16,139.28],["Orchestre",139.39,139.59]],"ok":0.4},{"text":"Outro","t":139.49,"e":139.69,"w":[["Outro",139.49,139.69]],"ok":0.0},{"text":"Dieu est Amour.","t":139.6,"e":164.92,"w":[["Dieu",139.6,139.76],["est",159.3,159.42],["Amour",164.48,164.92]],"ok":1.0},{"text":"Nzambe ezali bolingo.","t":179.66,"e":181.72,"w":[["Nzambe",179.66,180.34],["ezali",180.36,180.56],["bolingo",180.38,181.72]],"ok":0.67},{"text":"Amen.","t":184.64,"e":185.34,"w":[["Amen",184.64,185.34]],"ok":1.0}]}