.38],["voulait",49.42,49.72],["m’abandonner",49.8,50.86]],"ok":1.0},{"text":"Medaase Nyame, pour chaque matin","t":51.5,"e":53.7,"w":[["Medaase",51.5,51.92],["Nyame",52.12,52.52],["pour",52.64,52.8],["chaque",52.9,53.2],["matin",53.26,53.7]],"ok":1.0},{"text":"Pour le souffle de vie, pour le pain dans mes mains","t":54.04,"e":56.34,"w":[["Pour",54.04,54.16],["le",54.2,54.28],["souffle",54.34,54.64],["de",54.68,54.82],["vie",54.9,55.04],["pour",55.16,55.28],["le",55.32,55.4],["pain",55.52,55.72],["dans",55.76,55.88],["mes",55.92,56.04],["mains",56.14,56.34]],"ok":1.0},{"text":"Wo ye me kra, tu connais mon chemin","t":56.78,"e":58.92,"w":[["Wo",56.78,57.12],["ye",57.15,57.35],["me",57.18,57.28],["kra",57.36,57.54],["tu",57.64,57.74],["connais",57.82,58.16],["mon",58.24,58.36],["chemin",58.4,58.92]],"ok":0.88},{"text":"Sans toi Seigneur, je ne suis plus rien","t":59.38,"e":61.36,"w":[["Sans",59.38,59.5],["toi",59.54,59.68],["Seigneur",59.76,60.1],["je",60.18,60.28],["ne",60.32,60.42],["suis",60.48,60.74],["plus",60.84,61.08],["rien",61.1,61.36]],"ok":1.0},{"text":"⸻","t":61.56,"e":62.56},{"text":"🎤 COUPLET 2 – Voix Femme","t":61.61,"e":61.75,"w":[["COUPLET",61.41,61.61],["2",61.46,61.66],["Voix",61.5,61.7],["Femme",61.55,61.75]],"ok":0.0},{"text":"J’ai vu ta grâce tomber comme la pluie","t":61.66,"e":63.32,"w":[["J’ai",61.6,61.74],["vu",61.76,61.88],["ta",61.92,62.04],["grâce",62.08,62.26],["tomber",62.28,62.62],["comme",62.7,62.86],["la",62.92,63],["pluie",63.1,63.32]],"ok":1.0},{"text":"Dans mes combats cachés, tu m’as donné la vie","t":63.54,"e":65.9,"w":[["Dans",63.54,63.62],["mes",63.68,63.78],["combats",63.84,64.12],["cachés",64.16,64.54],["tu",64.62,64.72],["m’as",64.78,64.92],["donné",65.02,65.36],["la",65.4,65.54],["vie",65.66,65.9]],"ok":1.0},{"text":"Quand mes larmes parlaient plus fort que ma voix","t":66.34,"e":68.32,"w":[["Quand",66.34,66.46],["mes",66.5,66.62],["larmes",66.66,66.9],["parlaient",66.96,67.26],["plus",67.3,67.44],["fort",67.54,67.72],["que",67.76,67.86],["ma",67.92,68.06],["voix",68.14,68.32]],"ok":1.0},{"text":"C’est ton amour Seigneur qui m’a gardée debout là","t":68.4,"e":71.08,"w":[["C’est",68.4,68.5],["ton",68.56,68.7],["amour",68.8,69.1],["Seigneur",69.18,69.56],["qui",69.64,69.74],["m’a",69.8,69.94],["gardée",70.02,70.4],["debout",70.44,70.84],["là",70.9,71.08]],"ok":1.0},{"text":"Merci mon Dieu pour la famille, la paix","t":71.4,"e":73.52,"w":[["Merci",71.4,71.66],["mon",71.72,71.86],["Dieu",71.92,72.1],["pour",72.2,72.32],["la",72.36,72.46],["famille",72.6,72.92],["la",73,73.1],["paix",73.24,73.52]],"ok":1.0},{"text":"Pour les portes ouvertes que personne ne fermait","t":73.8,"e":76.14,"w":[["Pour",73.8,73.9],["les",73.94,74.06],["portes",74.1,74.28],["ouvertes",74.32,74.68],["que",74.72,74.82],["personne",74.9,75.3],["ne",75.34,75.44],["fermait",75.54,76.14]],"ok":1.0},{"text":"Adonaï, tu fais ce que l’homme ne peut","t":76.2,"e":78.58,"w":[["Adonaï",76.2,76.7],["tu",76.78,76.88],["fais",77.02,77.18],["ce",77.22,77.36],["que",77.42,77.52],["l’homme",77.6,77.86],["ne",77.92,78.1],["peut",78.24,78.58]],"ok":1.0},{"text":"Ton nom est grand, ton nom est glorieux","t":78.68,"e":80.54,"w":[["Ton",78.68,78.8],["nom",78.9,79.04],["est",79.1,79.2],["grand",79.26,79.54],["ton",79.62,79.74],["nom",79.8,79.94],["est",79.98,80.04],["glorieux",80.1,80.54]],"ok":1.0},{"text":"⸻","t":80.74,"e":81.74},{"text":"🎶 REFRAIN – Duo","t":80.78999999999999,"e":80.91,"w":[["REFRAIN",80.63,80.83],["Duo",80.71,80.91]],"ok":0.0},{"text":"Adonaï, Adonaï","t":80.8,"e":82.98,"w":[["Adonaï",80.8,81.9],["Adonaï",82.04,82.98]],"ok":1.0},{"text":"Tu es le Roi, le Maître de ma vie","t":83.08,"e":85.72,"w":[["Tu",83.08,83.22],["es",83.3,83.38],["le",83.44,83.62],["Roi",83.68,84.02],["le",84.2,84.28],["Maître",84.36,84.78],["de",84.84,84.94],["ma",85,85.18],["vie",85.24,85.72]],"ok":1.0},{"text":"Medaase, Baba God I say","t":86.1,"e":87.94,"w":[["Medaase",86.1,86.6],["Baba",86.74,87],["God",87.06,87.34],["I",87.44,87.58],["say",8