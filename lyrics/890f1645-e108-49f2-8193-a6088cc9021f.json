{"v":1,"src":"scribe+alignement","coverage":0.971,"lines":[{"text":"Oh oh oh…","t":6.54,"e":7.34,"w":[["Oh",6.54,6.74],["oh",6.84,7.04],["oh",7.14,7.34]],"ok":0.0},{"text":"Aïe maman…","t":7.44,"e":8.58,"w":[["Aïe",7.44,7.64],["maman",7.74,8.58]],"ok":0.5},{"text":"Les oreilles m’ont trompée…","t":9.66,"e":11.3,"w":[["Les",9.66,9.86],["oreilles",9.92,10.24],["m’ont",10.3,10.44],["trompée",10.5,11.3]],"ok":1.0},{"text":"Aujourd’hui mon cœur pleure…","t":14.28,"e":16.88,"w":[["Aujourd’hui",14.28,14.92],["mon",15.16,15.46],["cœur",15.74,16.2],["pleure",16.36,16.88]],"ok":1.0},{"text":"J’avais trouvé l’homme que j’attendais,","t":41.92,"e":43.88,"w":[["J’avais",41.92,42.26],["trouvé",42.3,42.6],["l’homme",42.66,42.92],["que",42.98,43.08],["j’attendais",43.12,43.88]],"ok":1.0},{"text":"Celui qui m’aimait sans jamais calculer.","t":44.4,"e":46.52,"w":[["Celui",44.4,44.7],["qui",44.76,44.86],["m’aimait",44.92,45.2],["sans",45.28,45.4],["jamais",45.44,45.72],["calculer",45.8,46.52]],"ok":1.0},{"text":"Quand la vie devenait difficile,","t":47.22,"e":49.32,"w":[["Quand",47.22,47.36],["la",47.42,47.52],["vie",47.56,47.7],["devenait",47.74,48.36],["difficile",48.44,49.32]],"ok":1.0},{"text":"C’était son épaule qui me rendait tranquille.","t":49.66,"e":52.02,"w":[["C’était",49.66,49.94],["son",50,50.16],["épaule",50.24,50.48],["qui",50.54,50.64],["me",50.7,50.82],["rendait",50.88,51.16],["tranquille",51.22,52.02]],"ok":1.0},{"text":"Il me couvrait d’amour et de respect,","t":52.36,"e":54.6,"w":[["Il",52.36,52.44],["me",52.48,52.6],["couvrait",52.66,52.94],["d’amour",52.98,53.48],["et",53.52,53.6],["de",53.66,53.76],["respect",53.82,54.6]],"ok":1.0},{"text":"Chaque jour il cherchait à me valoriser.","t":54.88,"e":57.04,"w":[["Chaque",54.88,55.08],["jour",55.12,55.26],["il",55.3,55.36],["cherchait",55.4,55.74],["à",55.84,55.88],["me",55.94,56.06],["valoriser",56.12,57.04]],"ok":1.0},{"text":"Quand je tombais il me relevait,","t":57.54,"e":59.64,"w":[["Quand",57.54,57.68],["je",57.74,57.82],["tombais",57.9,58.36],["il",58.48,58.64],["me",58.7,58.82],["relevait",58.9,59.64]],"ok":1.0},{"text":"Mon bonheur était là, mais je ne le voyais pas.","t":59.86,"e":62.58,"w":[["Mon",59.86,59.98],["bonheur",60.02,60.36],["était",60.42,60.66],["là",60.72,60.92],["mais",61.2,61.28],["je",61.34,61.42],["ne",61.46,61.48],["le",61.54,61.62],["voyais",61.68,62.02],["pas",62.1,62.58]],"ok":1.0},{"text":"Mais les copines parlaient…","t":62.8,"e":64.22,"w":[["Mais",62.8,62.92],["les",62.96,63.08],["copines",63.12,63.56],["parlaient",63.66,64.22]],"ok":1.0},{"text":"Le quartier parlait…","t":64.32,"e":65.48,"w":[["Le",64.32,64.42],["quartier",64.48,64.92],["parlait",65,65.48]],"ok":1.0},{"text":"Les jaloux parlaient…","t":65.62,"e":66.86,"w":[["Les",65.62,65.74],["jaloux",65.8,66.2],["parlaient",66.3,66.86]],"ok":1.0},{"text":"Et moi je les écoutais…","t":66.92,"e":68.18,"w":[["Et",66.92,67.12],["moi",66.98,67.14],["je",67.24,67.34],["les",67.4,67.58],["écoutais",67.64,68.18]],"ok":0.8},{"text":"Petit à petit…","t":68.26,"e":69.36,"w":[["Petit",68.26,68.58],["à",68.66,68.8],["petit",68.9,69.36]],"ok":1.0},{"text":"Le doute est entré dans ma vie…","t":70.68,"e":73.22,"w":[["Le",70.68,70.8],["doute",70.9,71.18],["est",71.22,71.38],["entré",71.42,72.12],["dans",72.18,72.38],["ma",72.48,72.74],["vie",72.84,73.22]],"ok":1.0},{"text":"Aïe maman, j’ai gâté mon bonheur…","t":73.54,"e":76.26,"w":[["Aïe",73.54,73.74],["maman",73.82,74.32],["j’ai",74.58,74.74],["gâté",74.8,75.2],["mon",75.28,75.4],["bonheur",75.48,76.26]],"ok":1.0},{"text":"Les oreilles ont fermé mon cœur…","t":76.58,"e":78.66,"w":[["Les",76.58,76.74],["oreilles",76.8,77.22],["ont",77.26,77.4],["fermé",77.48,77.86],["mon",77.92,78.16],["cœur",78.24,78.66]],"ok":1.0},{"text":"J’ai laissé partir ma perle rare,","t":78.68,"e":81.52,"w":[["J’ai",78.68,78.96],["laissé",79.02,79.56],["partir",79.84,80.18],["ma",80.24,80.42],["perle",80.52,80.92],["rare",81,81.52]],"ok":1.0},{"text":"Aujourd’hui je pleure dans le noir.","t":81.82,"e":83.92,"w":[["Aujourd’hui",81.82,82.34],["je",82.44,82.56],["pleure",82.64,82.9],["dans",82.96,83.1],["le",83.14,83.22],["noir",83.32,83.92]],"ok":1.0},{"text":"Aïe maman, j’ai gâté mon destin…","t":84.02,"e":86.7,"w":[["Aïe",84.02,84.24],["maman",84.32,84.82],["j’ai",85.06,85.22],["gâté",85.28,85.68],["mon",85.76,85.9],["destin",85.96,86.7]],"ok":1.0},{"text":"J’ai cru les autres au lieu du mien…","t":87,"e":88.84,"w":[["J’ai",87,87.14],["cru",87.2,87.38],["les",87.44,87.68],["autres",87.72,87.96],["au",87.96,88.06],["lieu",88.1,88.3],["du",88.36,88.46],["mien",88.52,88.84]],"ok":1.0},{"text":"Quand l’amour frappait à ma porte,","t":89.22,"e":91.78,"w":[["Quand",89.22,89.46],["l’amour",89.5,90.2],["frappait",90.28,90.82],["à",90.9,90.96],["ma",91.02,91.14],["porte",91.28,91.78]],"ok":1.0},{"text":"J’ai ouvert aux rumeurs les plus fortes.","t":92.26,"e":95.06,"w":[["J’ai",92.26,92.44],["ouvert",92.52,92.96],["aux",93,93.1],["rumeurs",93.14,93.72],["les",93.8,93.98],["plus",94.08,94.34],["fortes",94.5,95.06]],"ok":1.0},{"text":"Eh femme !","t":97.54,"e":100.54,"w":[["Eh",97.54,97.74],["femme",100.02,100.54]],"ok":0.5},{"text":"Quand Dieu t’envoie un homme bien,","t":104.46,"e":106.46,"w":[["Quand",104.46,104.7],["Dieu",104.74,104.88],["t’envoie",104.96,105.36],["un",105.54,105.6],["homme",105.64,106.18],["bien",106.26,106.46]],"ok":1.0},{"text":"Ne demande pas au quartier son avis !","t":106.76,"e":109.36,"w":[["Ne",106.76,106.86],["demande",106.94,107.36],["pas",107.42,107.62],["au",107.66,107.78],["quartier",107.9,108.44],["son",108.54,108.74],["avis",108.8,109.36]],"ok":1.0},{"text":"Les gens qui te conseillent aujourd’hui,","t":109.7,"e":111.72,"w":[["Les",109.7,109.82],["gens",109.84,110],["qui",110.04,110.14],["te",110.24,110.36],["conseillent",110.44,110.9],["aujourd’hui",110.94,111.72]],"ok":1.0},{"text":"Ne porteront pas tes larmes demain !","t":112,"e":114.54,"w":[["Ne",112,112.08],["porteront",112.18,112.9],["pas",112.96,113.24],["tes",113.28,113.42],["larmes",113.48,113.92],["demain",113.98,114.54]],"ok":1.0},{"text":"Les commérages sont gratuits…","t":115.24,"e":117.66,"w":[["Les",115.24,115.38],["commérages",115.46,116.38],["sont",116.44,116.66],["gratuits",116.72,117.66]],"ok":1.0},{"text":"Mais leurs conséquences coûtent cher !","t":118.22,"e":121.16,"w":[["Mais",118.22,118.34],["leurs",118.36,118.64],["conséquences",118.72,119.94],["coûtent",120,120.46],["cher",120.6,121.16]],"ok":1.0},{"text":"On me disait :","t":121.5,"e":122.22,"w":[["On",121.5,121.6],["me",121.64,121.76],["disait",121.82,122.22]],"ok":1.0},{"text":"“Il n’est pas sincère…”","t":122.66,"e":123.78,"w":[["Il",122.66,122.74],["n’est",122.78,122.92],["pas",122.96,123.1],["sincère",123.16,123.78]],"ok":1.0},{"text":"“Il cache quelque chose…”","t":123.84,"e":124.88,"w":[["Il",123.84,123.92],["cache",124,124.24],["quelque",124.28,124.58],["chose",124.64,124.88]],"ok":1.0},{"text":"“Tu peux trouver mieux ailleurs…”","t":124.94,"e":126.5,"w":[["Tu",124.94,125.02],["peux",125.1,125.22],["trouver",125.26,125.56],["mieux",125.62,125.76],["ailleurs",125.82,126.5]],"ok":1.0},{"text":"Alors j’ai commencé à changer,","t":126.82,"e":128.38,"w":[["Alors",126.82,127],["j’ai",127.04,127.18],["commencé",127.24,127.68],["à",127.74,127.82],["changer",127.86,128.38]],"ok":1.0},{"text":"À me méfier, à l’accuser.","t":129.4,"e":131.06,"w":[["À",129.4,129.44],["me",129.5,129.62],["méfier",129.7,130.14],["à",130.24,130.32],["l’accuser",130.36,131.06]],"ok":1.0},{"text":"Chaque sourire devenait suspect,","t":131.96,"e":133.66,"w":[["Chaque",131.96,132.24],["sourire",132.3,132.62],["devenait",132.66,133.08],["suspect",133.18,133.66]],"ok":1.0},{"text":"Chaque silence devenait un procès.","t":134.08,"e":136.38,"w":[["Chaque",134.08,134.74],["silence",134.8,135.1],["devenait",135.14,135.58],["un",135.62,135.7],["procès",135.78,136.38]],"ok":1.0},{"text":"Lui qui m’aimait sans condition,","t":137.24,"e":139.42,"w":[["Lui",137.24,137.34],["qui",137.38,137.52],["m’aimait",137.56,138.12],["sans",138.22,138.4],["condition",138.48,139.42]],"ok":1.0},{"text":"S’est fatigué de mes soupçons.","t":139.84,"e":142.14,"w":[["S’est",139.84,139.98],["fatigué",140.04,140.8],["de",140.86,140.98],["mes",141.08,141.42],["soupçons",141.52,142.14]],"ok":1.0},{"text":"Et un matin il est parti,","t":142.54,"e":144.7,"w":[["Et",142.54,142.62],["un",142.68,142.76],["matin",142.82,143.4],["il",143.52,143.64],["est",143.68,143.86],["parti",143.98,144.7]],"ok":1.0},{"text":"Emportant mon bonheur avec lui.","t":144.8,"e":146.92,"w":[["Emportant",144.8,145.42],["mon",145.5,145.66],["bonheur",145.72,146.26],["avec",146.5,146.78],["lui",146.8,146.92]],"ok":1.0},{"text":"Aïe maman, j’ai gâté mon bonheur…","t":147.02,"e":149.7,"w":[["Aïe",147.02,147.22],["maman",147.6,147.94],["j’ai",148.02,148.18],["gâté",148.24,148.66],["mon",148.72,148.84],["bonheur",148.92,149.7]],"ok":1.0},{"text":"Les oreilles ont fermé mon cœur…","t":150.02,"e":152.08,"w":[["Les",150.02,150.2],["oreilles",150.26,150.66],["ont",150.7,150.8],["fermé",150.9,151.28],["mon",151.36,151.56],["cœur",151.66,152.08]],"ok":1.0},{"text":"J’ai laissé partir ma perle rare,","t":152.12,"e":154.9,"w":[["J’ai",152.12,152.42],["laissé",152.48,153.06],["partir",153.28,153.62],["ma",153.68,153.9],["perle",153.98,154.38],["rare",154.46,154.9]],"ok":1.0},{"text":"Aujourd’hui je pleure dans le noir.","t":155.28,"e":157.22,"w":[["Aujourd’hui",155.28,155.8],["je",155.88,156.04],["pleure",156.1,156.34],["dans",156.4,156.52],["le",156.58,156.68],["noir",156.76,157.22]],"ok":1.0},{"text":"Mon cœur pleure…","t":162.68,"e":163.76,"w":[["Mon",162.68,162.86],["cœur",162.98,163.26],["pleure",163.32,163.76]],"ok":1.0},{"text":"Mon âme pleure…","t":164,"e":165.14,"w":[["Mon",164,164.2],["âme",164.36,164.54],["pleure",164.64,165.14]],"ok":1.0},{"text":"Mon bonheur est parti ailleurs…","t":165.3,"e":167.84,"w":[["Mon",165.3,165.52],["bonheur",165.62,166.4],["est",166.44,166.54],["parti",166.64,167.08],["ailleurs",167.16,167.84]],"ok":1.0},{"text":"Aujourd’hui je comprends la leçon…","t":176.8,"e":179.2,"w":[["Aujourd’hui",176.8,177.38],["je",177.48,177.62],["comprends",177.74,178.2],["la",178.26,178.42],["leçon",178.48,179.2]],"ok":1.0},{"text":"Quand tu trouves quelqu’un qui t’aime,","t":181.84,"e":184.12,"w":[["Quand",181.84,182.02],["tu",182.1,182.24],["trouves",182.3,182.6],["quelqu’un",182.66,183.22],["qui",183.3,183.46],["t’aime",183.64,184.12]],"ok":1.0},{"text":"Protège-le…","t":187.52,"e":188.76,"w":[["Protège-le",187.52,188.76]],"ok":1.0},{"text":"Quand tu trouves quelqu’un qui te respecte,","t":192.32,"e":194.98,"w":[["Quand",192.32,192.54],["tu",192.58,192.66],["trouves",192.8,193.08],["quelqu’un",193.14,193.72],["qui",193.78,193.88],["te",193.96,194.08],["respecte",194.18,194.98]],"ok":1.0},{"text":"Préserve-le…","t":198.02,"e":199.32,"w":[["Préserve-le",198.02,199.32]],"ok":1.0},{"text":"Car une perle rare perdue,","t":203.64,"e":205.7,"w":[["Car",203.64,203.88],["une",203.92,204.08],["perle",204.18,204.56],["rare",204.64,204.9],["perdue",204.96,205.7]],"ok":1.0},{"text":"Ne revient pas toujours…","t":208.42,"e":210.68,"w":[["Ne",208.42,208.54],["revient",208.62,209.08],["pas",209.22,209.5],["toujours",209.9,210.68]],"ok":1.0},{"text":"Marco on the Beat…","t":214.46,"e":215.88,"w":[["Marco",214.46,214.94],["on",215.14,215.22],["the",215.26,215.36],["Beat",215.44,215.88]],"ok":1.0},{"text":"Oh oh oh…","t":217.94,"e":222.26,"w":[["Oh",217.94,218.14],["oh",220.0,220.2],["oh",222.06,222.26]],"ok":0.0},{"text":"Les oreilles m’ont trompée…","t":224.12,"e":226.22,"w":[["Les",224.12,224.32],["oreilles",224.38,224.86],["m’ont",224.96,225.4],["trompée",225.56,226.22]],"ok":1.0},{"text":"Et mon cœur paie le prix…","t":229.36,"e":231.68,"w":[["Et",229.36,229.52],["mon",229.58,229.76],["cœur",229.86,230.12],["paie",230.24,230.8],["le",230.9,231.02],["prix",231.14,231.68]],"ok":1.0}]}